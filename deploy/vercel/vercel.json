{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["arn1"],
  "rewrites": [
    { "source": "/", "destination": "/home.html" },
    { "source": "/sv", "destination": "/home-sv.html" },
    { "source": "/skola", "destination": "/skola.html" },
    { "source": "/bygg", "destination": "/bygg.html" },
    { "source": "/video", "destination": "/video.html" },
    { "source": "/video/sv", "destination": "/video-sv.html" },
    { "source": "/sketch", "destination": "/sketch.html" },
    { "source": "/sketch/sv", "destination": "/sketch-sv.html" },
    { "source": "/skiss", "destination": "/sketch-sv.html" },
    { "source": "/sketch/video", "destination": "/sketch-video.html" },
    { "source": "/sketch/video/sv", "destination": "/sketch-video-sv.html" }
  ],
  "functions": {
    "app.py": {
      "maxDuration": 300,
      "includeFiles": "bin/**"
    }
  }
}
