00_skiss_20" value="&lt;b&gt;r00 skiss&lt;/b&gt;&lt;br&gt;handritad&lt;br&gt;i rmink/ eller rmink/&amp;lt;Mapp&amp;gt;/" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333333;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1"><mxGeometry x="680" y="110" width="200" height="110" as="geometry"/></mxCell><mxCell id="r01___2_frågor_21" value="&lt;b&gt;r01 · 2 frågor&lt;/b&gt;&lt;br&gt;ren ritning&lt;br&gt;ringar 1, 2 + ANMÄRKNINGAR&lt;br&gt;SVAR-rad per fråga" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1"><mxGeometry x="910" y="110" width="200" height="110" as="geometry"/></mxCell><mxCell id="e_22" value="varv" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;strokeColor=#555555;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="r00_skiss_20" target="r01___2_frågor_21"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="markeringar_23" value="&lt;b&gt;markeringar&lt;/b&gt;&lt;br&gt;ringar, kryss, text&lt;br&gt;svar på SVAR-raden&lt;br&gt;i lagret Kommentarer" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333333;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1"><mxGeometry x="1140" y="110" width="200" height="110" as="geometry"/></mxCell><mxCell id="e_24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;strokeColor=#555555;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="r01___2_frågor_21" target="markeringar_23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="r02_25" value="&lt;b&gt;r02&lt;/b&gt;&lt;br&gt;svaren inarbetade&lt;br&gt;frågor stängda&lt;br&gt;r01 → Tidigare/" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1"><mxGeometry x="1370" y="110" width="200" height="110" as="geometry"/></mxCell><mxCell id="e_26" value="varv" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;strokeColor=#555555;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="markeringar_23" target="r02_25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Regler_för_namn_och_flytt_27" value='&lt;b&gt;Regler för namn och flytt&lt;/b&gt;&lt;table style="border-collapse:collapse;font-size:10px" cellpadding="1" cellspacing="0" border="0"&gt;&lt;tr style="font-weight:bold"&gt;&lt;td valign="top" align="left" width="140"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="560"&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="140"&gt;Namn på revision&lt;/td&gt;&lt;td valign="top" align="left" width="560"&gt;"&amp;lt;namn&amp;gt; r&amp;lt;NN&amp;gt;" + " · N frågor" när frågor är öppna&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="140"&gt;Två siffror&lt;/td&gt;&lt;td valign="top" align="left" width="560"&gt;r03 sorterar rätt även efter r09&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="140"&gt;Ritningens namn&lt;/td&gt;&lt;td valign="top" align="left" width="560"&gt;länkad ritning; annars mappen i rmink/&amp;lt;Mapp&amp;gt;/; annars bokens namn utan rNN och · frågor&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="140"&gt;Skissen&lt;/td&gt;&lt;td valign="top" align="left" width="560"&gt;flyttas till Tidigare/ som "&amp;lt;namn&amp;gt; r00 skiss" (bara inom rmink/)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="140"&gt;Krock&lt;/td&gt;&lt;td valign="top" align="left" width="560"&gt;rmapi döper om till "namn_2", "namn_3" …&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="140"&gt;Egna böcker&lt;/td&gt;&lt;td valign="top" align="left" width="560"&gt;böcker utanför rmink/ flyttas aldrig&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="140"&gt;Tecken&lt;/td&gt;&lt;td valign="top" align="left" width="560"&gt;/ * ? [ ] \ byts mot - (rmapi tolkar dem som mönster)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="140"&gt;Lager&lt;/td&gt;&lt;td valign="top" align="left" width="560"&gt;"Ritning rNN" med rmink:s streck + tomt "Kommentarer" för användaren&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="140"&gt;Sidor&lt;/td&gt;&lt;td valign="top" align="left" width="560"&gt;1 ren ritning · 2 alternativ (om några) · 3 skissen&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1"><mxGeometry x="680" y="260" width="716" height="177" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
