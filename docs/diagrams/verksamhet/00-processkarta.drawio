<mxfile host="rmink" agent="docs/diagrams/build.py"><diagram id="00-processkarta" name="rmink i byggprojektet: från idé till relationshandling"><mxGraphModel dx="1792" dy="592" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" background="#ffffff" pageWidth="1792" pageHeight="592" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t_1" value="&lt;b&gt;rmink i byggprojektet: från idé till relationshandling&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=26;fontColor=#1F4E79;align=left;verticalAlign=top;spacing=2;" parent="1" vertex="1"><mxGeometry x="40" y="20" width="1400" height="34" as="geometry"/></mxCell><mxCell id="t_2" value="Varje fas med vad rmink gör, vilka roller som deltar och vilket kedjediagram som visar detaljerna." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#333333;align=left;verticalAlign=top;spacing=2;" parent="1" vertex="1"><mxGeometry x="40" y="56" width="1400" height="22" as="geometry"/></mxCell><mxCell id="fas0_3" value="Idé" style="shape=step;perimeter=stepPerimeter;fixedSize=1;size=22;whiteSpace=wrap;html=1;fillColor=#DEEAF6;strokeColor=#1F4E79;strokeWidth=2;fontFamily=Helvetica;fontSize=18;fontStyle=1;fontColor=#1F4E79;" parent="1" vertex="1"><mxGeometry x="40" y="110" width="236" height="64" as="geometry"/></mxCell><mxCell id="fasbox0_4" value='&lt;b&gt;I fasen:&lt;/b&gt;&lt;br&gt;vad ska byggas&lt;br&gt;altan, friggebod,&lt;br&gt;tillbyggnad, badrum&lt;br&gt;&lt;br&gt;&lt;b&gt;Roller:&lt;/b&gt;&lt;br&gt;Byggherre&lt;br&gt;&lt;br&gt;&lt;font color="#1F4E79"&gt;&lt;b&gt;Se kedja 4&lt;/b&gt;&lt;/font&gt;' style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontFamily=Helvetica;fontSize=14;align=left;verticalAlign=top;spacing=10;fontColor=#262626;" parent="1" vertex="1"><mxGeometry x="46" y="190" width="220" height="196" as="geometry"/></mxCell><mxCell id="fas1_5" value="Skiss" style="shape=step;perimeter=stepPerimeter;fixedSize=1;size=22;whiteSpace=wrap;html=1;fillColor=#E2EFDA;strokeColor=#1F4E79;strokeWidth=2;fontFamily=Helvetica;fontSize=18;fontStyle=1;fontColor=#1F4E79;" parent="1" vertex="1"><mxGeometry x="286" y="110" width="236" height="64" as="geometry"/></mxCell><mxCell id="fasbox1_6" value='&lt;b&gt;I fasen:&lt;/b&gt;&lt;br&gt;för hand på plattan&lt;br&gt;mått, symboler&lt;br&gt;i rmink/&amp;lt;projekt&amp;gt;/&lt;br&gt;&lt;br&gt;&lt;b&gt;Roller:&lt;/b&gt;&lt;br&gt;Byggherre, Hantverkare&lt;br&gt;&lt;br&gt;&lt;font color="#1F4E79"&gt;&lt;b&gt;Se kedja 1&lt;/b&gt;&lt;/font&gt;' style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontFamily=Helvetica;fontSize=14;align=left;verticalAlign=top;spacing=10;fontColor=#262626;" parent="1" vertex="1"><mxGeometry x="292" y="190" width="220" height="196" as="geometry"/></mxCell><mxCell id="fas2_7" value="Ren ritning" style="shape=step;perimeter=stepPerimeter;fixedSize=1;size=22;whiteSpace=wrap;html=1;fillColor=#E2EFDA;strokeColor=#1F4E79;strokeWidth=2;fontFamily=Helvetica;fontSize=18;fontStyle=1;fontColor=#1F4E79;" parent="1" vertex="1"><mxGeometry x="532" y="110" width="236" height="64" as="geometry"/></mxCell><mxCell id="fasbox2_8" value='&lt;b&gt;I fasen:&lt;/b&gt;&lt;br&gt;rmink + Claude ritar&lt;br&gt;räta vinklar, skala&lt;br&gt;frågor i stället för gissningar&lt;br&gt;&lt;br&gt;&lt;b&gt;Roller:&lt;/b&gt;&lt;br&gt;rmink, Claude&lt;br&gt;&lt;br&gt;&lt;font color="#1F4E79"&gt;&lt;b&gt;Se kedja 1&lt;/b&gt;&lt;/font&gt;' style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontFamily=Helvetica;fontSize=14;align=left;verticalAlign=top;spacing=10;fontColor=#262626;" parent="1" vertex="1"><mxGeometry x="538" y="190" width="220" height="196" as="geometry"/></mxCell><mxCell id="fas3_9" value="Revisioner och val" style="shape=step;perimeter=stepPerimeter;fixedSize=1;size=22;whiteSpace=wrap;html=1;fillColor=#E2EFDA;strokeColor=#1F4E79;strokeWidth=2;fontFamily=Helvetica;fontSize=18;fontStyle=1;fontColor=#1F4E79;" parent="1" vertex="1"><mxGeometry x="778" y="110" width="236" height="64" as="geometry"/></mxCell><mxCell id="fasbox3_10" value='&lt;b&gt;I fasen:&lt;/b&gt;&lt;br&gt;markera, svara, välja&lt;br&gt;r01 → r02 → r03&lt;br&gt;alternativ med U-värde&lt;br&gt;&lt;br&gt;&lt;b&gt;Roller:&lt;/b&gt;&lt;br&gt;Byggherre, Hantverkare, Claude&lt;br&gt;&lt;br&gt;&lt;font color="#1F4E79"&gt;&lt;b&gt;Se kedja 2, 3&lt;/b&gt;&lt;/font&gt;' style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontFamily=Helvetica;fontSize=14;align=left;verticalAlign=top;spacing=10;fontColor=#262626;" parent="1" vertex="1"><mxGeometry x="784" y="190" width="220" height="196" as="geometry"/></mxCell><mxCell id="fas4_11" value="Lov och anmälan" style="shape=step;perimeter=stepPerimeter;fixedSize=1;size=22;whiteSpace=wrap;html=1;fillColor=#E4DFEC;strokeColor=#1F4E79;strokeWidth=2;fontFamily=Helvetica;fontSize=18;fontStyle=1;fontColor=#1F4E79;" parent="1" vertex="1"><mxGeometry x="1024" y="110" width="236" height="64" as="geometry"/></mxCell><mxCell id="fasbox4_12" value='&lt;b&gt;I fasen:&lt;/b&gt;&lt;br&gt;lov eller lovfritt?&lt;br&gt;bygglovshandling&lt;br&gt;ansökan i kommunen&lt;br&gt;&lt;br&gt;&lt;b&gt;Roller:&lt;/b&gt;&lt;br&gt;Byggherre, Byggnadsnämnd, KA&lt;br&gt;&lt;br&gt;&lt;font color="#1F4E79"&gt;&lt;b&gt;Se kedja 4&lt;/b&gt;&lt;/font&gt;' style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontFamily=Helvetica;fontSize=14;align=left;verticalAlign=top;spacing=10;fontColor=#262626;" parent="1" vertex="1"><mxGeometry x="1030" y="190" width="220" height="196" as="geometry"/></mxCell><mxCell id="fas5_13" value="Bygge" style="shape=step;perimeter=stepPerimeter;fixedSize=1;size=22;whiteSpace=wrap;html=1;fillColor=#FCE4D6;strokeColor=#1F4E79;strokeWidth=2;fontFamily=Helvetica;fontSize=18;fontStyle=1;fontColor=#1F4E79;" parent="1" vertex="1"><mxGeometry x="1270" y="110" width="236" height="64" as="geometry"/></mxCell><mxCell id="fasbox5_14" value='&lt;b&gt;I fasen:&lt;/b&gt;&lt;br&gt;ritningen i fält&lt;br&gt;ändringar = nya varv&lt;br&gt;beslut på SVAR-raden&lt;br&gt;&lt;br&gt;&lt;b&gt;Roller:&lt;/b&gt;&lt;br&gt;Hantverkare, Elinstallatör, KA&lt;br&gt;&lt;br&gt;&lt;font color="#1F4E79"&gt;&lt;b&gt;Se kedja 4&lt;/b&gt;&lt;/font&gt;' style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontFamily=Helvetica;fontSize=14;align=left;verticalAlign=top;spacing=10;fontColor=#262626;" parent="1" vertex="1"><mxGeometry x="1276" y="190" width="220" height="196" as="geometry"/></mxCell><mxCell id="fas6_15" value="Relation" style="shape=step;perimeter=stepPerimeter;fixedSize=1;size=22;whiteSpace=wrap;html=1;fillColor=#F2F2F2;strokeColor=#1F4E79;strokeWidth=2;fontFamily=Helvetica;fontSize=18;fontStyle=1;fontColor=#1F4E79;" parent="1" vertex="1"><mxGeometry x="1516" y="110" width="236" height="64" as="geometry"/></mxCell><mxCell id="fasbox6_16" value='&lt;b&gt;I fasen:&lt;/b&gt;&lt;br&gt;som byggt&lt;br&gt;hela historiken&lt;br&gt;i Tidigare/&lt;br&gt;&lt;br&gt;&lt;b&gt;Roller:&lt;/b&gt;&lt;br&gt;Byggherre&lt;br&gt;&lt;br&gt;&lt;font color="#1F4E79"&gt;&lt;b&gt;Se kedja 4&lt;/b&gt;&lt;/font&gt;' style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#BFBFBF;fontFamily=Helvetica;fontSize=14;align=left;verticalAlign=top;spacing=10;fontColor=#262626;" parent="1" vertex="1"><mxGeometry x="1522" y="190" width="220" height="196" as="geometry"/></mxCell><mxCell id="c_17" value="&lt;b&gt;rmink på webben&lt;/b&gt;&lt;br&gt;rmink.vercel.app: bild eller PDF till redigerbar anteckningsbok, Send to reMarkable. /rounds: ägarens revisionsvarv med ett tryck." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#DAEEF3;strokeColor=#1F4E79;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=12;fontColor=#262626;" parent="1" vertex="1"><mxGeometry x="40" y="410" width="556" height="96" as="geometry"/></mxCell><mxCell id="c_18" value="&lt;b&gt;rmink i din egen Claude&lt;/b&gt;&lt;br&gt;MCP-servern: Claude Desktop eller Claude Code tolkar skissen med rmink:s verktyg. Ingen kostnad för rmink, du använder ditt eget Claude-konto." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FCE4D6;strokeColor=#1F4E79;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=12;fontColor=#262626;" parent="1" vertex="1"><mxGeometry x="616" y="410" width="556" height="96" as="geometry"/></mxCell><mxCell id="c_19" value="&lt;b&gt;rmink är gratis&lt;/b&gt;&lt;br&gt;Ingen betalvägg. Frivilligt stöd på 100 kr via Stripe. Källkoden är öppen (AGPL)." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#E2EFDA;strokeColor=#1F4E79;fontFamily=Helvetica;fontSize=15;align=left;verticalAlign=top;spacing=12;fontColor=#262626;" parent="1" vertex="1"><mxGeometry x="1192" y="410" width="556" height="96" as="geometry"/></mxCell><mxCell id="t_20" value="&lt;b&gt;Kedjediagram:&lt;/b&gt; 1 Från handskiss till ren ritning · 2 Revisionsvarv: ändringar och svar · 3 Val mellan alternativ · 4 Bygglov och byggprocessen · 5 Bild eller PDF till reMarkable" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=15;fontColor=#1F4E79;align=left;verticalAlign=top;spacing=2;" parent="1" vertex="1"><mxGeometry x="40" y="526" width="1700" height="26" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
