<mxfile host="rmink" agent="docs/diagrams/build.py"><diagram id="18-granskning-och-markeringar" name="18. Granskning och markeringar (markup.toml)"><mxGraphModel dx="1480" dy="520" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1480" pageHeight="520" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t_1" value="&lt;b&gt;18. Granskning och markeringar (markup.toml)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=22;fontColor=#000000;align=left;verticalAlign=top;spacing=2;" parent="1" vertex="1"><mxGeometry x="40" y="20" width="1400" height="34" as="geometry"/></mxCell><mxCell id="t_2" value="Granskningsmarkeringar i Bluebeam-stil, kopplade till rmink:s anmärkningar: ringar med nummer på ritningen och SVAR-rader i ritningshuvudet." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;spacing=2;" parent="1" vertex="1"><mxGeometry x="40" y="56" width="1400" height="22" as="geometry"/></mxCell><mxCell id="Markeringstyper_3" value='&lt;b&gt;Markeringstyper&lt;/b&gt;&lt;table style="border-collapse:collapse;font-size:10px" cellpadding="1" cellspacing="0" border="0"&gt;&lt;tr style="font-weight:bold"&gt;&lt;td valign="top" align="left" width="80"&gt;typ&lt;/td&gt;&lt;td valign="top" align="left" width="70"&gt;en&lt;/td&gt;&lt;td valign="top" align="left" width="330"&gt;betyder&lt;/td&gt;&lt;td valign="top" align="left" width="120"&gt;gråskala&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;färg&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;grad&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="80"&gt;Fråga&lt;/td&gt;&lt;td valign="top" align="left" width="70"&gt;Question&lt;/td&gt;&lt;td valign="top" align="left" width="330"&gt;Information saknas eller är otydlig. Svaret avgör ritningen.&lt;/td&gt;&lt;td valign="top" align="left" width="120"&gt;solid / ring + ?&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;blue&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;fråga&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="80"&gt;Ändring&lt;/td&gt;&lt;td valign="top" align="left" width="70"&gt;Change&lt;/td&gt;&lt;td valign="top" align="left" width="330"&gt;Beställaren eller granskaren vill ha något annorlunda.&lt;/td&gt;&lt;td valign="top" align="left" width="120"&gt;solid / moln&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;red&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;fråga&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="80"&gt;Fel&lt;/td&gt;&lt;td valign="top" align="left" width="70"&gt;Error&lt;/td&gt;&lt;td valign="top" align="left" width="330"&gt;Strider mot en regel, ett mått eller en annan handling.&lt;/td&gt;&lt;td valign="top" align="left" width="120"&gt;solid / kryss + ring&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;red&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;fel&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="80"&gt;Info&lt;/td&gt;&lt;td valign="top" align="left" width="70"&gt;Note&lt;/td&gt;&lt;td valign="top" align="left" width="330"&gt;Upplysning, kräver inget svar.&lt;/td&gt;&lt;td valign="top" align="left" width="120"&gt;dashed / i&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;gray&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;info&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="80"&gt;Godkänt&lt;/td&gt;&lt;td valign="top" align="left" width="70"&gt;Approved&lt;/td&gt;&lt;td valign="top" align="left" width="330"&gt;Granskat utan anmärkning.&lt;/td&gt;&lt;td valign="top" align="left" width="120"&gt;solid / bock&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;green&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;info&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1"><mxGeometry x="40" y="110" width="736" height="120" as="geometry"/></mxCell><mxCell id="Status___Annotation_status_4" value='&lt;b&gt;Status → Annotation.status&lt;/b&gt;&lt;table style="border-collapse:collapse;font-size:10px" cellpadding="1" cellspacing="0" border="0"&gt;&lt;tr style="font-weight:bold"&gt;&lt;td valign="top" align="left" width="100"&gt;status&lt;/td&gt;&lt;td valign="top" align="left" width="80"&gt;rmink&lt;/td&gt;&lt;td valign="top" align="left" width="330"&gt;betyder&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="100"&gt;Öppen&lt;/td&gt;&lt;td valign="top" align="left" width="80"&gt;open&lt;/td&gt;&lt;td valign="top" align="left" width="330"&gt;Väntar på svar eller åtgärd.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="100"&gt;Besvarad&lt;/td&gt;&lt;td valign="top" align="left" width="80"&gt;open&lt;/td&gt;&lt;td valign="top" align="left" width="330"&gt;Svar finns på SVAR-raden men är inte infört på ritningen.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="100"&gt;Accepterad&lt;/td&gt;&lt;td valign="top" align="left" width="80"&gt;accepted&lt;/td&gt;&lt;td valign="top" align="left" width="330"&gt;Ändringen är införd.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="100"&gt;Avvisad&lt;/td&gt;&lt;td valign="top" align="left" width="80"&gt;rejected&lt;/td&gt;&lt;td valign="top" align="left" width="330"&gt;Ändringen görs inte, motivering i loggen.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="100"&gt;Stängd&lt;/td&gt;&lt;td valign="top" align="left" width="80"&gt;accepted&lt;/td&gt;&lt;td valign="top" align="left" width="330"&gt;Klar och behöver inte visas längre.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1"><mxGeometry x="840" y="110" width="526" height="120" as="geometry"/></mxCell><mxCell id="Prioritet_5" value='&lt;b&gt;Prioritet&lt;/b&gt;&lt;table style="border-collapse:collapse;font-size:10px" cellpadding="1" cellspacing="0" border="0"&gt;&lt;tr style="font-weight:bold"&gt;&lt;td valign="top" align="left" width="80"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="430"&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="80"&gt;Hög&lt;/td&gt;&lt;td valign="top" align="left" width="430"&gt;Stoppar nästa skede (till exempel bygglov eller beställning).&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="80"&gt;Normal&lt;/td&gt;&lt;td valign="top" align="left" width="430"&gt;Ska lösas före bygghandling.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="80"&gt;Låg&lt;/td&gt;&lt;td valign="top" align="left" width="430"&gt;Kan lösas på bygget eller i relationshandling.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1"><mxGeometry x="840" y="246" width="526" height="91" as="geometry"/></mxCell><mxCell id="CSV_export__kolumner__6" value="&lt;b&gt;CSV-export (kolumner)&lt;/b&gt;&lt;table style=&quot;border-collapse:collapse;font-size:10px&quot; cellpadding=&quot;1&quot; cellspacing=&quot;0&quot; border=&quot;0&quot;&gt;&lt;tr style=&quot;font-weight:bold&quot;&gt;&lt;td valign=&quot;top&quot; align=&quot;left&quot; width=&quot;100&quot;&gt;kolumn&lt;/td&gt;&lt;td valign=&quot;top&quot; align=&quot;left&quot; width=&quot;520&quot;&gt;från&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign=&quot;top&quot; align=&quot;left&quot; width=&quot;100&quot;&gt;Subject&lt;/td&gt;&lt;td valign=&quot;top&quot; align=&quot;left&quot; width=&quot;520&quot;&gt;markup_type.name&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign=&quot;top&quot; align=&quot;left&quot; width=&quot;100&quot;&gt;Comments&lt;/td&gt;&lt;td valign=&quot;top&quot; align=&quot;left&quot; width=&quot;520&quot;&gt;Annotation.text&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign=&quot;top&quot; align=&quot;left&quot; width=&quot;100&quot;&gt;Reply&lt;/td&gt;&lt;td valign=&quot;top&quot; align=&quot;left&quot; width=&quot;520&quot;&gt;SVAR-raden&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign=&quot;top&quot; align=&quot;left&quot; width=&quot;100&quot;&gt;Author&lt;/td&gt;&lt;td valign=&quot;top&quot; align=&quot;left&quot; width=&quot;520&quot;&gt;författare (person eller 'Claude')&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign=&quot;top&quot; align=&quot;left&quot; width=&quot;100&quot;&gt;Date&lt;/td&gt;&lt;td valign=&quot;top&quot; align=&quot;left&quot; width=&quot;520&quot;&gt;Annotation.revision → datum för varvet&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign=&quot;top&quot; align=&quot;left&quot; width=&quot;100&quot;&gt;Status&lt;/td&gt;&lt;td valign=&quot;top&quot; align=&quot;left&quot; width=&quot;520&quot;&gt;status.name&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign=&quot;top&quot; align=&quot;left&quot; width=&quot;100&quot;&gt;Page&lt;/td&gt;&lt;td valign=&quot;top&quot; align=&quot;left&quot; width=&quot;520&quot;&gt;sida i notebooken&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign=&quot;top&quot; align=&quot;left&quot; width=&quot;100&quot;&gt;Layer&lt;/td&gt;&lt;td valign=&quot;top&quot; align=&quot;left&quot; width=&quot;520&quot;&gt;lager (Ritning rNN / Kommentarer)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign=&quot;top&quot; align=&quot;left&quot; width=&quot;100&quot;&gt;Color&lt;/td&gt;&lt;td valign=&quot;top&quot; align=&quot;left&quot; width=&quot;520&quot;&gt;markup_type.color&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign=&quot;top&quot; align=&quot;left&quot; width=&quot;100&quot;&gt;Rule&lt;/td&gt;&lt;td valign=&quot;top&quot; align=&quot;left&quot; width=&quot;520&quot;&gt;rules.toml id&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign=&quot;top&quot; align=&quot;left&quot; width=&quot;100&quot;&gt;Material&lt;/td&gt;&lt;td valign=&quot;top&quot; align=&quot;left&quot; width=&quot;520&quot;&gt;materials.toml id&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign=&quot;top&quot; align=&quot;left&quot; width=&quot;100&quot;&gt;Discipline&lt;/td&gt;&lt;td valign=&quot;top&quot; align=&quot;left&quot; width=&quot;520&quot;&gt;drawing_standard.toml discipline.letter&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign=&quot;top&quot; align=&quot;left&quot; width=&quot;100&quot;&gt;Priority&lt;/td&gt;&lt;td valign=&quot;top&quot; align=&quot;left&quot; width=&quot;520&quot;&gt;priority.name&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1"><mxGeometry x="40" y="246" width="636" height="234" as="geometry"/></mxCell><mxCell id="I_rundorna_7" value='&lt;b&gt;I rundorna&lt;/b&gt;&lt;br&gt;En öppen fråga blir en Annotation (ring, kryss eller hörnmarkeringar på stora mål) med nummer.&lt;br&gt;ANMÄRKNINGAR listar dem med en SVAR-rad var.&lt;br&gt;Svar på raden eller vid ringen besvarar frågan; nästa varv sätter accepted eller rejected.&lt;br&gt;Revisionen heter "&amp;lt;namn&amp;gt; rNN · N frågor" så länge frågor är öppna.' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1"><mxGeometry x="840" y="353" width="520" height="111" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
