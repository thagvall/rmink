<mxfile host="rmink" agent="docs/diagrams/build.py"><diagram id="11-lov-och-process" name="11. Lov, anmälan och byggprocessen för småhus"><mxGraphModel dx="1880" dy="1036" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" background="#ffffff" pageWidth="1880" pageHeight="1036" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t_1" value="&lt;b&gt;11. Lov, anmälan och byggprocessen för småhus&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=22;fontColor=#000000;align=left;verticalAlign=top;spacing=2;" parent="1" vertex="1"><mxGeometry x="40" y="20" width="1400" height="34" as="geometry"/></mxCell><mxCell id="t_2" value="Vilken prövning en åtgärd kräver, i vilken ordning det sker och vem som ansvarar. Källor: PBL, PBF, ElSL (process.toml)." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#333333;align=left;verticalAlign=top;spacing=2;" parent="1" vertex="1"><mxGeometry x="40" y="56" width="1400" height="22" as="geometry"/></mxCell><mxCell id="bygglov_3" value="&lt;b&gt;Bygglov&lt;/b&gt;&lt;br&gt;PBL 9 kap. 3, 9, 15, 19–38 §§&lt;br&gt;Kommunens prövning av att åtgärden passar på platsen och följer detaljplanen. Följs av startbesked innan arbetet får börja." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1"><mxGeometry x="1580" y="110" width="260" height="97" as="geometry"/></mxCell><mxCell id="rivningslov_4" value="&lt;b&gt;Rivningslov&lt;/b&gt;&lt;br&gt;PBL 9 kap. 43–50 §§&lt;br&gt;Krävs för rivning inom detaljplan om planen inte säger annat. Utanför detaljplan räcker ofta en anmälan (PBF 6 kap. 1 § 1)." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1"><mxGeometry x="1580" y="217" width="260" height="97" as="geometry"/></mxCell><mxCell id="marklov_5" value="&lt;b&gt;Marklov&lt;/b&gt;&lt;br&gt;PBL 9 kap. 43–50 §§&lt;br&gt;Schaktning, fyllning eller trädfällning som ändrar markens höjdläge, främst inom detaljplan." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1"><mxGeometry x="1580" y="324" width="260" height="83" as="geometry"/></mxCell><mxCell id="anmalan_6" value="&lt;b&gt;Anmälan&lt;/b&gt;&lt;br&gt;PBF 6 kap. 1–6 §§&lt;br&gt;Ingen lovprövning, men kommunen ger startbesked. Gäller till exempel bärande ändringar, eldstad och VA (se rule pbf-anmalan)." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1"><mxGeometry x="1580" y="417" width="260" height="97" as="geometry"/></mxCell><mxCell id="lovfri_7" value="&lt;b&gt;Lov- och anmälningsfri&lt;/b&gt;&lt;br&gt;PBL 9 kap. 4–17 a §§&lt;br&gt;Varken lov eller anmälan, men de tekniska kraven (8 kap. 4 §, BFS) gäller ändå. Lovfriheten bryts av 9 kap. 34–38 §§ (nära gräns, värdefullt område)." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1"><mxGeometry x="1580" y="523" width="260" height="111" as="geometry"/></mxCell><mxCell id="frivilligt_lov_8" value="&lt;b&gt;Frivilligt lov&lt;/b&gt;&lt;br&gt;PBL 9 kap. 52 §&lt;br&gt;Man får alltid söka lov för en lovfri åtgärd, till exempel för att få besked om att den är tillåten." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1"><mxGeometry x="1580" y="644" width="260" height="83" as="geometry"/></mxCell><mxCell id="Åtgärder___prövning_9" value='&lt;b&gt;Åtgärder → prövning&lt;/b&gt;&lt;table style="border-collapse:collapse;font-size:10px" cellpadding="1" cellspacing="0" border="0"&gt;&lt;tr style="font-weight:bold"&gt;&lt;td valign="top" align="left" width="170"&gt;åtgärd&lt;/td&gt;&lt;td valign="top" align="left" width="90"&gt;normalt&lt;/td&gt;&lt;td valign="top" align="left" width="330"&gt;undantag om&lt;/td&gt;&lt;td valign="top" align="left" width="80"&gt;då&lt;/td&gt;&lt;td valign="top" align="left" width="230"&gt;utom om&lt;/td&gt;&lt;td valign="top" align="left" width="170"&gt;regler&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="170"&gt;Komplementbyggnad eller komplementbostadshus (förr friggebod/attefall)&lt;/td&gt;&lt;td valign="top" align="left" width="90"&gt;Bygglov&lt;/td&gt;&lt;td valign="top" align="left" width="330"&gt;Inom detaljplan högst 30,0 m² och nock 4,0 m; utanför detaljplan högst 50,0 m² och nock 4,5 m; mindre än huvudbyggnaden; summan på tomten högst 45,0 resp. 65,0 m²&lt;/td&gt;&lt;td valign="top" align="left" width="80"&gt;Lov- och anmälningsfri&lt;/td&gt;&lt;td valign="top" align="left" width="230"&gt;Närmare gräns än 4,5 m utan grannens skriftliga medgivande (9 kap. 34–35 §§), eller särskilt värdefull byggnad eller om…&lt;/td&gt;&lt;td valign="top" align="left" width="170"&gt;pbl-komplementbyggnad, pbl-narhet-grans, pbl-varde, bfs7-avstand-byggnader&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="170"&gt;Tillbyggnad av bostadshus&lt;/td&gt;&lt;td valign="top" align="left" width="90"&gt;Bygglov&lt;/td&gt;&lt;td valign="top" align="left" width="330"&gt;Högst 30,0 m² bruttoarea/öppenarea sammanlagt med tidigare lovfria tillbyggnader, och inte över husets taknock&lt;/td&gt;&lt;td valign="top" align="left" width="80"&gt;Lov- och anmälningsfri&lt;/td&gt;&lt;td valign="top" align="left" width="230"&gt;Närmare gräns än 4,5 m utan medgivande (34 §) eller värdefullt (37 §). Ändras bärande delar väsentligt krävs ändå anmäl…&lt;/td&gt;&lt;td valign="top" align="left" width="170"&gt;pbl-tillbyggnad-30, pbl-narhet-grans, pbl-varde, pbf-anmalan&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="170"&gt;Altan, mur eller plank&lt;/td&gt;&lt;td valign="top" align="left" width="90"&gt;Lov- och anmälningsfri&lt;/td&gt;&lt;td valign="top" align="left" width="330"&gt;–&lt;/td&gt;&lt;td valign="top" align="left" width="80"&gt;Bygglov&lt;/td&gt;&lt;td valign="top" align="left" width="230"&gt;Inom detaljplan: högre än 1,8 m över mark inom 3,6 m från byggnad, eller högre än 1,2 m längre bort (9 kap. 19 §). Mur/…&lt;/td&gt;&lt;td valign="top" align="left" width="170"&gt;pbl-altan-mur-plank, pbl-narhet-grans, bfs9-skydd-mot-fall&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="170"&gt;Ta bort eller ändra bärande vägg/bjälklag&lt;/td&gt;&lt;td valign="top" align="left" width="90"&gt;Anmälan&lt;/td&gt;&lt;td valign="top" align="left" width="330"&gt;Ändringen påverkar inte konstruktionen väsentligt&lt;/td&gt;&lt;td valign="top" align="left" width="80"&gt;Lov- och anmälningsfri&lt;/td&gt;&lt;td valign="top" align="left" width="230"&gt;–&lt;/td&gt;&lt;td valign="top" align="left" width="170"&gt;pbf-anmalan&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="170"&gt;Ny eldstad, rökkanal eller ventilation&lt;/td&gt;&lt;td valign="top" align="left" width="90"&gt;Anmälan&lt;/td&gt;&lt;td valign="top" align="left" width="330"&gt;–&lt;/td&gt;&lt;td valign="top" align="left" width="80"&gt;Anmälan&lt;/td&gt;&lt;td valign="top" align="left" width="230"&gt;–&lt;/td&gt;&lt;td valign="top" align="left" width="170"&gt;pbf-anmalan&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="170"&gt;Ny eller väsentligt ändrad vatten- eller avloppsinstallation (till exempel nytt badrum)&lt;/td&gt;&lt;td valign="top" align="left" width="90"&gt;Anmälan&lt;/td&gt;&lt;td valign="top" align="left" width="330"&gt;–&lt;/td&gt;&lt;td valign="top" align="left" width="80"&gt;Anmälan&lt;/td&gt;&lt;td valign="top" align="left" width="230"&gt;–&lt;/td&gt;&lt;td valign="top" align="left" width="170"&gt;pbf-anmalan, praxis-vatrum-branschregler&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="170"&gt;Inreda ytterligare en bostad&lt;/td&gt;&lt;td valign="top" align="left" width="90"&gt;Bygglov&lt;/td&gt;&lt;td valign="top" align="left" width="330"&gt;En ytterligare bostad i ett enbostadshus (inte komplementbostadshus)&lt;/td&gt;&lt;td valign="top" align="left" width="80"&gt;Lov- och anmälningsfri&lt;/td&gt;&lt;td valign="top" align="left" width="230"&gt;Totalförsvarsområde (36 §) eller värdefullt (37 §)&lt;/td&gt;&lt;td valign="top" align="left" width="170"&gt;pbl-varde&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="170"&gt;Solenergianläggning på fasad eller tak&lt;/td&gt;&lt;td valign="top" align="left" width="90"&gt;Lov- och anmälningsfri&lt;/td&gt;&lt;td valign="top" align="left" width="330"&gt;Högst 11 kW&lt;/td&gt;&lt;td valign="top" align="left" width="80"&gt;Lov- och anmälningsfri&lt;/td&gt;&lt;td valign="top" align="left" width="230"&gt;Särskilt värdefullt område (37 §) eller totalförsvarsområde inom detaljplan (36 § 2)&lt;/td&gt;&lt;td valign="top" align="left" width="170"&gt;–&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="170"&gt;Elinstallation (uttag, belysning, central, fast anslutning)&lt;/td&gt;&lt;td valign="top" align="left" width="90"&gt;Auktoriserad elinstallatör&lt;/td&gt;&lt;td valign="top" align="left" width="330"&gt;Vissa enklare arbeten enligt Elsäkerhetsverkets föreskrifter (ej kontrollerat)&lt;/td&gt;&lt;td valign="top" align="left" width="80"&gt;Auktoriserad elinstallatör&lt;/td&gt;&lt;td valign="top" align="left" width="230"&gt;–&lt;/td&gt;&lt;td valign="top" align="left" width="170"&gt;elsl-behorighet, elsak-undantag&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1"><mxGeometry x="40" y="110" width="1086" height="369" as="geometry"/></mxCell><mxCell id="1_Ansökan_om_lov_eller_anmälan_10" value="&lt;b&gt;1 Ansökan om lov eller anmälan&lt;/b&gt;&lt;br&gt;PBL 9 kap. 86 §, PBF 6 kap. 5–6 §§&lt;br&gt;• fastighetsbeteckning&lt;br&gt;• byggherre&lt;br&gt;• kontrollansvarig (om krävs)&lt;br&gt;• planerad start&lt;br&gt;• ritningar och beskrivningar som behövs för prövningen&lt;br&gt;rmink: Skede Bygglovshandling. Ritningshuvudet ska ha fastighetsbeteckning och byggherre." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1"><mxGeometry x="40" y="519" width="280" height="166" as="geometry"/></mxCell><mxCell id="2_Tekniskt_samråd_11" value="&lt;b&gt;2 Tekniskt samråd&lt;/b&gt;&lt;br&gt;PBL 10 kap. 14–21 §§&lt;br&gt;• förslag till kontrollplan&lt;br&gt;• avfallshanteringsplan&lt;br&gt;• övriga handlingar&lt;br&gt;rmink: Hålls när KA krävs, när byggherren begär det eller om det inte är uppenbart obehövligt." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1"><mxGeometry x="344" y="519" width="280" height="166" as="geometry"/></mxCell><mxCell id="e_12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;strokeColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="1_Ansökan_om_lov_eller_anmälan_10" target="2_Tekniskt_samråd_11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="3_Startbesked_13" value="&lt;b&gt;3 Startbesked&lt;/b&gt;&lt;br&gt;PBL 10 kap. 3, 23–25 §§&lt;br&gt;• fastställd kontrollplan&lt;br&gt;rmink: Arbetet får inte börja före startbesked. Ritningen kan bli Bygghandling." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1"><mxGeometry x="648" y="519" width="280" height="166" as="geometry"/></mxCell><mxCell id="e_14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;strokeColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="2_Tekniskt_samråd_11" target="3_Startbesked_13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="4_Utförande__kontroller_och_arbetsplatsb_15" value="&lt;b&gt;4 Utförande, kontroller och arbetsplatsbesök&lt;/b&gt;&lt;br&gt;PBL 10 kap. 2 c, 26–28 §§&lt;br&gt;• egenkontroller enligt kontrollplanen&lt;br&gt;• utstakning om nämnden kräver det&lt;br&gt;rmink: Ändringar under bygget = nya revisionsvarv; SVAR-rader dokumenterar beslut (underlag för ÄTA)." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1"><mxGeometry x="952" y="519" width="280" height="166" as="geometry"/></mxCell><mxCell id="e_16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;strokeColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="3_Startbesked_13" target="4_Utförande__kontroller_och_arbetsplatsb_15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="5_Slutsamråd_och_slutbesked_17" value="&lt;b&gt;5 Slutsamråd och slutbesked&lt;/b&gt;&lt;br&gt;PBL 10 kap. 4, 34–38 §§&lt;br&gt;• intyg om utförda kontroller&lt;br&gt;• relationshandlingar vid behov&lt;br&gt;rmink: Ritningen kan bli Relationshandling. Byggnaden får inte tas i bruk före slutbesked (om nämnden inte beslutar annat)." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1"><mxGeometry x="1256" y="519" width="280" height="166" as="geometry"/></mxCell><mxCell id="e_18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;strokeColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="4_Utförande__kontroller_och_arbetsplatsb_15" target="5_Slutsamråd_och_slutbesked_17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Roller_19" value='&lt;b&gt;Roller&lt;/b&gt;&lt;table style="border-collapse:collapse;font-size:10px" cellpadding="1" cellspacing="0" border="0"&gt;&lt;tr style="font-weight:bold"&gt;&lt;td valign="top" align="left" width="170"&gt;roll&lt;/td&gt;&lt;td valign="top" align="left" width="40"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="200"&gt;lagrum&lt;/td&gt;&lt;td valign="top" align="left" width="520"&gt;ansvar&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="170"&gt;Byggherre&lt;/td&gt;&lt;td valign="top" align="left" width="40"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="200"&gt;PBL 10 kap. 5–5 c §§&lt;/td&gt;&lt;td valign="top" align="left" width="520"&gt;Ansvarar för att åtgärden och projekteringen uppfyller kraven, och för att kontrollplan och avfallshanteringsplan följs. För ett småhus är det oftast fastighetsägaren.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="170"&gt;Kontrollansvarig (KA)&lt;/td&gt;&lt;td valign="top" align="left" width="40"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="200"&gt;PBL 10 kap. 9–11 c §§, PBF 7 kap. 5 §&lt;/td&gt;&lt;td valign="top" align="left" width="520"&gt;Certifierad person som tar fram kontrollplan med byggherren och ser till att den följs. Krävs INTE för anmälan, komplementbyggnad, mur/plank/altan eller små ändringar av en- och tvåbostadshus, om näm…&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="170"&gt;Sakkunnig&lt;/td&gt;&lt;td valign="top" align="left" width="40"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="200"&gt;PBL 10 kap. 8, 12–12 d §§&lt;/td&gt;&lt;td valign="top" align="left" width="520"&gt;Certifierad kontrollant för särskilda delar, till exempel brand eller tillgänglighet, när kontrollplanen eller föreskrifter kräver det.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="170"&gt;Byggbedömare&lt;/td&gt;&lt;td valign="top" align="left" width="40"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="200"&gt;PBL 1 kap. 7 §, 9 kap. 68 §, 10 kap. 13–13 e §§&lt;/td&gt;&lt;td valign="top" align="left" width="520"&gt;Nytt (SFS 2026:712): certifierat företag som kan användas vid lovprövning och kontroll av viss nybyggnad. Då ersätter dess kontroll kontrollplanen.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="170"&gt;Byggnadsnämnden&lt;/td&gt;&lt;td valign="top" align="left" width="40"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="200"&gt;PBL 9–10 kap.&lt;/td&gt;&lt;td valign="top" align="left" width="520"&gt;Kommunens nämnd som ger lov, tar emot anmälan, håller tekniskt samråd och ger start- och slutbesked.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="170"&gt;Auktoriserad elinstallatör&lt;/td&gt;&lt;td valign="top" align="left" width="40"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="200"&gt;ElSL 5 §, 20 §&lt;/td&gt;&lt;td valign="top" align="left" width="520"&gt;Person med auktorisation från Elsäkerhetsverket för alla eller vissa slag av elinstallationsarbete.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="170"&gt;Elinstallationsföretag&lt;/td&gt;&lt;td valign="top" align="left" width="40"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="200"&gt;ElSL 23–25 §§&lt;/td&gt;&lt;td valign="top" align="left" width="520"&gt;Företag som yrkesmässigt utför elinstallationsarbete. Ska ha minst en auktoriserad elinstallatör, ett egenkontrollprogram och vara anmält till Elsäkerhetsverket innan arbete på andras anläggningar.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1"><mxGeometry x="40" y="745" width="946" height="251" as="geometry"/></mxCell><mxCell id="Dokument_20" value='&lt;b&gt;Dokument&lt;/b&gt;&lt;table style="border-collapse:collapse;font-size:10px" cellpadding="1" cellspacing="0" border="0"&gt;&lt;tr style="font-weight:bold"&gt;&lt;td valign="top" align="left" width="130"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="140"&gt;lagrum&lt;/td&gt;&lt;td valign="top" align="left" width="360"&gt;innehåll&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="130"&gt;Kontrollplan&lt;/td&gt;&lt;td valign="top" align="left" width="140"&gt;PBL 10 kap. 6–8 §§&lt;/td&gt;&lt;td valign="top" align="left" width="360"&gt;vilka kontroller som ska göras och vilka krav de avser; vem som gör kontrollerna och hur; vilka anmälningar som ska göras till byggnadsnämnden; vilka arbetsplatsbesök nämnden bör göra och när; vad som kontrolleras genom egenkontroll respektive av sakkunnig&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="130"&gt;Avfallshanteringsplan&lt;/td&gt;&lt;td valign="top" align="left" width="140"&gt;PBL 10 kap. 8 a §&lt;/td&gt;&lt;td valign="top" align="left" width="360"&gt;byggprodukter som kan återanvändas och hur; avfall som uppstår och hur det tas om hand; hur farliga ämnen hanteras och avlägsnas säkert&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1"><mxGeometry x="1000" y="745" width="646" height="166" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
