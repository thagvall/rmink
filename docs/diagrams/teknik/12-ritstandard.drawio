<mxfile host="rmink" agent="docs/diagrams/build.py"><diagram id="12-ritstandard" name="12. Ritstandard (drawing_standard.toml)"><mxGraphModel dx="1582" dy="1169" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" background="#ffffff" pageWidth="1582" pageHeight="1169" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t_1" value="&lt;b&gt;12. Ritstandard (drawing_standard.toml)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=22;fontColor=#000000;align=left;verticalAlign=top;spacing=2;" parent="1" vertex="1"><mxGeometry x="40" y="20" width="1400" height="34" as="geometry"/></mxCell><mxCell id="t_2" value="I rmink:s egna ord efter Bygghandlingar 90 och SS-EN ISO 128 (linjer), 129 (mått), 5455 (skalor), 7200 (ritningshuvud), 7519 och 4157 (beteckningar)." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#333333;align=left;verticalAlign=top;spacing=2;" parent="1" vertex="1"><mxGeometry x="40" y="56" width="1400" height="22" as="geometry"/></mxCell><mxCell id="Ritningstyper_3" value='&lt;b&gt;Ritningstyper&lt;/b&gt;&lt;table style="border-collapse:collapse;font-size:10px" cellpadding="1" cellspacing="0" border="0"&gt;&lt;tr style="font-weight:bold"&gt;&lt;td valign="top" align="left" width="130"&gt;typ&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;skalor&lt;/td&gt;&lt;td valign="top" align="left" width="260"&gt;visar&lt;/td&gt;&lt;td valign="top" align="left" width="200"&gt;måste ha&lt;/td&gt;&lt;td valign="top" align="left" width="50"&gt;småhus&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="130"&gt;Situationsplan&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;1:400, 1:500, 1:1000&lt;/td&gt;&lt;td valign="top" align="left" width="260"&gt;Tomten, byggnadens placering, mått till tomtgräns, angöring, höjder (marknivå, ±0), väderstreck.&lt;/td&gt;&lt;td valign="top" align="left" width="200"&gt;norrpil, skala, tomtgrans_matt, nivaer&lt;/td&gt;&lt;td valign="top" align="left" width="50"&gt;ja&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="130"&gt;Planritning&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;1:50, 1:100&lt;/td&gt;&lt;td valign="top" align="left" width="260"&gt;Ett våningsplan i snitt ca 1 m över golv: väggar, öppningar, rum, inredning, mått.&lt;/td&gt;&lt;td valign="top" align="left" width="200"&gt;norrpil, skala, rumsnamn, yttermatt, snittmarkering_om_sektion&lt;/td&gt;&lt;td valign="top" align="left" width="50"&gt;ja&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="130"&gt;Sektion&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;1:20, 1:50, 1:100&lt;/td&gt;&lt;td valign="top" align="left" width="260"&gt;Vertikalt snitt genom byggnaden: bjälklag, tak, grund, höjder och konstruktionsuppbyggnad.&lt;/td&gt;&lt;td valign="top" align="left" width="200"&gt;skala, sektionsbeteckning, nivaer, konstruktionstext&lt;/td&gt;&lt;td valign="top" align="left" width="50"&gt;ja&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="130"&gt;Fasadritning&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;1:50, 1:100&lt;/td&gt;&lt;td valign="top" align="left" width="260"&gt;Byggnaden sedd utifrån per väderstreck: material, kulörer, fönster, takfot, marklinje.&lt;/td&gt;&lt;td valign="top" align="left" width="200"&gt;skala, vaderstreck_i_namn, marklinje, materialtext&lt;/td&gt;&lt;td valign="top" align="left" width="50"&gt;ja&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="130"&gt;Detaljritning&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;1:1, 1:2, 1:5, 1:10&lt;/td&gt;&lt;td valign="top" align="left" width="260"&gt;En anslutning eller ett utsnitt i hög upplösning: skikt, infästningar, tätningar.&lt;/td&gt;&lt;td valign="top" align="left" width="200"&gt;skala, hanvisning_till_plan_eller_sektion, skikttext&lt;/td&gt;&lt;td valign="top" align="left" width="50"&gt;ja&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="130"&gt;Konstruktionsritning (K)&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;1:20, 1:50&lt;/td&gt;&lt;td valign="top" align="left" width="260"&gt;Bärande system: dimensioner, hållfasthetsklasser, förband, armering, laster.&lt;/td&gt;&lt;td valign="top" align="left" width="200"&gt;skala, hallfasthetsklass, dimensioner&lt;/td&gt;&lt;td valign="top" align="left" width="50"&gt;ja&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="130"&gt;VVS-ritning (V/R)&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;1:50, 1:100&lt;/td&gt;&lt;td valign="top" align="left" width="260"&gt;Vatten, avlopp, värme, ventilation, golvbrunnar, fall.&lt;/td&gt;&lt;td valign="top" align="left" width="200"&gt;skala, fall_till_brunn&lt;/td&gt;&lt;td valign="top" align="left" width="50"&gt;nej&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="130"&gt;Elritning (E)&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;1:50, 1:100&lt;/td&gt;&lt;td valign="top" align="left" width="260"&gt;Uttag, belysning, strömställare, centraler.&lt;/td&gt;&lt;td valign="top" align="left" width="200"&gt;skala, symbolforklaring&lt;/td&gt;&lt;td valign="top" align="left" width="50"&gt;nej&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="130"&gt;Skiss&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;ingen, ca 1:50&lt;/td&gt;&lt;td valign="top" align="left" width="260"&gt;Frihandsunderlag. Mått skrivna för hand gäller före det uppmätta.&lt;/td&gt;&lt;td valign="top" align="left" width="200"&gt;–&lt;/td&gt;&lt;td valign="top" align="left" width="50"&gt;ja&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1"><mxGeometry x="40" y="110" width="766" height="292" as="geometry"/></mxCell><mxCell id="Skeden_4" value='&lt;b&gt;Skeden&lt;/b&gt;&lt;br&gt;&lt;font color="#333333"&gt;rmink: Förslag → systemhandling; Granskning → granskningshandling; Beslut → bygghandling&lt;/font&gt;&lt;table style="border-collapse:collapse;font-size:10px" cellpadding="1" cellspacing="0" border="0"&gt;&lt;tr style="font-weight:bold"&gt;&lt;td valign="top" align="left" width="20"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="160"&gt;skede&lt;/td&gt;&lt;td valign="top" align="left" width="400"&gt;innebär&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="20"&gt;1&lt;/td&gt;&lt;td valign="top" align="left" width="160"&gt;Programhandling&lt;/td&gt;&lt;td valign="top" align="left" width="400"&gt;Behov, krav och förutsättningar. Inga bindande lösningar.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="20"&gt;2&lt;/td&gt;&lt;td valign="top" align="left" width="160"&gt;Systemhandling&lt;/td&gt;&lt;td valign="top" align="left" width="400"&gt;Valda principlösningar (stomme, installationer). Underlag för val.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="20"&gt;3&lt;/td&gt;&lt;td valign="top" align="left" width="160"&gt;Bygglovshandling&lt;/td&gt;&lt;td valign="top" align="left" width="400"&gt;Det kommunen behöver för lov eller anmälan: situationsplan, plan, sektion, fasad.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="20"&gt;4&lt;/td&gt;&lt;td valign="top" align="left" width="160"&gt;Granskningshandling&lt;/td&gt;&lt;td valign="top" align="left" width="400"&gt;Utgåva för granskning av beställare eller andra konsulter. Får ändras.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="20"&gt;5&lt;/td&gt;&lt;td valign="top" align="left" width="160"&gt;Förfrågningsunderlag (FU)&lt;/td&gt;&lt;td valign="top" align="left" width="400"&gt;Underlag för anbud. Ändringar efter detta kostar.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="20"&gt;6&lt;/td&gt;&lt;td valign="top" align="left" width="160"&gt;Bygghandling&lt;/td&gt;&lt;td valign="top" align="left" width="400"&gt;Gäller för utförandet på bygget.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="20"&gt;7&lt;/td&gt;&lt;td valign="top" align="left" width="160"&gt;Relationshandling&lt;/td&gt;&lt;td valign="top" align="left" width="400"&gt;Hur det faktiskt blev byggt. Underlag för förvaltning.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1"><mxGeometry x="876" y="110" width="596" height="177" as="geometry"/></mxCell><mxCell id="Ritningshuvud_5" value='&lt;b&gt;Ritningshuvud&lt;/b&gt;&lt;br&gt;&lt;font color="#333333"&gt;Numrering &amp;lt;disciplin&amp;gt;-&amp;lt;typ&amp;gt;.&amp;lt;löpnr&amp;gt;-&amp;lt;blad&amp;gt;: A-40.1-01 = arkitekt, planritning, plan 1, blad 01&lt;/font&gt;&lt;table style="border-collapse:collapse;font-size:10px" cellpadding="1" cellspacing="0" border="0"&gt;&lt;tr style="font-weight:bold"&gt;&lt;td valign="top" align="left" width="200"&gt;fält&lt;/td&gt;&lt;td valign="top" align="left" width="40"&gt;krav&lt;/td&gt;&lt;td valign="top" align="left" width="300"&gt;exempel&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="200"&gt;Projekt / objekt&lt;/td&gt;&lt;td valign="top" align="left" width="40"&gt;ja&lt;/td&gt;&lt;td valign="top" align="left" width="300"&gt;Villa Ek, altan&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="200"&gt;Innehåll (vad ritningen visar)&lt;/td&gt;&lt;td valign="top" align="left" width="40"&gt;ja&lt;/td&gt;&lt;td valign="top" align="left" width="300"&gt;Plan och sektion A-A&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="200"&gt;Ritningsnummer&lt;/td&gt;&lt;td valign="top" align="left" width="40"&gt;ja&lt;/td&gt;&lt;td valign="top" align="left" width="300"&gt;A-40.1-01&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="200"&gt;Skala (och pappersformat)&lt;/td&gt;&lt;td valign="top" align="left" width="40"&gt;ja&lt;/td&gt;&lt;td valign="top" align="left" width="300"&gt;1:50 (A3)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="200"&gt;Datum&lt;/td&gt;&lt;td valign="top" align="left" width="40"&gt;ja&lt;/td&gt;&lt;td valign="top" align="left" width="300"&gt;2026-10-28&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="200"&gt;Skede / status&lt;/td&gt;&lt;td valign="top" align="left" width="40"&gt;ja&lt;/td&gt;&lt;td valign="top" align="left" width="300"&gt;Granskningshandling&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="200"&gt;Revision&lt;/td&gt;&lt;td valign="top" align="left" width="40"&gt;ja&lt;/td&gt;&lt;td valign="top" align="left" width="300"&gt;B&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="200"&gt;Upprättad av&lt;/td&gt;&lt;td valign="top" align="left" width="40"&gt;nej&lt;/td&gt;&lt;td valign="top" align="left" width="300"&gt;TH&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="200"&gt;Granskad av&lt;/td&gt;&lt;td valign="top" align="left" width="40"&gt;nej&lt;/td&gt;&lt;td valign="top" align="left" width="300"&gt;—&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="200"&gt;Beställare / byggherre&lt;/td&gt;&lt;td valign="top" align="left" width="40"&gt;nej&lt;/td&gt;&lt;td valign="top" align="left" width="300"&gt;Familjen Ek&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="200"&gt;Fastighetsbeteckning&lt;/td&gt;&lt;td valign="top" align="left" width="40"&gt;nej&lt;/td&gt;&lt;td valign="top" align="left" width="300"&gt;Ekbacken 1:23&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1"><mxGeometry x="876" y="303" width="556" height="222" as="geometry"/></mxCell><mxCell id="Discipliner_6" value='&lt;b&gt;Discipliner&lt;/b&gt;&lt;table style="border-collapse:collapse;font-size:10px" cellpadding="1" cellspacing="0" border="0"&gt;&lt;tr style="font-weight:bold"&gt;&lt;td valign="top" align="left" width="30"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="250"&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="30"&gt;A&lt;/td&gt;&lt;td valign="top" align="left" width="250"&gt;Arkitekt&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="30"&gt;K&lt;/td&gt;&lt;td valign="top" align="left" width="250"&gt;Konstruktion (bärande)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="30"&gt;V&lt;/td&gt;&lt;td valign="top" align="left" width="250"&gt;Värme och sanitet (VS)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="30"&gt;R&lt;/td&gt;&lt;td valign="top" align="left" width="250"&gt;Rör (används i vissa projekt i stället för V)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="30"&gt;L&lt;/td&gt;&lt;td valign="top" align="left" width="250"&gt;Luftbehandling / ventilation&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="30"&gt;E&lt;/td&gt;&lt;td valign="top" align="left" width="250"&gt;El och tele&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="30"&gt;M&lt;/td&gt;&lt;td valign="top" align="left" width="250"&gt;Mark&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="30"&gt;S&lt;/td&gt;&lt;td valign="top" align="left" width="250"&gt;Styr och övervakning&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="30"&gt;B&lt;/td&gt;&lt;td valign="top" align="left" width="250"&gt;Brand&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1"><mxGeometry x="40" y="418" width="296" height="177" as="geometry"/></mxCell><mxCell id="Linjetyper___rmink_kategori_7" value='&lt;b&gt;Linjetyper → rmink-kategori&lt;/b&gt;&lt;table style="border-collapse:collapse;font-size:10px" cellpadding="1" cellspacing="0" border="0"&gt;&lt;tr style="font-weight:bold"&gt;&lt;td valign="top" align="left" width="90"&gt;id&lt;/td&gt;&lt;td valign="top" align="left" width="240"&gt;används till&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;typ&lt;/td&gt;&lt;td valign="top" align="left" width="50"&gt;vikt&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;mm&lt;/td&gt;&lt;td valign="top" align="left" width="150"&gt;kategori&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="90"&gt;snitt_grov&lt;/td&gt;&lt;td valign="top" align="left" width="240"&gt;Snittade bärande delar och konturer i snitt&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;solid&lt;/td&gt;&lt;td valign="top" align="left" width="50"&gt;grov&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;0,5–0,7&lt;/td&gt;&lt;td valign="top" align="left" width="150"&gt;structure (Bärande)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="90"&gt;synlig_medel&lt;/td&gt;&lt;td valign="top" align="left" width="240"&gt;Synliga kanter som inte är snittade, öppningar, inredning&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;solid&lt;/td&gt;&lt;td valign="top" align="left" width="50"&gt;medel&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;0,25–0,35&lt;/td&gt;&lt;td valign="top" align="left" width="150"&gt;default (Linje)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="90"&gt;fin&lt;/td&gt;&lt;td valign="top" align="left" width="240"&gt;Måttlinjer, hänvisningslinjer, skrafferingar, rutnät&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;solid&lt;/td&gt;&lt;td valign="top" align="left" width="50"&gt;fin&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;0,13–0,18&lt;/td&gt;&lt;td valign="top" align="left" width="150"&gt;dimension (Mått)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="90"&gt;dold&lt;/td&gt;&lt;td valign="top" align="left" width="240"&gt;Dolda kanter, delar ovanför snittet (till exempel takfot i plan)&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;dashed&lt;/td&gt;&lt;td valign="top" align="left" width="50"&gt;medel&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;0,25–0,35&lt;/td&gt;&lt;td valign="top" align="left" width="150"&gt;hidden (Dold)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="90"&gt;centrum&lt;/td&gt;&lt;td valign="top" align="left" width="240"&gt;Centrumlinjer, symmetrilinjer, modullinjer&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;dashdot&lt;/td&gt;&lt;td valign="top" align="left" width="50"&gt;fin&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;0,13–0,18&lt;/td&gt;&lt;td valign="top" align="left" width="150"&gt;center (Centrumlinje)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="90"&gt;snittlinje&lt;/td&gt;&lt;td valign="top" align="left" width="240"&gt;Snittets läge i plan (grov punktstreckad i ändarna, pilar mot blickriktningen)&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;dashdot&lt;/td&gt;&lt;td valign="top" align="left" width="50"&gt;grov&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;0,5–0,7&lt;/td&gt;&lt;td valign="top" align="left" width="150"&gt;structure (Bärande)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="90"&gt;gransa&lt;/td&gt;&lt;td valign="top" align="left" width="240"&gt;Tomtgräns, fastighetsgräns&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;dashdot&lt;/td&gt;&lt;td valign="top" align="left" width="50"&gt;medel&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;0,35–0,5&lt;/td&gt;&lt;td valign="top" align="left" width="150"&gt;center (Centrumlinje)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="90"&gt;rivning&lt;/td&gt;&lt;td valign="top" align="left" width="240"&gt;Delar som ska rivas (vid ombyggnad)&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;dashed&lt;/td&gt;&lt;td valign="top" align="left" width="50"&gt;medel&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;0,25–0,35&lt;/td&gt;&lt;td valign="top" align="left" width="150"&gt;change (Ändring)&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1"><mxGeometry x="876" y="541" width="666" height="214" as="geometry"/></mxCell><mxCell id="Beteckningar_8" value='&lt;b&gt;Beteckningar&lt;/b&gt;&lt;table style="border-collapse:collapse;font-size:10px" cellpadding="1" cellspacing="0" border="0"&gt;&lt;tr style="font-weight:bold"&gt;&lt;td valign="top" align="left" width="110"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="280"&gt;mönster&lt;/td&gt;&lt;td valign="top" align="left" width="150"&gt;exempel&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="110"&gt;rum&lt;/td&gt;&lt;td valign="top" align="left" width="280"&gt;Rumsnamn + yta, ibland rumsnummer&lt;/td&gt;&lt;td valign="top" align="left" width="150"&gt;SOV 12,4 m²&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="110"&gt;dorr&lt;/td&gt;&lt;td valign="top" align="left" width="280"&gt;D + löpnr, eller bredd i moduler&lt;/td&gt;&lt;td valign="top" align="left" width="150"&gt;D1 / 9×21 = 900×2100 karmyttermått&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="110"&gt;fonster&lt;/td&gt;&lt;td valign="top" align="left" width="280"&gt;F + löpnr, eller moduler&lt;/td&gt;&lt;td valign="top" align="left" width="150"&gt;F1 / 12×12&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="110"&gt;vaggtyp&lt;/td&gt;&lt;td valign="top" align="left" width="280"&gt;Väggtypskod i en ring eller ruta som hänvisar till typlista&lt;/td&gt;&lt;td valign="top" align="left" width="150"&gt;YV1, IV1&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="110"&gt;sektion&lt;/td&gt;&lt;td valign="top" align="left" width="280"&gt;Bokstav eller siffra vid snittlinjen; samma på sektionsritningen&lt;/td&gt;&lt;td valign="top" align="left" width="150"&gt;A-A, 1-1&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="110"&gt;detaljhanvisning&lt;/td&gt;&lt;td valign="top" align="left" width="280"&gt;Ring med detaljnummer över ritningsnummer&lt;/td&gt;&lt;td valign="top" align="left" width="150"&gt;3 / A-50-01&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="110"&gt;niva&lt;/td&gt;&lt;td valign="top" align="left" width="280"&gt;Triangel eller pil mot en linje + nivå&lt;/td&gt;&lt;td valign="top" align="left" width="150"&gt;▽ FG +12,350&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1"><mxGeometry x="40" y="611" width="556" height="187" as="geometry"/></mxCell><mxCell id="Måttsättning__enhet_mm__9" value="&lt;b&gt;Måttsättning (enhet mm)&lt;/b&gt;&lt;table style=&quot;border-collapse:collapse;font-size:10px&quot; cellpadding=&quot;1&quot; cellspacing=&quot;0&quot; border=&quot;0&quot;&gt;&lt;tr style=&quot;font-weight:bold&quot;&gt;&lt;td valign=&quot;top&quot; align=&quot;left&quot; width=&quot;20&quot;&gt;&lt;/td&gt;&lt;td valign=&quot;top&quot; align=&quot;left&quot; width=&quot;600&quot;&gt;regel&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign=&quot;top&quot; align=&quot;left&quot; width=&quot;20&quot;&gt;1&lt;/td&gt;&lt;td valign=&quot;top&quot; align=&quot;left&quot; width=&quot;600&quot;&gt;Mått anges i mm utan enhet; nivåer i meter med tre decimaler (+12,350).&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign=&quot;top&quot; align=&quot;left&quot; width=&quot;20&quot;&gt;2&lt;/td&gt;&lt;td valign=&quot;top&quot; align=&quot;left&quot; width=&quot;600&quot;&gt;Måttkedjor går hela vägen: delmåtten ska summera till totalmåttet.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign=&quot;top&quot; align=&quot;left&quot; width=&quot;20&quot;&gt;3&lt;/td&gt;&lt;td valign=&quot;top&quot; align=&quot;left&quot; width=&quot;600&quot;&gt;Yttre måttkedjor i plan: närmast väggen öppningar, sedan väggavsnitt, ytterst totalmått.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign=&quot;top&quot; align=&quot;left&quot; width=&quot;20&quot;&gt;4&lt;/td&gt;&lt;td valign=&quot;top&quot; align=&quot;left&quot; width=&quot;600&quot;&gt;Måttet skrivs ovanför måttlinjen och läses nerifrån eller från höger.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign=&quot;top&quot; align=&quot;left&quot; width=&quot;20&quot;&gt;5&lt;/td&gt;&lt;td valign=&quot;top&quot; align=&quot;left&quot; width=&quot;600&quot;&gt;Ett mått redovisas en gång – dubbla mått som kan motsäga varandra undviks.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign=&quot;top&quot; align=&quot;left&quot; width=&quot;20&quot;&gt;6&lt;/td&gt;&lt;td valign=&quot;top&quot; align=&quot;left&quot; width=&quot;600&quot;&gt;Nivåer relateras till ±0 (färdigt golv i entréplan) och anges även i höjdsystemet om det finns (till exempel RH 2000).&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign=&quot;top&quot; align=&quot;left&quot; width=&quot;20&quot;&gt;7&lt;/td&gt;&lt;td valign=&quot;top&quot; align=&quot;left&quot; width=&quot;600&quot;&gt;c-mått (centrumavstånd) skrivs 'c600', 'c1200'.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign=&quot;top&quot; align=&quot;left&quot; width=&quot;20&quot;&gt;8&lt;/td&gt;&lt;td valign=&quot;top&quot; align=&quot;left&quot; width=&quot;600&quot;&gt;Handskrivna mått gäller före uppmätt ritningsskala (rmink: check_dimensions i workflow.py:211 flaggar avvikelser över 10 %).&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1"><mxGeometry x="876" y="771" width="636" height="188" as="geometry"/></mxCell><mxCell id="Pappersformat_10" value='&lt;b&gt;Pappersformat&lt;/b&gt;&lt;br&gt;&lt;font color="#333333"&gt;texthöjder 2,5, 3,5, 5, 7 mm&lt;/font&gt;&lt;table style="border-collapse:collapse;font-size:10px" cellpadding="1" cellspacing="0" border="0"&gt;&lt;tr style="font-weight:bold"&gt;&lt;td valign="top" align="left" width="40"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="120"&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="40"&gt;A0&lt;/td&gt;&lt;td valign="top" align="left" width="120"&gt;841×1189 mm&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="40"&gt;A1&lt;/td&gt;&lt;td valign="top" align="left" width="120"&gt;594×841 mm&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="40"&gt;A2&lt;/td&gt;&lt;td valign="top" align="left" width="120"&gt;420×594 mm&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="40"&gt;A3&lt;/td&gt;&lt;td valign="top" align="left" width="120"&gt;297×420 mm&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="40"&gt;A4&lt;/td&gt;&lt;td valign="top" align="left" width="120"&gt;210×297 mm&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1"><mxGeometry x="40" y="814" width="176" height="136" as="geometry"/></mxCell><mxCell id="Revisioner_11" value="&lt;b&gt;Revisioner&lt;/b&gt;&lt;br&gt;Revisionsbokstav A, B, C … för utgivna handlingar. Preliminära versioner kan numreras (rmink: r01, r02 …).&lt;br&gt;Ändringsmoln runt det som ändrats sedan förra revisionen.&lt;br&gt;En triangel med revisionsbokstaven vid molnet, som hänvisar till revisionstabellen.&lt;br&gt;Tabell: rev, ändringen avser, datum, sign&lt;br&gt;rmink: Drawing.revision = löpnummer (r03). ÄNDRINGAR i ritningshuvudet = revisionstabell. Annotation med status = ändringsmoln." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1"><mxGeometry x="40" y="966" width="620" height="124" as="geometry"/></mxCell><mxCell id="Skalor_12" value="&lt;b&gt;Skalor&lt;/b&gt;&lt;br&gt;1:1, 1:2, 1:5, 1:10, 1:20, 1:50, 1:100, 1:200, 1:400, 1:500, 1:1000&lt;br&gt;Ritningen anger alltid skalan i ritningshuvudet och vid varje vy med annan skala. På en skärm eller platta skrivs också 'mått gäller före skalning'." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1"><mxGeometry x="876" y="975" width="620" height="69" as="geometry"/></mxCell><mxCell id="Vad_rmink_ritar_i_dag_13" value='&lt;b&gt;Vad rmink ritar i dag&lt;/b&gt;&lt;br&gt;Har: namn, REV, skede, datum, "Mått i mm", förklaringar, anmärkningar med SVAR, ändringar, kategorier med linjetyp.&lt;br&gt;Saknas: skala, ritningsnummer, projekt, fastighet, upprättad/granskad, ritningstyp i modellen.' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1"><mxGeometry x="876" y="1060" width="620" height="69" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
