;fontSize=10;strokeColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="4_Tolka_11" target="5_rectify___kontroll_12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_22" value="bild + mätning" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;strokeColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="5_rectify___kontroll_12" target="6_Granska_bilden_13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_23" value="save_revision" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;strokeColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="6_Granska_bilden_13" target="7_build_revision_14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;strokeColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="7_build_revision_14" target="8_Spara_ritningen_15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_25" value="rmapi put / mv" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;strokeColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="7_build_revision_14" target="9_send_revision_16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_26" value="synk" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;strokeColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="9_send_revision_16" target="10_Markera_17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_27" value="nästa varv: bara nya streck" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;strokeColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;dashed=1;" parent="1" edge="1" source="10_Markera_17" target="2_Synk_9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Nästa_varv_28" value='&lt;b&gt;Nästa varv&lt;/b&gt;&lt;br&gt;rmink känner igen sina egna streck på deras CRDT-id (sketch.written_ids) och skickar bara användarens nya markeringar till Claude.&lt;br&gt;Öppna anmärkningar numreras; svar på SVAR-raden eller vid ring N besvarar anmärkning N.&lt;br&gt;Ändringar loggas som "r3: …" och visas under ÄNDRINGAR. Revisionen heter "&amp;lt;namn&amp;gt; r03 · 2 frågor" så länge frågor är öppna.' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1"><mxGeometry x="40" y="960" width="900" height="69" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
