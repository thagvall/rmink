<mxfile host="rmink" agent="docs/diagrams/build.py"><diagram id="03-skiss-till-ritning" name="3. Skiss → ritning: ett varv"><mxGraphModel dx="2030" dy="1069" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" background="#ffffff" pageWidth="2030" pageHeight="1069" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t_1" value="&lt;b&gt;3. Skiss → ritning: ett varv&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=22;fontColor=#000000;align=left;verticalAlign=top;spacing=2;" parent="1" vertex="1"><mxGeometry x="40" y="20" width="1400" height="34" as="geometry"/></mxCell><mxCell id="t_2" value="Från handritad skiss på plattan till renritad revision i samma mapp. Senare varv läser bara det användaren ritat sedan förra revisionen." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#333333;align=left;verticalAlign=top;spacing=2;" parent="1" vertex="1"><mxGeometry x="40" y="56" width="1400" height="22" as="geometry"/></mxCell><mxCell id="Platta_3" value="Platta" style="swimlane;html=1;whiteSpace=wrap;startSize=28;fillColor=#f5f5f5;strokeColor=#333333;fontFamily=Helvetica;fontSize=13;fontStyle=1;swimlaneFillColor=#ffffff;rounded=1;arcSize=2;collapsible=0;" parent="1" vertex="1"><mxGeometry x="40" y="100" width="1950" height="162" as="geometry"/></mxCell><mxCell id="reMarkable_Cloud_4" value="reMarkable Cloud" style="swimlane;html=1;whiteSpace=wrap;startSize=28;fillColor=#eeeeee;strokeColor=#666666;fontFamily=Helvetica;fontSize=13;fontStyle=1;swimlaneFillColor=#ffffff;rounded=1;arcSize=2;collapsible=0;" parent="1" vertex="1"><mxGeometry x="40" y="270" width="1950" height="162" as="geometry"/></mxCell><mxCell id="rmink_5" value="rmink" style="swimlane;html=1;whiteSpace=wrap;startSize=28;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=13;fontStyle=1;swimlaneFillColor=#ffffff;rounded=1;arcSize=2;collapsible=0;" parent="1" ver