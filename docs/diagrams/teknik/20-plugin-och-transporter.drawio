_tools_2_43"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_46" value="kod" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;strokeColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="c_7" target="rmink_transports_0_16"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="724" y="196"/><mxPoint x="724" y="158"/></Array></mxGeometry></mxCell><mxCell id="e_47" value="TOML-lager" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;strokeColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="c_8" target="rmink_packs_0_21"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="752" y="403"/><mxPoint x="752" y="234"/></Array></mxGeometry></mxCell><mxCell id="e_48" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;strokeColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="c_7" target="rmink_importers_0_26"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="724" y="196"/><mxPoint x="724" y="310"/></Array></mxGeometry></mxCell><mxCell id="e_49" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;strokeColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="c_7" target="rmink_exporters_0_31"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="724" y="196"/><mxPoint x="724" y="380"/></Array></mxGeometry></mxCell><mxCell id="e_50" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;strokeColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="c_7" target="rmink_commands_0_36"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="724" y="196"/><mxPoint x="724" y="449"/></Array></mxGeometry></mxCell><mxCell id="e_51" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;strokeColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="c_7" target="rmink_mcp_tools_0_41"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="724" y="196"/><mxPoint x="724" y="518"/></Array></mxGeometry></mxCell><mxCell id="Regler_för_alla_plugin_52" value="&lt;b&gt;Regler för alla plugin&lt;/b&gt;&lt;br&gt;Inbyggda namn står kvar: ett plugin kan inte ersätta cloud, usb, folder, .pdf, exporten pdf eller rmink convert.&lt;br&gt;Undantaget är paketdata: där ersätter samma id med flit.&lt;br&gt;API_VERSION 1 täcker grupperna, de sex transportanropen, paketmappens upplägg och signaturerna för format in och ut.&lt;br&gt;Allt annat i rmink.* är internt och kan ändras mellan versioner." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1"><mxGeometry x="40" y="566" width="640" height="111" as="geometry"/></mxCell><mxCell id="Vad_ett_innehållspaket_kan_innehålla_53" value="&lt;b&gt;Vad ett innehållspaket kan innehålla&lt;/b&gt;&lt;br&gt;knowledge/: terms, drawing_standard, symbols, materials, assemblies, rules, markup, hatches, process&lt;br&gt;En post behöver alla fält som rmink:s egna poster i samma tabell har, och det den pekar på måste finnas.&lt;br&gt;En symbol med paths (polylinjer i enhetsrutan −0,5..0,5) ritas som en inbyggd: på sidan, i förklaringen och som SVG.&lt;br&gt;workbook/: [[group]] med [[group.topic]], som i skola.toml.&lt;br&gt;rmink plugins check MAPP säger vad som saknas." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1"><mxGeometry x="720" y="566" width="700" height="111" as="geometry"/></mxCell><mxCell id="t_54" value="&lt;b&gt;B. Transporter: var anteckningsböcker lämnas och hämtas&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=15;fontColor=#000000;align=left;verticalAlign=top;spacing=2;" parent="1" vertex="1"><mxGeometry x="40" y="737" width="900" height="24" as="geometry"/></mxCell><mxCell id="c_55" value="&lt;b&gt;Den som skickar och hämtar&lt;/b&gt;&lt;br&gt;ritningsvarv (drawing/workflow.py)&lt;br&gt;arbetsböcker (workbook/workflow.py)&lt;br&gt;ark: rmink sheet send | pull&lt;br&gt;MCP: save_revision, read_sketch, files_list&lt;br&gt;rmink transport ls | get | put" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1"><mxGeometry x="40" y="925" width="270" height="150" as="geometry"/></mxCell><mxCell id="c_56" value="&lt;b&gt;Vilken transport?&lt;/b&gt;&lt;br&gt;1 --via eller $RMINK_TRANSPORT&lt;br&gt;2 rmink transport use → config.toml&lt;br&gt;3 molnet, om rmink cloud connect är gjort&lt;br&gt;annars: felet säger hur man väljer en" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1"><mxGeometry x="370" y="925" width="270" height="150" as="geometry"/></mxCell><mxCell id="c_57" value="&lt;b&gt;Transport: sex anrop&lt;/b&gt;&lt;br&gt;ls: mappar och anteckningsböcker i en mapp&lt;br&gt;get: en anteckningsbok som .rmdoc&lt;br&gt;put: lämna en .rmdoc; upptaget namn blir namn_2&lt;br&gt;mkdir: gör en mapp; finns den redan är det bra&lt;br&gt;mv: flytta bok eller mapp; ExistsError om namnet är taget&lt;br&gt;rmdir: ta bort en tom mapp" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1"><mxGeometry x="700" y="925" width="330" height="150" as="geometry"/></mxCell><mxCell id="e_58" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;strokeColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="c_55" target="c_56"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_59" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;strokeColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="c_56" target="c_57"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c_60" value="&lt;b&gt;reMarkable-plattan&lt;/b&gt;&lt;br&gt;skriv, rita, kryssa&lt;br&gt;lägg tillbaka samma namn" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333333;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1"><mxGeometry x="1830" y="954" width="190" height="92" as="geometry"/></mxCell><mxCell id="cloud__CloudTransport_61" value="&lt;b&gt;cloud: CloudTransport&lt;/b&gt;&lt;br&gt;inbyggd, kör rmapi&lt;br&gt;samma kod som förut" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1"><mxGeometry x="1100" y="777" width="250" height="92" as="geometry"/></mxCell><mxCell id="reMarkable_Cloud_62" value="&lt;b&gt;reMarkable Cloud&lt;/b&gt;&lt;br&gt;kräver prenumeration&lt;br&gt;synkar själv till plattan" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#666666;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1"><mxGeometry x="1400" y="777" width="270" height="92" as="geometry"/></mxCell><mxCell id="e_63" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;strokeColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="c_57" target="cloud__CloudTransport_61"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_64" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;strokeColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="cloud__CloudTransport_61" target="reMarkable_Cloud_62"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_65" value="synk" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;strokeColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="reMarkable_Cloud_62" target="c_60"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="usb__UsbTransport_66" value="&lt;b&gt;usb: UsbTransport&lt;/b&gt;&lt;br&gt;inbyggd, ingen prenumeration&lt;br&gt;plattans USB-gränssnitt, 10.11.99.1&lt;br&gt;kan inte göra eller flytta mappar" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1"><mxGeometry x="1100" y="895" width="250" height="92" as="geometry"/></mxCell><mxCell id="Kabeln_till_plattan_67" value="&lt;b&gt;Kabeln till plattan&lt;/b&gt;&lt;br&gt;lista, hämta .rmdoc, ladda upp&lt;br&gt;mapparna görs för hand på plattan" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333333;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1"><mxGeometry x="1400" y="895" width="270" height="92" as="geometry"/></mxCell><mxCell id="e_68" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;strokeColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="c_57" target="usb__UsbTransport_66"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_69" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;strokeColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="usb__UsbTransport_66" target="Kabeln_till_plattan_67"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_70" value="direkt" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;strokeColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="Kabeln_till_plattan_67" target="c_60"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="folder_MAPP__FolderTransport_71" value="&lt;b&gt;folder:MAPP: FolderTransport&lt;/b&gt;&lt;br&gt;inbyggd, ingen prenumeration&lt;br&gt;/rmink/Bygg/Altan/Altan r02 =&lt;br&gt;MAPP/rmink/Bygg/Altan/Altan r02.rmdoc" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1"><mxGeometry x="1100" y="1013" width="250" height="92" as="geometry"/></mxCell><mxCell id="En_mapp_på_datorn_72" value="&lt;b&gt;En mapp på datorn&lt;/b&gt;&lt;br&gt;överlämningspunkt: rmink når inte plattan&lt;br&gt;användaren bär filerna: USB, synk, egen server" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1"><mxGeometry x="1400" y="1013" width="270" height="92" as="geometry"/></mxCell><mxCell id="e_73" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;strokeColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="c_57" target="folder_MAPP__FolderTransport_71"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_74" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;strokeColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="folder_MAPP__FolderTransport_71" target="En_mapp_på_datorn_72"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_75" value="bärs för hand" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;strokeColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="En_mapp_på_datorn_72" target="c_60"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="namn_arg__från_ett_plugin_76" value="&lt;b&gt;namn:arg: från ett plugin&lt;/b&gt;&lt;br&gt;exemplet: zip:FIL&lt;br&gt;hela trädet i en zip-fil" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1"><mxGeometry x="1100" y="1131" width="250" height="92" as="geometry"/></mxCell><mxCell id="Det_pluginet_talar_med_77" value="&lt;b&gt;Det pluginet talar med&lt;/b&gt;&lt;br&gt;en fil, en server, ett annat moln" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1"><mxGeometry x="1400" y="1131" width="270" height="92" as="geometry"/></mxCell><mxCell id="e_78" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;strokeColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="c_57" target="namn_arg__från_ett_plugin_76"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_79" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;strokeColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="namn_arg__från_ett_plugin_76" target="Det_pluginet_talar_med_77"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_80" value="pluginets sätt" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;strokeColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="Det_pluginet_talar_med_77" target="c_60"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Vad_en_transport_måste_hålla_81" value="&lt;b&gt;Vad en transport måste hålla&lt;/b&gt;&lt;br&gt;put skriver aldrig över: den svarar med namnet den använde. ls av en mapp som saknas ger NotFoundError, och då gör rmink mapparna en i taget.&lt;br&gt;Fel är TransportError med ett meddelande som går att visa. En transport får filerna, aldrig användarens reMarkable-token.&lt;br&gt;Den hostade webbappen skickar bara via molnet; transporter gäller CLI och MCP på den egna datorn." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1"><mxGeometry x="40" y="1259" width="990" height="69" as="geometry"/></mxCell><mxCell id="t_82" value="&lt;b&gt;C. Exempel&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=15;fontColor=#000000;align=left;verticalAlign=top;spacing=2;" parent="1" vertex="1"><mxGeometry x="40" y="1388" width="900" height="24" as="geometry"/></mxCell><mxCell id="t_83" value="&lt;b&gt;1. Utan moln: ett ark ut och tillbaka över kabeln&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#000000;align=left;verticalAlign=top;spacing=2;" parent="1" vertex="1"><mxGeometry x="40" y="1428" width="900" height="20" as="geometry"/></mxCell><mxCell id="Välj_kabeln_84" value="&lt;b&gt;Välj kabeln&lt;/b&gt;&lt;br&gt;rmink transport use usb&lt;br&gt;gör mappen rmink/Ark på plattan" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1"><mxGeometry x="40" y="1454" width="300" height="55" as="geometry"/></mxCell><mxCell id="Skicka_arket_85" value="&lt;b&gt;Skicka arket&lt;/b&gt;&lt;br&gt;rmink sheet send ritning.pdf --send&lt;br&gt;→ rmink/Ark/ritning på plattan" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1"><mxGeometry x="390" y="1454" width="300" height="55" as="geometry"/></mxCell><mxCell id="e_86" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;strokeColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="Välj_kabeln_84" target="Skicka_arket_85"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Skriv_på_plattan_87" value="&lt;b&gt;Skriv på plattan&lt;/b&gt;&lt;br&gt;mät, kryssa, anteckna&lt;br&gt;låt kabeln sitta i" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#333333;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1"><mxGeometry x="740" y="1454" width="300" height="55" as="geometry"/></mxCell><mxCell id="e_88" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;strokeColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="Skicka_arket_85" target="Skriv_på_plattan_87"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Hämta_bläcket_89" value="&lt;b&gt;Hämta bläcket&lt;/b&gt;&lt;br&gt;rmink sheet pull /rmink/Ark/ritning ritning.pdf" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1"><mxGeometry x="1090" y="1454" width="300" height="55" as="geometry"/></mxCell><mxCell id="e_90" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;strokeColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1"