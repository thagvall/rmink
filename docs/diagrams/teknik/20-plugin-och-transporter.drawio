<mxfile host="rmink" agent="docs/diagrams/build.py"><diagram id="20-plugin-och-transporter" name="20. Plugin, innehållspaket och transporter"><mxGraphModel dx="2060" dy="2036" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" background="#ffffff" pageWidth="2060" pageHeight="2036" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t_1" value="&lt;b&gt;20. Plugin, innehållspaket och transporter&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=22;fontColor=#000000;align=left;verticalAlign=top;spacing=2;" parent="1" vertex="1"><mxGeometry x="40" y="20" width="1400" height="34" as="geometry"/></mxCell><mxCell id="t_2" value="Andra paket tar med sig delar till rmink genom entry points. Inget importeras förrän det används, och en transport avgör var anteckningsböcker lämnas och hämtas." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#333333;align=left;verticalAlign=top;spacing=2;" parent="1" vertex="1"><mxGeometry x="40" y="56" width="1400" height="22" as="geometry"/></mxCell><mxCell id="t_3" value="&lt;b&gt;A. Delarna och var de fäster&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=15;fontColor=#000000;align=left;verticalAlign=top;spacing=2;" parent="1" vertex="1"><mxGeometry x="40" y="92" width="900" height="24" as="geometry"/></mxCell><mxCell id="c_4" value='&lt;b&gt;pip-paket: rmink-&amp;lt;namn&amp;gt;&lt;/b&gt;&lt;br&gt;pyproject.toml:&lt;br&gt;[project.entry-points."rmink.transports"]&lt;br&gt;webdav = "rmink_webdav:open"&lt;br&gt;kod som körs med användarens rättigheter' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1"><mxGeometry x="40" y="130" width="290" height="118" as="geometry"/></mxCell><mxCell id="c_5" value="&lt;b&gt;Paketmapp, ingen kod&lt;/b&gt;&lt;br&gt;~/.config/rmink/packs/&amp;lt;namn&amp;gt;/&lt;br&gt;pack.toml, knowledge/*.toml, workbook/*.toml" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1"><mxGeometry x="40" y="288" width="290" height="92" as="geometry"/></mxCell><mxCell id="c_6" value="&lt;b&gt;Egna filer&lt;/b&gt;&lt;br&gt;~/.config/rmink/knowledge/*.toml&lt;br&gt;~/.config/rmink/workbook/*.toml&lt;br&gt;läses sist, över allt annat" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1"><mxGeometry x="40" y="420" width="290" height="92" as="geometry"/></mxCell><mxCell id="c_7" value="&lt;b&gt;plugins.py: upptäckt&lt;/b&gt;&lt;br&gt;found(grupp): listar, importerar inte&lt;br&gt;load(grupp, namn): importerar vid behov&lt;br&gt;API_VERSION = 1&lt;br&gt;trasigt plugin → varning, hoppas över&lt;br&gt;RMINK_NO_PLUGINS=1 stänger av" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1"><mxGeometry x="400" y="130" width="280" height="132" as="geometry"/></mxCell><mxCell id="c_8" value="&lt;b&gt;packs.py: lager på lager&lt;/b&gt;&lt;br&gt;1 det rmink har inbyggt&lt;br&gt;2 paket från plugin&lt;br&gt;3 paketmappar&lt;br&gt;4 egna filer&lt;br&gt;samma id ersätter, annat läggs till&lt;br&gt;en post med fel utelämnas med varning" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1"><mxGeometry x="400" y="328" width="280" height="150" as="geometry"/></mxCell><mxCell id="e_9" value="entry points" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;strokeColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="c_4" target="c_7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_10" value="rmink.packs" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;strokeColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" edge="1" source="c_7" target="c_8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;strokeColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.35;entryDx=0;entryDy=0;" parent="1" edge="1" source="c_5" target="c_8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;strokeColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;" parent="1" edge="1" source="c_6" target="c_8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="t_13" value="&lt;b&gt;Delen ett plugin tar med sig&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#000000;align=left;verticalAlign=top;spacing=2;" parent="1" vertex="1"><mxGeometry x="780" y="106" width="300" height="20" as="geometry"/></mxCell><mxCell id="t_14" value="&lt;b&gt;Här frågar rmink efter den&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#000000;align=left;verticalAlign=top;spacing=2;" parent="1" vertex="1"><mxGeometry x="1126" y="106" width="290" height="20" as="geometry"/></mxCell><mxCell id="t_15" value="&lt;b&gt;Här möter användaren den&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#000000;align=left;verticalAlign=top;spacing=2;" parent="1" vertex="1"><mxGeometry x="1462" y="106" width="330" height="20" as="geometry"/></mxCell><mxCell id="rmink_transports_0_16" value="&lt;b&gt;Transport: rmink.transports&lt;/b&gt;&lt;br&gt;fabrik(arg) → objekt med de sex anropen&lt;br&gt;namn = schemat i namn:arg" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1"><mxGeometry x="780" y="130" width="300" height="55" as="geometry"/></mxCell><mxCell id="rmink_transports_1_17" value="transport.open()&lt;br&gt;src/rmink/transport/" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1"><mxGeometry x="1126" y="130" width="290" height="55" as="geometry"/></mxCell><mxCell id="rmink_transports_2_18" value="--via namn:arg, rmink transport use&lt;br&gt;varv, arbetsböcker och ark skickas och hämtas där" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1"><mxGeometry x="1462" y="130" width="330" height="55" as="geometry"/></mxCell><mxCell id="e_19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;strokeColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="rmink_transports_0_16" target="rmink_transports_1_17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;strokeColor=#333333;endArrow=b