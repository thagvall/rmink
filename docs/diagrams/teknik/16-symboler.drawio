okeColor=#d6b656;fontFamily=Helvetica;fontSize=13;fontStyle=1;swimlaneFillColor=#ffffff;rounded=1;arcSize=2;collapsible=0;" parent="1" vertex="1"><mxGeometry x="40" y="2054" width="1740" height="162" as="geometry"/></mxCell><mxCell id="revision_74" value="" style="shape=image;html=1;verticalAlign=top;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" parent="disc_rev_73" vertex="1"><mxGeometry x="10" y="38" width="64" height="64" as="geometry"/></mxCell><mxCell id="revision_t_75" value="&lt;b&gt;Revisionsmärke&lt;/b&gt;&lt;br&gt;id revision · etikett A&lt;br&gt;Pekar ut det som ändrats i en revision. Bokstaven i triangeln är samma som i revisionsraden i ritningshuvudet.&lt;br&gt;handskrivet: rev, revision, rev A, revisionstriangel, ändring&lt;br&gt;regler: rmink-ritningshuvud" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontFamily=Helvetica;fontSize=10;align=left;verticalAlign=top;spacing=6;" parent="disc_rev_73" vertex="1"><mxGeometry x="82" y="34" width="346" height="112" as="geometry"/></mxCell><mxCell id="revision_cloud_76" value="" style="shape=image;html=1;verticalAlign=top;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" parent="disc_rev_73" vertex="1"><mxGeometry x="440" y="38" width="64" height="64" as="geometry"/></mxCell><mxCell id="revision_cloud_t_77" value="&lt;b&gt;Revisionsmoln&lt;/b&gt;&lt;br&gt;id revision_cloud · etikett –&lt;br&gt;Ringar in det område som ändrats, tillsammans med revisionsmärket.&lt;br&gt;handskrivet: moln, revisionsmoln, ändringsmoln&lt;br&gt;regler: –" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontFamily=Helvetica;fontSize=10;align=left;verticalAlign=top;spacing=6;" parent="disc_rev_73" vertex="1"><mxGeometry x="512" y="34" width="346" height="112" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
