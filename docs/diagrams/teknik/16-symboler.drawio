<mxfile host="rmink" agent="docs/diagrams/build.py"><diagram id="16-symboler" name="16. Symboler (33 st)"><mxGraphModel dx="1820" dy="2256" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" background="#ffffff" pageWidth="1820" pageHeight="2256" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t_1" value="&lt;b&gt;16. Symboler (33 st)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=22;fontColor=#000000;align=left;verticalAlign=top;spacing=2;" parent="1" vertex="1"><mxGeometry x="40" y="20" width="1400" height="34" as="geometry"/></mxCell><mxCell id="t_2" value="Ritade med rmink:s egen geometri (drawing/symbols.py), som på plattan. Etikett = standardtext vid symbolen; handskrivet = det Claude känner igen i skissen." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#333333;align=left;verticalAlign=top;spacing=2;" parent="1" vertex="1"><mxGeometry x="40" y="56" width="1400" height="22" as="geometry"/></mxCell><mxCell id="disc_allm_3" value="Orientering och allmänt (6)" style="swimlane;html=1;whiteSpace=wrap;startSize=28;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=13;fontStyle=1;swimlaneFillColor=#ffffff;rounded=1;arcSize=2;collapsible=0;" parent="1" vertex="1"><mxGeometry x="40" y="110" width="1740" height="284" as="geometry"/></mxCell><mxCell id="north_4" value="" style="shape=image;html=1;verticalAlign=top;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" parent="disc_allm_3" vertex="1"><mxGeometry x="10" y="38" width="64" height="64" as="geometry"/></mxCell><mxCell id="north_t_5" value="&lt;b&gt;Norrpil&lt;/b&gt;&lt;br&gt;id north · etikett N&lt;br&gt;Visar norr, så att väderstreck, solinstrålning och fasadnamn kan läsas av.&lt;br&gt;handskrivet: N-pil, nordpil, N, väderstreck&lt;br&gt;regler: rmink-norrpil" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontFamily=Helvetica;fontSize=10;align=left;verticalAlign=top;spacing=6;" parent="disc_allm_3" vertex="1"><mxGeometry x="82" y="34" width="346" height="112" as="geometry"/></mxCell><mxCell id="section_6" value="" style="shape=image;html=1;verticalAlign=top;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" parent="disc_allm_3" vertex="1"><mxGeometry x="440" y="38" width="64" height="64" as="geometry"/></mxCell><mxCell id="section_t_7" value="&lt;b&gt;Snitt&lt;/b&gt;&lt;br&gt;id section · etikett A&lt;br&gt;Var en sektion är tagen och åt vilket håll den ses. Samma beteckning står på sektionsritningen.&lt;br&gt;handskrivet: sektion, sektionsmarkering, snittmarkering, A-A, B-B&lt;br&gt;regler: rmink-sektionsmarkering" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontFamily=Helvetica;fontSize=10;align=left;verticalAlign=top;spacing=6;" parent="disc_allm_3" vertex="1"><mxGeometry x="512" y="34" width="346" height="112" as="geometry"/></mxCell><mxCell id="level_8" value="" style="shape=image;html=1;verticalAlign=top;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" parent="disc_allm_3" vertex="1"><mxGeometry x="870" y="38" width="64" height="64" as="geometry"/></mxCell><mxCell id="level_t_9" value="&lt;b&gt;Nivå&lt;/b&gt;&lt;br&gt;id level · etikett +0,00&lt;br&gt;En höjd: färdigt golv, överkant, underkant eller mark, räknad från nollpunkten ±0 eller i höjdsystemet.&lt;br&gt;handskrivet: nivå, höjd, nivåmärke, ±0, +0, FG, ÖK, UK, ▽&lt;br&gt;regler: rmink-niva-nollpunkt" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontFamily=Helvetica;fontSize=10;align=left;verticalAlign=top;spacing=6;" parent="disc_allm_3" vertex="1"><mxGeometry x="942" y="34" width="346" height="112" as="geometry"/></mxCell><mxCell id="detail_10" value="" style="shape=image;html=1;verticalAlign=top;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" parent="disc_allm_3" vertex="1"><mxGeometry x="1300" y="38" width="64" height="64" as="geometry"/></mxCell><mxCell id="detail_t_11" value="&lt;b&gt;Detaljhänvisning&lt;/b&gt;&lt;br&gt;id detail · etikett 1/A-03&lt;br&gt;Hänvisar till en detaljritning: detaljnumret överst, bladet eller ritningsnumret under strecket.&lt;br&gt;handskrivet: detalj, detaljmarkering, hänvisning, se detalj&lt;br&gt;regler: –" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontFamily=Helvetica;fontSize=10;align=left;verticalAlign=top;spacing=6;" parent="disc_allm_3" vertex="1"><mxGeometry x="1372" y="34" width="346" height="112" as="geometry"/></mxCell><mxCell id="cross_12" value="" style="shape=image;html=1;verticalAlign=top;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" parent="disc_allm_3" vertex="1"><mxGeometry x="10" y="160" width="64" height="64" as="geometry"/></mxCell><mxCell id="cross_t_13" value="&lt;b&gt;Kryss&lt;/b&gt;&lt;br&gt;id cross · etikett –&lt;br&gt;Något som rivs eller utgår, eller en markerad punkt. Förklaras alltid i FÖRKLARINGAR, eftersom krysset kan be…&lt;br&gt;handskrivet: X, rivs, utgår&lt;br&gt;regler: rmink-forklaring" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontFamily=Helvetica;fontSize=10;align=left;verticalAlign=top;spacing=6;" parent="disc_allm_3" vertex="1"><mxGeometry x="82" y="156" width="346" height="112" as="geometry"/></mxCell><mxCell id="slope_14" value="" style="shape=image;html=1;verticalAlign=top;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" parent="disc_allm_3" vertex="1"><mxGeometry x="440" y="160" width="64" height="64" as="geometry"/></mxCell><mxCell id="slope_t_15" value="&lt;b&gt;Fallriktning&lt;/b&gt;&lt;br&gt;id slope · etikett 1:50&lt;br&gt;Åt vilket håll ytan lutar: golv mot brunn, altan och mark bort från huset, tak mot hängränna. Lutningen skriv…&lt;br&gt;handskrivet: fall, lutning, fallpil, 1:50, 1:100&lt;br&gt;regler: praxis-vatrum-branschregler" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontFamily=Helvetica;fontSize=10;align=left;verticalAlign=top;spacing=6;" parent="disc_allm_3" vertex="1"><mxGeometry x="512" y="156" width="346" height="112" as="geometry"/></mxCell><mxCell id="disc_A_16" value="A Arkitekt (6)" style="swimlane;html=1;whiteSpace=wrap;startSize=28;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=13;fontStyle=1;swimlaneFillColor=#ffffff;rounded=1;arcSize=2;collapsible=0;" parent="1" vertex="1"><mxGeometry x="40" y="414" width="1740" height="284" as="geometry"/></mxCell><mxCell id="door_17" value="" style="shape=image;html=1;verticalAlign=top;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" parent="disc_A_16" vertex="1"><mxGeometry x="10" y="38" width="64" height="64" as="geometry"/></mxCell><mxCell id="door_t_18" value="&lt;b&gt;Dörr&lt;/b&gt;&lt;br&gt;id door · etikett 10x21&lt;br&gt;Dörr med blad och slagbåge, som visar åt vilket håll den öppnas. Måttet är karmyttermått i moduler, t.ex. 10 …&lt;br&gt;handskrivet: dörr, D, slagbåge, ytterdörr, innerdörr, M10, 10x21&lt;br&gt;regler: bfs9-fri-hojd, bfs12-entre-smahus" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontFamily=Helvetica;fontSize=10;align=left;verticalAlign=top;spacing=6;" parent="disc_A_16" vertex="1"><mxGeometry x="82" y="34" width="346" height="112" as="geometry"/></mxCell><mxCell id="window_19" value="" style="shape=image;html=1;verticalAlign=top;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" parent="disc_A_16" vertex="1"><mxGeometry x="440" y="38" width="64" height="64" as="geometry"/></mxCell><mxCell id="window_t_20" value="&lt;b&gt;Fönster&lt;/b&gt;&lt;br&gt;id window · etikett 12x12&lt;br&gt;Fönster i väggen, med tre parallella streck i plan. Måttet är karmyttermått i moduler, t.ex. 12x12.&lt;br&gt;handskrivet: fönster, F, fönsterparti, 12x12&lt;br&gt;regler: bfs9-fonster-barn, bfs8-dagsljus" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontFamily=Helvetica;fontSize=10;align=left;verticalAlign=top;spacing=6;" parent="disc_A_16" vertex="1"><mxGeometry x="512" y="34" width="346" height="112" as="geometry"/></mxCell><mxCell id="stair_21" value="" style="shape=image;html=1;verticalAlign=top;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" parent="disc_A_16" vertex="1"><mxGeometry x="870" y="38" width="64" height="64" as="geometry"/></mxCell><mxCell id="stair_t_22" value="&lt;b&gt;Trappa, gångriktning&lt;/b&gt;&lt;br&gt;id stair · etikett UPP&lt;br&gt;Gångriktningen upp i en trappa: en prick där pilen börjar och pilen mot det övre planet. Antal steg och stegm…&lt;br&gt;handskrivet: trappa, upp, ned, gångriktning, trappil&lt;br&gt;regler: bfs9-ledstang, praxis-trappa-stegmatt, bfs9-plan-dorr-trappa" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontFamily=Helvetica;fontSize=10;align=left;verticalAlign=top;spacing=6;" parent="disc_A_16" vertex="1"><mxGeometry x="942" y="34" width="346" height="112" as="geometry"/></mxCell><mxCell id="railing_23" value="" style="shape=image;html=1;verticalAlign=top;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" parent="disc_A_16" vertex="1"><mxGeometry x="1300" y="38" width="64" height="64" as="geometry"/></mxCell><mxCell id="railing_t_24" value="&lt;b&gt;Räcke&lt;/b&gt;&lt;br&gt;id railing · etikett H 1100&lt;br&gt;Räcke eller skyddsräcke, med höjd och avstånd mellan spjälorna i text eller på en detalj.&lt;br&gt;handskrivet: räcke, skyddsräcke, staket, ledstång, spjälräcke&lt;br&gt;regler: bfs9-skydd-mot-fall, bfs9-racke-barn, praxis-racke-hojd" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontFamily=Helvetica;fontSize=10;align=left;verticalAlign=top;spacing=6;" parent="disc_A_16" vertex="1"><mxGeometry x="1372" y="34" width="346" height="112" as="geometry"/></mxCell><mxCell id="stove_25" value="" style="shape=image;html=1;verticalAlign=top;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" parent="disc_A_16" vertex="1"><mxGeometry x="10" y="160" width="64" height="64" as="geometry"/></mxCell><mxCell id="stove_t_26" value="&lt;b&gt;Spis&lt;/b&gt;&lt;br&gt;id stove · etikett –&lt;br&gt;Spis eller häll, med fyra plattor.&lt;br&gt;handskrivet: spis, häll, induktion, spishäll&lt;br&gt;regler: –" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontFamily=Helvetica;fontSize=10;align=left;verticalAlign=top;spacing=6;" parent="disc_A_16" vertex="1"><mxGeometry x="82" y="156" width="346" height="112" as="geometry"/></mxCell><mxCell id="fridge_27" value="" style="shape=image;html=1;verticalAlign=top;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" parent="disc_A_16" vertex="1"><mxGeometry x="440" y="160" width="64" height="64" as="geometry"/></mxCell><mxCell id="fridge_t_28" value="&lt;b&gt;Kylskåp&lt;/b&gt;&lt;br&gt;id fridge · etikett KY&lt;br&gt;Kylskåp eller frys, ofta med KY eller FR.&lt;br&gt;handskrivet: kyl, kylskåp, KY, frys, FR, kyl/frys&lt;br&gt;regler: –" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontFamily=Helvetica;fontSize=10;align=left;verticalAlign=top;spacing=6;" parent="disc_A_16" vertex="1"><mxGeometry x="512" y="156" width="346" height="112" as="geometry"/></mxCell><mxCell id="disc_K_29" value="K Konstruktion (4)" style="swimlane;html=1;whiteSpace=wrap;startSize=28;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=13;fontStyle=1;swimlaneFillColor=#ffffff;rounded=1;arcSize=2;collapsible=0;" parent="1" vertex="1"><mxGeometry x="40" y="718" width="1740" height="162" as="geometry"/></mxCell><mxCell id="column_30" value="" style="shape=image;html=1;verticalAlign=top;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" parent="disc_K_29" vertex="1"><mxGeometry x="10" y="38" width="64" height="64" as="geometry"/></mxCell><mxCell id="column_t_31" value="&lt;b&gt;Pelare&lt;/b&gt;&lt;br&gt;id column · etikett 90x90&lt;br&gt;Bärande pelare eller stolpe i plan. Material och dimension skrivs vid den, t.ex. 90x90 C24 eller KKR 80x80.&lt;br&gt;handskrivet: stolpe, pelare, P, KKR, VKR&lt;br&gt;regler: rmink-dimension-saknas" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontFamily=Helvetica;fontSize=10;align=left;verticalAlign=top;spacing=6;" parent="disc_K_29" vertex="1"><mxGeometry x="82" y="34" width="346" height="112" as="geometry"/></mxCell><mxCell id="pier_32" value="" style="shape=image;html=1;verticalAlign=top;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" parent="disc_K_29" vertex="1"><mxGeometry x="440" y="38" width="64" height="64" as="geometry"/></mxCell><mxCell id="pier_t_33" value="&lt;b&gt;Plint&lt;/b&gt;&lt;br&gt;id pier · etikett 200x200&lt;br&gt;Plint i grundplan, oftast under altan eller förråd. Typ, storlek och c-avstånd anges, liksom att den står på …&lt;br&gt;handskrivet: plint, plintar, betongplint, markskruv, plintsko&lt;br&gt;regler: praxis-frostfritt" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontFamily=Helvetica;fontSize=10;align=left;verticalAlign=top;spacing=6;" parent="disc_K_29" vertex="1"><mxGeometry x="512" y="34" width="346" height="112" as="geometry"/></mxCell><mxCell id="bolt_34" value="" style="shape=image;html=1;verticalAlign=top;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" parent="disc_K_29" vertex="1"><mxGeometry x="870" y="38" width="64" height="64" as="geometry"/></mxCell><mxCell id="bolt_t_35" value="&lt;b&gt;Bult&lt;/b&gt;&lt;br&gt;id bolt · etikett M12&lt;br&gt;Bult eller genomgående skruv i ett förband. Dimension och korrosivitetsklass anges, t.ex. M12 FZV.&lt;br&gt;handskrivet: bult, M10, M12, M16, genomgående&lt;br&gt;regler: praxis-infastning-korrosion" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontFamily=Helvetica;fontSize=10;align=left;verticalAlign=top;spacing=6;" parent="disc_K_29" vertex="1"><mxGeometry x="942" y="34" width="346" height="112" as="geometry"/></mxCell><mxCell id="weld_36" value="" style="shape=image;html=1;verticalAlign=top;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" parent="disc_K_29" vertex="1"><mxGeometry x="1300" y="38" width="64" height="64" as="geometry"/></mxCell><mxCell id="weld_t_37" value="&lt;b&gt;Svets&lt;/b&gt;&lt;br&gt;id weld · etikett a4&lt;br&gt;Svetsfog på stål. a-måttet och fogens längd skrivs vid symbolen.&lt;br&gt;handskrivet: svets, kälsvets, a-mått&lt;br&gt;regler: –" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontFamily=Helvetica;fontSize=10;align=left;verticalAlign=top;spacing=6;" parent="disc_K_29" vertex="1"><mxGeometry x="1372" y="34" width="346" height="112" as="geometry"/></mxCell><mxCell id="disc_E_38" value="E El (5)" style="swimlane;html=1;whiteSpace=wrap;startSize=28;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=13;fontStyle=1;swimlaneFillColor=#ffffff;rounded=1;arcSize=2;collapsible=0;" parent="1" vertex="1"><mxGeometry x="40" y="900" width="1740" height="284" as="geometry"/></mxCell><mxCell id="panel_39" value="" style="shape=image;html=1;verticalAlign=top;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" parent="disc_E_38" vertex="1"><mxGeometry x="10" y="38" width="64" height="64" as="geometry"/></mxCell><mxCell id="panel_t_40" value="&lt;b&gt;Elcentral&lt;/b&gt;&lt;br&gt;id panel · etikett C&lt;br&gt;Elcentral eller gruppcentral. Placeringen avgör kabeldragningen; arbetet görs av behörig.&lt;br&gt;handskrivet: central, elcentral, proppskåp, gruppcentral, C&lt;br&gt;regler: elsl-behorighet" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontFamily=Helvetica;fontSize=10;align=left;verticalAlign=top;spacing=6;" parent="disc_E_38" vertex="1"><mxGeometry x="82" y="34" width="346" height="112" as="geometry"/></mxCell><mxCell id="outlet_41" value="" style="shape=image;html=1;verticalAlign=top;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" parent="disc_E_38" vertex="1"><mxGeometry x="440" y="38" width="64" height="64" as="geometry"/></mxCell><mxCell id="outlet_t_42" value="&lt;b&gt;Eluttag&lt;/b&gt;&lt;br&gt;id outlet · etikett –&lt;br&gt;Vägguttag, enkelt. Höjd över golv anges om den avviker från normal höjd.&lt;br&gt;handskrivet: uttag, vägguttag, eluttag, jordat uttag&lt;br&gt;regler: elsl-behorighet" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontFamily=Helvetica;fontSize=10;align=left;verticalAlign=top;spacing=6;" parent="disc_E_38" vertex="1"><mxGeometry x="512" y="34" width="346" height="112" as="geometry"/></mxCell><mxCell id="outlet_double_43" value="" style="shape=image;html=1;verticalAlign=top;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" parent="disc_E_38" vertex="1"><mxGeometry x="870" y="38" width="64" height="64" as="geometry"/></mxCell><mxCell id="outlet_double_t_44" value="&lt;b&gt;Dubbeluttag&lt;/b&gt;&lt;br&gt;id outlet_double · etikett –&lt;br&gt;Dubbelt vägguttag i samma dosa.&lt;br&gt;handskrivet: dubbeluttag, 2-uttag, dubbelt uttag&lt;br&gt;regler: elsl-behorighet" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontFamily=Helvetica;fontSize=10;align=left;verticalAlign=top;spacing=6;" parent="disc_E_38" vertex="1"><mxGeometry x="942" y="34" width="346" height="112" as="geometry"/></mxCell><mxCell id="switch_45" value="" style="shape=image;html=1;verticalAlign=top;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" parent="disc_E_38" vertex="1"><mxGeometry x="1300" y="38" width="64" height="64" as="geometry"/></mxCell><mxCell id="switch_t_46" value="&lt;b&gt;Strömbrytare&lt;/b&gt;&lt;br&gt;id switch · etikett –&lt;br&gt;Strömbrytare för belysning, vid dörren på låssidan.&lt;br&gt;handskrivet: brytare, strömbrytare, omkopplare, dimmer&lt;br&gt;regler: elsl-behorighet" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontFamily=Helvetica;fontSize=10;align=left;verticalAlign=top;spacing=6;" parent="disc_E_38" vertex="1"><mxGeometry x="1372" y="34" width="346" height="112" as="geometry"/></mxCell><mxCell id="light_47" value="" style="shape=image;html=1;verticalAlign=top;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" parent="disc_E_38" vertex="1"><mxGeometry x="10" y="160" width="64" height="64" as="geometry"/></mxCell><mxCell id="light_t_48" value="&lt;b&gt;Armatur&lt;/b&gt;&lt;br&gt;id light · etikett –&lt;br&gt;Belysning i tak eller på vägg, eller ett takuttag för armatur.&lt;br&gt;handskrivet: lampa, armatur, takuttag, DCL, belysning, spotlight&lt;br&gt;regler: elsl-behorighet" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontFamily=Helvetica;fontSize=10;align=left;verticalAlign=top;spacing=6;" parent="disc_E_38" vertex="1"><mxGeometry x="82" y="156" width="346" height="112" as="geometry"/></mxCell><mxCell id="disc_B_49" value="B Brand (1)" style="swimlane;html=1;whiteSpace=wrap;startSize=28;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=13;fontStyle=1;swimlaneFillColor=#ffffff;rounded=1;arcSize=2;collapsible=0;" parent="1" vertex="1"><mxGeometry x="40" y="1204" width="1740" height="162" as="geometry"/></mxCell><mxCell id="smoke_50" value="" style="shape=image;html=1;verticalAlign=top;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" parent="disc_B_49" vertex="1"><mxGeometry x="10" y="38" width="64" height="64" as="geometry"/></mxCell><mxCell id="smoke_t_51" value="&lt;b&gt;Brandvarnare&lt;/b&gt;&lt;br&gt;id smoke · etikett –&lt;br&gt;Brandvarnare i tak, nära sovrum och på varje plan.&lt;br&gt;handskrivet: brandvarnare, rökdetektor, BV, brandlarm&lt;br&gt;regler: –" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontFamily=Helvetica;fontSize=10;align=left;verticalAlign=top;spacing=6;" parent=