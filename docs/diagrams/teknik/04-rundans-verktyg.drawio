<mxfile host="rmink" agent="docs/diagrams/build.py"><diagram id="04-rundans-verktyg" name="4. Rundans verktygsloop"><mxGraphModel dx="1480" dy="583" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" background="#ffffff" pageWidth="1480" pageHeight="583" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t_1" value="&lt;b&gt;4. Rundans verktygsloop&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=22;fontColor=#000000;align=left;verticalAlign=top;spacing=2;" parent="1" vertex="1"><mxGeometry x="40" y="20" width="1400" height="34" as="geometry"/></mxCell><mxCell id="t_2" value="drawing/agent.run_round: Claude arbetar med rmink:s verktyg tills revisionen är sparad. Samma verktyg finns i MCP-servern för användarens egen Claude." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#333333;align=left;verticalAlign=top;spacing=2;" parent="1" vertex="1"><mxGeometry x="40" y="56" width="1400" height="22" as="geometry"/></mxCell><mxCell id="c_3" value="&lt;b&gt;run_round(dokument, enhet, lagring)&lt;/b&gt;&lt;br&gt;1 namnet: länkad ritning, eller mappens / bokens namn&lt;br&gt;2 föregående ritning ur lagringen&lt;br&gt;3 read_sketch (bara nya streck efter första varvet)&lt;br&gt;4 meddelande: intro, sparad Drawing, överlagsbild, grupper&lt;br&gt;5 systemprompt + ritreferens + kunskapsreferens (cachad)&lt;br&gt;6 högst 16 vändor, effort medium&lt;br&gt;7 RoundResult: plats, revision, sammanfattning, frågor, kostnad" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1"><mxGeometry x="40" y="110" width="320" height="193" as="geometry"/></mxCell><mxCell id="c_4" value="&lt;b&gt;Claude (Opus)&lt;/b&gt;&lt;br&gt;väljer verktyg&lt;br&gt;tolkar skiss och markeringar&lt;br&gt;frågar hellre än gissar" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1"><mxGeometry x="420" y="180" width="220" height="120" as="geometry"/></mxCell><mxCell id="e_5" value="meddelanden" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;strokeColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="c_3" target="c_4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="render_preview_drawing__6" value="&lt;b&gt;render_preview(drawing)&lt;/b&gt;&lt;br&gt;finalize: rectify, namn, revision, datum&lt;br&gt;bild av ritningen och alternativsidan&lt;br&gt;+ måttkontroll (check_dimensions)&lt;br&gt;→ granska: väggar räta, lådor raka, öppningar längs väggen" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1"><mxGeometry x="720" y="100" width="400" height="97" as="geometry"/></mxCell><mxCell id="e_7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;strokeColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="c_4" target="render_preview_drawing__6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="measure_ids__8" value="&lt;b&gt;measure(ids)&lt;/b&gt;&lt;br&gt;längd, area, hörnvinklar ur geometrin&lt;br&gt;i mm via skalan från skrivna mått" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1"><mxGeometry x="720" y="213" width="400" height="55" as="geometry"/></mxCell><mxCell id="e_9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;strokeColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="c_4" target="measure_ids__8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="calculate_uttryck__10" value="&lt;b&gt;calculate(uttryck)&lt;/b&gt;&lt;br&gt;abs, acos, area, asin, atan, atan2, ceil, circle, cos, count, cylinder, deg, density, floor, hypot, leg, len, max, min, pieces, pitch, rad, round, set, sin, slope, sqrt, sum, tan, triangle, u_value, waste, weight" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1"><mxGeometry x="720" y="284" width="400" height="83" as="geometry"/></mxCell><mxCell id="e_11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;strokeColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="c_4" target="calculate_uttryck__10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="lookup_knowledge_fråga__sort__12" value="&lt;b&gt;lookup_knowledge(fråga, sort)&lt;/b&gt;&lt;br&gt;material, konstruktion, variant, regel,&lt;br&gt;åtgärd, symbol, term, ritningstyp, roll, skraffering" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1"><mxGeometry x="720" y="383" width="400" height="55" as="geometry"/></mxCell><mxCell id="e_13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;strokeColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="c_4" target="lookup_knowledge_fråga__sort__12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="save_revision_drawing__sammanfattning__14" value="&lt;b&gt;save_revision(drawing, sammanfattning)&lt;/b&gt;&lt;br&gt;en gång per varv&lt;br&gt;build_revision → send_revision" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1"><mxGeometry x="720" y="455" width="400" height="55" as="geometry"/></mxCell><mxCell id="e_15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;strokeColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="c_4" target="save_revision_drawing__sammanfattning__14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="Regler_i_prompten_16" value='&lt;b&gt;Regler i prompten&lt;/b&gt;&lt;br&gt;Räta vinklar: väggar möts i 90° om ingen skriven vinkel säger annat; lutning under 12° kräver ett vinkelmått.&lt;br&gt;Tal räknas aldrig i huvudet: measure och calculate.&lt;br&gt;Regler citeras först efter lookup_knowledge; högst några per varv, viktigast först.&lt;br&gt;Enhet skrivs med varje tal i anmärkningar och texter.&lt;br&gt;Alternativ ("alternativ?", "hur tjock?"): 2–4 lösningar på en egen sida, val med bokstav på SVAR-raden.' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1"><mxGeometry x="40" y="333" width="600" height="124" as="geometry"/></mxCell><mxCell id="Samma_flöde_via_MCP_17" value="&lt;b&gt;Samma flöde via MCP&lt;/b&gt;&lt;br&gt;read_sketch → drawing_reference → lookup_knowledge / calculate / measure_drawing → render_drawing_preview → save_revision(send=True)&lt;br&gt;Tolkningen sker i användarens egen Claude, så rmink förblir gratis." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1"><mxGeometry x="40" y="474" width="600" height="69" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
