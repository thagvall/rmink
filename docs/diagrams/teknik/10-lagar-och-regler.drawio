<mxfile host="rmink" agent="docs/diagrams/build.py"><diagram id="10-lagar-och-regler" name="10. Lagar, föreskrifter och granskningsregler"><mxGraphModel dx="1916" dy="1974" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" background="#ffffff" pageWidth="1916" pageHeight="1974" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t_1" value="&lt;b&gt;10. Lagar, föreskrifter och granskningsregler&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=22;fontColor=#000000;align=left;verticalAlign=top;spacing=2;" parent="1" vertex="1"><mxGeometry x="40" y="20" width="1400" height="34" as="geometry"/></mxCell><mxCell id="t_2" value="BBR och EKS ersattes 2025-07-01 av BFS 2024:4–13 (övergången slutade 2026-07-01). fel = strider mot krav · fråga = något att ta ställning till · info = upplysning." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#333333;align=left;verticalAlign=top;spacing=2;" parent="1" vertex="1"><mxGeometry x="40" y="56" width="1400" height="22" as="geometry"/></mxCell><mxCell id="Plan__och_bygglag__2010_900__3" value="&lt;b&gt;Plan- och bygglag (2010:900)&lt;/b&gt;&lt;br&gt;konsoliderad t.o.m. SFS 2026:1583" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1"><mxGeometry x="40" y="110" width="260" height="80" as="geometry"/></mxCell><mxCell id="Plan__och_byggförordning__2011_338__4" value="&lt;b&gt;Plan- och byggförordning (2011:338)&lt;/b&gt;&lt;br&gt;konsoliderad t.o.m. SFS 2026:1722" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1"><mxGeometry x="315" y="110" width="260" height="80" as="geometry"/></mxCell><mxCell id="Elsäkerhetslag__2016_732__5" value="&lt;b&gt;Elsäkerhetslag (2016:732)&lt;/b&gt;&lt;br&gt;konsoliderad t.o.m. SFS 2026:1294" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1"><mxGeometry x="590" y="110" width="260" height="80" as="geometry"/></mxCell><mxCell id="ELSÄK_FS_2017_2__undantag_för_vissa_elin_6" value="&lt;b&gt;ELSÄK-FS 2017:2 (undantag för vissa elinstallationsarbeten)&lt;/b&gt;&lt;br&gt;konsoliderad t.o.m. ej kontrollerad – länken leder om till en webbsida (2026-10-28)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1"><mxGeometry x="865" y="110" width="260" height="83" as="geometry"/></mxCell><mxCell id="legend_7" value="Källa" style="swimlane;html=1;whiteSpace=wrap;startSize=28;fillColor=#ffffff;strokeColor=#666666;fontFamily=Helvetica;fontSize=11;fontStyle=1;swimlaneFillColor=#ffffff;rounded=1;arcSize=2;collapsible=0;" parent="1" vertex="1"><mxGeometry x="1140" y="110" width="230" height="108" as="geometry"/></mxCell><mxCell id="c_8" value="" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="legend_7" vertex="1"><mxGeometry x="10" y="34" width="26" height="16" as="geometry"/></mxCell><mxCell id="t_9" value="Lag, förordning, föreskrift" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#000000;align=left;verticalAlign=top;spacing=2;" parent="legend_7" vertex="1"><mxGeometry x="44" y="32" width="180" height="20" as="geometry"/></mxCell><mxCell id="c_10" value="" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="legend_7" vertex="1"><mxGeometry x="10" y="58" width="26" height="16" as="geometry"/></mxCell><mxCell id="t_11" value="Praxis och branschregler" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#000000;align=left;verticalAlign=top;spacing=2;" parent="legend_7" vertex="1"><mxGeometry x="44" y="56" width="180" height="20" as="geometry"/></mxCell><mxCell id="c_12" value="" style="rounded=0;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="legend_7" vertex="1"><mxGeometry x="10" y="82" width="26" height="16" as="geometry"/></mxCell><mxCell id="t_13" value="rmink-regel" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=11;fontColor=#000000;align=left;verticalAlign=top;spacing=2;" parent="legend_7" vertex="1"><mxGeometry x="44" y="80" width="180" height="20" as="geometry"/></mxCell><mxCell id="PBL_8_kap__4____tekniska_egenskapskrav___14" value='&lt;b&gt;PBL 8 kap. 4 §: tekniska egenskapskrav → Boverkets föreskrifter&lt;/b&gt;&lt;table style="border-collapse:collapse;font-size:10px" cellpadding="1" cellspacing="0" border="0"&gt;&lt;tr style="font-weight:bold"&gt;&lt;td valign="top" align="left" width="20"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="300"&gt;krav&lt;/td&gt;&lt;td valign="top" align="left" width="140"&gt;föreskrift&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="20"&gt;1&lt;/td&gt;&lt;td valign="top" align="left" width="300"&gt;Bärförmåga, stadga och beständighet&lt;/td&gt;&lt;td valign="top" align="left" width="140"&gt;BFS 2024:6&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="20"&gt;2&lt;/td&gt;&lt;td valign="top" align="left" width="300"&gt;Säkerhet i händelse av brand&lt;/td&gt;&lt;td valign="top" align="left" width="140"&gt;BFS 2024:7&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="20"&gt;3&lt;/td&gt;&lt;td valign="top" align="left" width="300"&gt;Skydd med hänsyn till hygien, hälsa och miljön&lt;/td&gt;&lt;td valign="top" align="left" width="140"&gt;BFS 2024:8&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="20"&gt;4&lt;/td&gt;&lt;td valign="top" align="left" width="300"&gt;Säkerhet vid användning&lt;/td&gt;&lt;td valign="top" align="left" width="140"&gt;BFS 2024:9&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="20"&gt;5&lt;/td&gt;&lt;td valign="top" align="left" width="300"&gt;Skydd mot buller&lt;/td&gt;&lt;td valign="top" align="left" width="140"&gt;BFS 2024:10&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="20"&gt;6&lt;/td&gt;&lt;td valign="top" align="left" width="300"&gt;Energihushållning och värmeisolering&lt;/td&gt;&lt;td valign="top" align="left" width="140"&gt;BFS 2026:9&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="20"&gt;7&lt;/td&gt;&lt;td valign="top" align="left" width="300"&gt;Lämplighet för det avsedda ändamålet&lt;/td&gt;&lt;td valign="top" align="left" width="140"&gt;BFS 2024:11&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="20"&gt;8&lt;/td&gt;&lt;td valign="top" align="left" width="300"&gt;Tillgänglighet och användbarhet&lt;/td&gt;&lt;td valign="top" align="left" width="140"&gt;BFS 2024:12 (tomter: BFS 2024:13)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="20"&gt;9&lt;/td&gt;&lt;td valign="top" align="left" width="300"&gt;Hushållning med vatten och avfall&lt;/td&gt;&lt;td valign="top" align="left" width="140"&gt;BFS 2024:8&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="20"&gt;10&lt;/td&gt;&lt;td valign="top" align="left" width="300"&gt;Bredbandsanslutning&lt;/td&gt;&lt;td valign="top" align="left" width="140"&gt;–&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="20"&gt;11&lt;/td&gt;&lt;td valign="top" align="left" width="300"&gt;Hållbar mobilitet&lt;/td&gt;&lt;td valign="top" align="left" width="140"&gt;–&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1"><mxGeometry x="1400" y="110" width="476" height="218" as="geometry"/></mxCell><mxCell id="e_15" value="8 kap. 4 §" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;strokeColor=#333333;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" parent="1" edge="1" source="Plan__och_bygglag__2010_900__3" target="PBL_8_kap__4____tekniska_egenskapskrav___14"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="170" y="342"/></Array></mxGeometry></mxCell><mxCell id="rmink_16" value='&lt;b&gt;rmink (10 regler)&lt;/b&gt;&lt;table style="border-collapse:collapse;font-size:10px" cellpadding="1" cellspacing="0" border="0"&gt;&lt;tr style="font-weight:bold"&gt;&lt;td valign="top" align="left" width="150"&gt;id&lt;/td&gt;&lt;td valign="top" align="left" width="120"&gt;lagrum&lt;/td&gt;&lt;td valign="top" align="left" width="190"&gt;regel&lt;/td&gt;&lt;td valign="top" align="left" width="55"&gt;grad&lt;/td&gt;&lt;td valign="top" align="left" width="40"&gt;verif.&lt;/td&gt;&lt;td valign="top" align="left" width="330"&gt;meddelande&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;rmink-ritningshuvud&lt;/td&gt;&lt;td valign="top" align="left" width="120"&gt;drawing_standard.toml [[title_block_field]] required = true&lt;/td&gt;&lt;td valign="top" align="left" width="190"&gt;Ritningshuvudet är komplett&lt;/td&gt;&lt;td valign="top" align="left" width="55"&gt;fråga&lt;/td&gt;&lt;td valign="top" align="left" width="40"&gt;ja&lt;/td&gt;&lt;td valign="top" align="left" width="330"&gt;Ritningshuvudet saknar {saknas}. Vad ska stå där?&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;rmink-skala&lt;/td&gt;&lt;td valign="top" align="left" width="120"&gt;drawing_standard.toml [scales]&lt;/td&gt;&lt;td valign="top" align="left" width="190"&gt;Skala anges&lt;/td&gt;&lt;td valign="top" align="left" width="55"&gt;fråga&lt;/td&gt;&lt;td valign="top" align="left" width="40"&gt;ja&lt;/td&gt;&lt;td valign="top" align="left" width="330"&gt;Skala saknas. Är ritningen tänkt i 1:50, 1:20 eller annan skala?&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;rmink-norrpil&lt;/td&gt;&lt;td valign="top" align="left" width="120"&gt;drawing_standard.toml [[drawing_type]] required&lt;/td&gt;&lt;td valign="top" align="left" width="190"&gt;Norrpil på plan och situationsplan&lt;/td&gt;&lt;td valign="top" align="left" width="55"&gt;info&lt;/td&gt;&lt;td valign="top" align="left" width="40"&gt;ja&lt;/td&gt;&lt;td valign="top" align="left" width="330"&gt;Norrpil saknas. Var är norr?&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;rmink-sektionsmarkering&lt;/td&gt;&lt;td valign="top" align="left" width="120"&gt;drawing_standard.toml [[designation]] sektion&lt;/td&gt;&lt;td valign="top" align="left" width="190"&gt;Sektioner är markerade i plan&lt;/td&gt;&lt;td valign="top" align="left" width="55"&gt;fråga&lt;/td&gt;&lt;td valign="top" align="left" width="40"&gt;ja&lt;/td&gt;&lt;td valign="top" align="left" width="330"&gt;Sektion {namn} finns men syns inte som snittlinje i planen. Var går snittet?&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;rmink-mattkedja&lt;/td&gt;&lt;td valign="top" align="left" width="120"&gt;drawing_standard.toml [dimensioning]&lt;/td&gt;&lt;td valign="top" align="left" width="190"&gt;Måttkedjor summerar till totalmåttet&lt;/td&gt;&lt;td valign="top" align="left" width="55"&gt;fel&lt;/td&gt;&lt;td valign="top" align="left" width="40"&gt;ja&lt;/td&gt;&lt;td valign="top" align="left" width="330"&gt;Delmåtten {delar} = {summa} men totalmåttet är {total}. Vilket stämmer?&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;rmink-matt-skala&lt;/td&gt;&lt;td valign="top" align="left" width="120"&gt;src/rmink/drawing/workflow.py:211 check_dimensions&lt;/td&gt;&lt;td valign="top" align="left" width="190"&gt;Skrivna mått stämmer med ritad längd&lt;/td&gt;&lt;td valign="top" align="left" width="55"&gt;fråga&lt;/td&gt;&lt;td valign="top" align="left" width="40"&gt;ja&lt;/td&gt;&lt;td valign="top" align="left" width="330"&gt;Måttet {matt} avviker {procent} % från ritad längd. Gäller det skrivna måttet?&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;rmink-material-klass&lt;/td&gt;&lt;td valign="top" align="left" width="120"&gt;materials.toml required&lt;/td&gt;&lt;td valign="top" align="left" width="190"&gt;Material anges med obligatoriska egenskaper&lt;/td&gt;&lt;td valign="top" align="left" width="55"&gt;fråga&lt;/td&gt;&lt;td valign="top" align="left" width="40"&gt;ja&lt;/td&gt;&lt;td valign="top" align="left" width="330"&gt;{material}: saknar {egenskap}. Till exempel {exempel}?&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;rmink-dimension-saknas&lt;/td&gt;&lt;td valign="top" align="left" width="120"&gt;materials.toml konstruktionsvirke&lt;/td&gt;&lt;td valign="top" align="left" width="190"&gt;Bärande trä har dimension och c-avstånd&lt;/td&gt;&lt;td valign="top" align="left" width="55"&gt;fråga&lt;/td&gt;&lt;td valign="top" align="left" width="40"&gt;ja&lt;/td&gt;&lt;td valign="top" align="left" width="330"&gt;{del} saknar dimension eller c-avstånd.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;rmink-forklaring&lt;/td&gt;&lt;td valign="top" align="left" width="120"&gt;hatches.toml – mönstren är rmink-konvention&lt;/td&gt;&lt;td valign="top" align="left" width="190"&gt;Alla använda symboler och skrafferingar förklaras&lt;/td&gt;&lt;td valign="top" align="left" width="55"&gt;info&lt;/td&gt;&lt;td valign="top" align="left" width="40"&gt;ja&lt;/td&gt;&lt;td valign="top" align="left" width="330"&gt;{mönster} används men finns inte i FÖRKLARINGAR.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;rmink-niva-nollpunkt&lt;/td&gt;&lt;td valign="top" align="left" width="120"&gt;drawing_standard.toml [dimensioning]&lt;/td&gt;&lt;td valign="top" align="left" width="190"&gt;Nivåer har en nollpunkt&lt;/td&gt;&lt;td valign="top" align="left" width="55"&gt;fråga&lt;/td&gt;&lt;td valign="top" align="left" width="40"&gt;ja&lt;/td&gt;&lt;td valign="top" align="left" width="330"&gt;Nivåer anges men ±0 är inte definierad. Vad är ±0 (till exempel FG entréplan)?&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1"><mxGeometry x="40" y="378" width="901" height="396" as="geometry"/></mxCell><mxCell id="BFS_2024_9_17" value='&lt;b&gt;BFS 2024:9 (11 regler)&lt;/b&gt;&lt;table style="border-collapse:collapse;font-size:10px" cellpadding="1" cellspacing="0" border="0"&gt;&lt;tr style="font-weight:bold"&gt;&lt;td valign="top" align="left" width="150"&gt;id&lt;/td&gt;&lt;td valign="top" align="left" width="120"&gt;lagrum&lt;/td&gt;&lt;td valign="top" align="left" width="190"&gt;regel&lt;/td&gt;&lt;td valign="top" align="left" width="55"&gt;grad&lt;/td&gt;&lt;td valign="top" align="left" width="40"&gt;verif.&lt;/td&gt;&lt;td valign="top" align="left" width="330"&gt;meddelande&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;bfs9-fonster-barn&lt;/td&gt;&lt;td valign="top" align="left" width="120"&gt;2 kap. 4 §&lt;/td&gt;&lt;td valign="top" align="left" width="190"&gt;Fönster i utrymmen där yngre barn kan vistas&lt;/td&gt;&lt;td valign="top" align="left" width="55"&gt;fråga&lt;/td&gt;&lt;td valign="top" align="left" width="40"&gt;ja&lt;/td&gt;&lt;td valign="top" align="left" width="330"&gt;Fallhöjd ≥ 2,0 m och karm under 0,60 m över golv: fönstret behöver barnsäkring som fixerar stängt och med högst 100 mm öppning (BFS 2024:9 2 kap. 4 §…&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;bfs9-trappa-oppning&lt;/td&gt;&lt;td valign="top" align="left" width="120"&gt;2 kap. 6 §&lt;/td&gt;&lt;td valign="top" align="left" width="190"&gt;Öppningar mellan plansteg i trappa&lt;/td&gt;&lt;td valign="top" align="left" width="55"&gt;fel&lt;/td&gt;&lt;td valign="top" align="left" width="40"&gt;ja&lt;/td&gt;&lt;td valign="top" align="left" width="330"&gt;Öppning mellan plansteg är {matt} mm – högst 100 mm (BFS 2024:9 2 kap. 6 §).&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;bfs9-plan-dorr-trappa&lt;/td&gt;&lt;td valign="top" align="left" width="120"&gt;2 kap. 7 §&lt;/td&gt;&lt;td valign="top" align="left" width="190"&gt;Plan mellan dörr och nedåtgående trappa&lt;/td&gt;&lt;td valign="top" align="left" width="55"&gt;fråga&lt;/td&gt;&lt;td valign="top" align="left" width="40"&gt;ja&lt;/td&gt;&lt;td valign="top" align="left" width="330"&gt;Dörren öppnar direkt mot en nedåtgående trappa eller ett steg. Ska det finnas ett plan emellan? I utrymningsväg minst 0,8 m (BFS 2024:9 2 kap. 7 §).&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;bfs9-skydd-mot-fall&lt;/td&gt;&lt;td valign="top" align="left" width="120"&gt;2 kap. 10–11 §§&lt;/td&gt;&lt;td valign="top" align="left" width="190"&gt;Skydd mot fall där risk för personskada finns&lt;/td&gt;&lt;td valign="top" align="left" width="55"&gt;fråga&lt;/td&gt;&lt;td valign="top" align="left" width="40"&gt;ja&lt;/td&gt;&lt;td valign="top" align="left" width="330"&gt;Altanen/trappan har en fallhöjd. Behövs räcke? Föreskriften anger ingen fast gräns – bedömningen görs efter användning och fallhöjd (BFS 2024:9 2 kap…&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;bfs9-racke-barn&lt;/td&gt;&lt;td valign="top" align="left" width="120"&gt;2 kap. 11 § andra stycket&lt;/td&gt;&lt;td valign="top" align="left" width="190"&gt;Räcke där yngre barn kan vistas&lt;/td&gt;&lt;td valign="top" align="left" width="55"&gt;fel&lt;/td&gt;&lt;td valign="top" align="left" width="40"&gt;ja&lt;/td&gt;&lt;td valign="top" align="left" width="330"&gt;Räcke där barn kan vistas: klätterskydd de nedersta 0,8 m, spjälavstånd högst 100 mm, högst 50 mm under räcket mot golv/stegnos, inga horisontella öp…&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;bfs9-ledstang&lt;/td&gt;&lt;td valign="top" align="left" width="120"&gt;2 kap. 12–13 §§&lt;/td&gt;&lt;td valign="top" align="left" width="190"&gt;Ledstänger i trappor och ramper&lt;/td&gt;&lt;td valign="top" align="left" width="55"&gt;fråga&lt;/td&gt;&lt;td valign="top" align="left" width="40"&gt;ja&lt;/td&gt;&lt;td valign="top" align="left" width="330"&gt;Ledstång saknas. Krav på båda sidor, en sida räcker om det är obehövligt med två (BFS 2024:9 2 kap. 12 §).&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;bfs9-fri-hojd&lt;/td&gt;&lt;td valign="top" align="left" width="120"&gt;2 kap. 25 §&lt;/td&gt;&lt;td valign="top" align="left" width="190"&gt;Fri höjd i trappor, dörrar och kommunikationsutrymmen&lt;/td&gt;&lt;td valign="top" align="left" width="55"&gt;fel&lt;/td&gt;&lt;td valign="top" align="left" width="40"&gt;ja&lt;/td&gt;&lt;td valign="top" align="left" width="330"&gt;Fri höjd {matt} m – minst 2,00 m i trappor, dörrar och passager (BFS 2024:9 2 kap. 25 §).&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;bfs9-utskjutande&lt;/td&gt;&lt;td valign="top" align="left" width="120"&gt;2 kap. 26 §&lt;/td&gt;&lt;td valign="top" align="left" width="190"&gt;Utskjutande delar under 2,20 m&lt;/td&gt;&lt;td valign="top" align="left" width="55"&gt;fråga&lt;/td&gt;&lt;td valign="top" align="left" width="40"&gt;ja&lt;/td&gt;&lt;td valign="top" align="left" width="330"&gt;Del som sticker ut lägre än 2,20 m över gångyta – hur begränsas risken för sammanstötning (BFS 2024:9 2 kap. 26 §)?&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;bfs9-glas-fall&lt;/td&gt;&lt;td valign="top" align="left" width="120"&gt;2 kap. 30 §&lt;/td&gt;&lt;td valign="top" align="left" width="190"&gt;Skydd mot fall genom glas&lt;/td&gt;&lt;td valign="top" align="left" width="55"&gt;fel&lt;/td&gt;&lt;td valign="top" align="left" width="40"&gt;ja&lt;/td&gt;&lt;td valign="top" align="left" width="330"&gt;Glas lägre än 0,6 m över golv med fallhöjd över 2,0 m: glaset ska klara dynamisk påverkan av en människa eller ha permanent skydd (BFS 2024:9 2 kap. …&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;bfs9-glas-skar&lt;/td&gt;&lt;td valign="top" align="left" width="120"&gt;2 kap. 31 §&lt;/td&gt;&lt;td valign="top" align="left" width="190"&gt;Skydd mot skärskador vid glas&lt;/td&gt;&lt;td valign="top" align="left" width="55"&gt;fråga&lt;/td&gt;&lt;td valign="top" align="left" width="40"&gt;ja&lt;/td&gt;&lt;td valign="top" align="left" width="330"&gt;Glas under 0,6 m i bostad (1,5 m i entré) ska ha brottkaraktär som begränsar skärskador, till exempel härdat eller laminerat (BFS 2024:9 2 kap. 31 §).&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;bfs9-tappvarmvatten&lt;/td&gt;&lt;td valign="top" align="left" width="120"&gt;2 kap. 33 §&lt;/td&gt;&lt;td valign="top" align="left" width="190"&gt;Temperatur på tappvarmvatten&lt;/td&gt;&lt;td valign="top" align="left" width="55"&gt;info&lt;/td&gt;&lt;td valign="top" align="left" width="40"&gt;ja&lt;/td&gt;&lt;td valign="top" align="left" width="330"&gt;Tappvarmvatten högst 60 °C efter tappstället, 38 °C där skållningsrisk är särskild (BFS 2024:9 2 kap. 33 §).&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1"><mxGeometry x="957" y="378" width="901" height="449" as="geometry"/></mxCell><mxCell id="BFS_2024_12_18" value='&lt;b&gt;BFS 2024:12 (5 regler)&lt;/b&gt;&lt;table style="border-collapse:collapse;font-size:10px" cellpadding="1" cellspacing="0" border="0"&gt;&lt;tr style="font-weight:bold"&gt;&lt;td valign="top" align="left" width="150"&gt;id&lt;/td&gt;&lt;td valign="top" align="left" width="120"&gt;lagrum&lt;/td&gt;&lt;td valign="top" align="left" width="190"&gt;regel&lt;/td&gt;&lt;td valign="top" align="left" width="55"&gt;grad&lt;/td&gt;&lt;td valign="top" align="left" width="40"&gt;verif.&lt;/td&gt;&lt;td valign="top" align="left" width="330"&gt;meddelande&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;bfs12-ramp-lutning&lt;/td&gt;&lt;td valign="top" align="left" width="120"&gt;2 kap. 4 §&lt;/td&gt;&lt;td valign="top" align="left" width="190"&gt;Ramplutning&lt;/td&gt;&lt;td valign="top" align="left" width="55"&gt;fel&lt;/td&gt;&lt;td valign="top" align="left" width="40"&gt;ja&lt;/td&gt;&lt;td valign="top" align="left" width="330"&gt;Rampen lutar {lutning} – högst 1:12 för en tillgänglig ramp (BFS 2024:12 2 kap. 4 §).&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;bfs12-entre-smahus&lt;/td&gt;&lt;td valign="top" align="left" width="120"&gt;2 kap. 1 § andra stycket&lt;/td&gt;&lt;td valign="top" align="left" width="190"&gt;Entré i en- och tvåbostadshus&lt;/td&gt;&lt;td valign="top" align="left" width="55"&gt;info&lt;/td&gt;&lt;td valign="top" align="left" width="40"&gt;ja&lt;/td&gt;&lt;td valign="top" align="left" width="330"&gt;För småhus räcker att en tillgänglig ramp till entrén går att ordna på tomten i efterhand (BFS 2024:12 2 kap. 1 §).&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;bfs12-hygienrum&lt;/td&gt;&lt;td valign="top" align="left" width="120"&gt;2 kap. 9 §, 3 kap. 9 §&lt;/td&gt;&lt;td valign="top" align="left" width="190"&gt;Ett tillgängligt rum för personhygien&lt;/td&gt;&lt;td valign="top" align="left" width="55"&gt;fråga&lt;/td&gt;&lt;td valign="top" align="left" width="40"&gt;ja&lt;/td&gt;&lt;td valign="top" align="left" width="330"&gt;Minst ett rum för personhygien ska vara tillgängligt. Ryms vändcirkel för rullstol (1,50 m enligt det dimensionerande måttet i BFS 2024:13 2 kap. 1 §…&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;bfs12-entreplan&lt;/td&gt;&lt;td valign="top" align="left" width="120"&gt;2 kap. 12 §&lt;/td&gt;&lt;td valign="top" align="left" width="190"&gt;Bostad i flera plan – entréplanet tillgängligt&lt;/td&gt;&lt;td valign="top" align="left" width="55"&gt;info&lt;/td&gt;&lt;td valign="top" align="left" width="40"&gt;ja&lt;/td&gt;&lt;td valign="top" align="left" width="330"&gt;Bostad i flera plan: entréplanet ska vara tillgängligt och ha alla bostadsfunktioner, eventuellt i begränsad storlek (BFS 2024:12 2 kap. 12 §).&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;bfs12-tillbyggnad-niva&lt;/td&gt;&lt;td valign="top" align="left" width="120"&gt;4 kap. 4 §&lt;/td&gt;&lt;td valign="top" align="left" width="190"&gt;Nivåskillnad vid tillbyggnad av småhus&lt;/td&gt;&lt;td valign="top" align="left" width="55"&gt;info&lt;/td&gt;&lt;td valign="top" align="left" width="40"&gt;ja&lt;/td&gt;&lt;td valign="top" align="left" width="330"&gt;Tillbyggnad i entréplan får ha en otillgänglig nivåskillnad om den lätt kan åtgärdas i efterhand och bostaden inte försämras (BFS 2024:12 4 kap. 4 §).&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1"><mxGeometry x="40" y="790" width="901" height="235" as="geometry"/></mxCell><mxCell id="BFS_2024_13_19" value='&lt;b&gt;BFS 2024:13 (1 regler)&lt;/b&gt;&lt;table style="border-collapse:collapse;font-size:10px" cellpadding="1" cellspacing="0" border="0"&gt;&lt;tr style="font-weight:bold"&gt;&lt;td valign="top" align="left" width="150"&gt;id&lt;/td&gt;&lt;td valign="top" align="left" width="120"&gt;lagrum&lt;/td&gt;&lt;td valign="top" align="left" width="190"&gt;regel&lt;/td&gt;&lt;td valign="top" align="left" width="55"&gt;grad&lt;/td&gt;&lt;td valign="top" align="left" width="40"&gt;verif.&lt;/td&gt;&lt;td valign="top" align="left" width="330"&gt;meddelande&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;bfs13-dimensionerande-matt&lt;/td&gt;&lt;td valign="top" align="left" width="120"&gt;2 kap. 1 §&lt;/td&gt;&lt;td valign="top" align="left" width="190"&gt;Dimensionerande mått för rullstol (tomt)&lt;/td&gt;&lt;td valign="top" align="left" width="55"&gt;fråga&lt;/td&gt;&lt;td valign="top" align="left" width="40"&gt;ja&lt;/td&gt;&lt;td valign="top" align="left" width="330"&gt;Gångväg på tomten: dimensionera för rullstol 0,70×1,30 m, vändcirkel 1,50 m och fri passage minst 0,90 m (BFS 2024:13 2 kap. 1 §).&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1"><mxGeometry x="957" y="843" width="901" height="114" as="geometry"/></mxCell><mxCell id="BFS_2024_8_20" value='&lt;b&gt;BFS 2024:8 (3 regler)&lt;/b&gt;&lt;table style="border-collapse:collapse;font-size:10px" cellpadding="1" cellspacing="0" border="0"&gt;&lt;tr style="font-weight:bold"&gt;&lt;td valign="top" align="left" width="150"&gt;id&lt;/td&gt;&lt;td valign="top" align="left" width="120"&gt;lagrum&lt;/td&gt;&lt;td valign="top" align="left" width="190"&gt;regel&lt;/td&gt;&lt;td valign="top" align="left" width="55"&gt;grad&lt;/td&gt;&lt;td valign="top" align="left" width="40"&gt;verif.&lt;/td&gt;&lt;td valign="top" align="left" width="330"&gt;meddelande&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;bfs8-ventilation&lt;/td&gt;&lt;td valign="top" align="left" width="120"&gt;3 kap. 5 §&lt;/td&gt;&lt;td valign="top" align="left" width="190"&gt;Uteluftsflöde i bostäder&lt;/td&gt;&lt;td valign="top" align="left" width="55"&gt;info&lt;/td&gt;&lt;td valign="top" align="left" width="40"&gt;ja&lt;/td&gt;&lt;td valign="top" align="left" width="330"&gt;Ventilationen ska dimensioneras för minst 0,35 l/s per m² golv och 4,0 l/s per person i rum (BFS 2024:8 3 kap. 5 §).&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;bfs8-dagsljus&lt;/td&gt;&lt;td valign="top" align="left" width="120"&gt;4 kap. 1 §&lt;/td&gt;&lt;td valign="top" align="left" width="190"&gt;Dagsljus i bostäder&lt;/td&gt;&lt;td valign="top" align="left" width="55"&gt;info&lt;/td&gt;&lt;td valign="top" align="left" width="40"&gt;ja&lt;/td&gt;&lt;td valign="top" align="left" width="330"&gt;Dagsljusfaktor minst 1,0 % för minst halva ytan av rum där man vistas mer än tillfälligt (BFS 2024:8 4 kap. 1 §). Påverkar fönster eller avskärmning …&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;bfs8-fukt-75rf&lt;/td&gt;&lt;td valign="top" align="left" width="120"&gt;7 kap. 1 §&lt;/td&gt;&lt;td valign="top" align="left" width="190"&gt;Högsta tillåtna fukttillstånd&lt;/td&gt;&lt;td valign="top" align="left" width="55"&gt;info&lt;/td&gt;&lt;td valign="top" align="left" width="40"&gt;ja&lt;/td&gt;&lt;td valign="top" align="left" width="330"&gt;Om materialet saknar dokumenterat högsta fukttillstånd gäller 75 % RF (BFS 2024:8 7 kap. 1 §). Är ångspärr, luftspalt och kapillärbrytning redovisade?&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1"><mxGeometry x="957" y="973" width="901" height="168" as="geometry"/></mxCell><mxCell id="BFS_2024_7_21" value='&lt;b&gt;BFS 2024:7 (4 regler)&lt;/b&gt;&lt;table style="border-collapse:collapse;font-size:10px" cellpadding="1" cellspacing="0" border="0"&gt;&lt;tr style="font-weight:bold"&gt;&lt;td valign="top" align="left" width="150"&gt;id&lt;/td&gt;&lt;td valign="top" align="left" width="120"&gt;lagrum&lt;/td&gt;&lt;td valign="top" align="left" width="190"&gt;regel&lt;/td&gt;&lt;td valign="top" align="left" width="55"&gt;grad&lt;/td&gt;&lt;td valign="top" align="left" width="40"&gt;verif.&lt;/td&gt;&lt;td valign="top" align="left" width="330"&gt;meddelande&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;bfs7-byggnadsklass&lt;/td&gt;&lt;td valign="top" align="left" width="120"&gt;2 kap. 5–8 §§&lt;/td&gt;&lt;td valign="top" align="left" width="190"&gt;Byggnadsklass (ersätter Br-klasser)&lt;/td&gt;&lt;td valign="top" align="left" width="55"&gt;info&lt;/td&gt;&lt;td valign="top" align="left" width="40"&gt;ja&lt;/td&gt;&lt;td valign="top" align="left" width="330"&gt;Byggnadsklass {klass} (BFS 2024:7 2 kap. 5–8 §§). Småhus i 1–2 plan är normalt byggnadsklass 3.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;bfs7-brandcellsgrans-klass&lt;/td&gt;&lt;td valign="top" align="left" width="120"&gt;5 kap. 29–30 §§&lt;/td&gt;&lt;td valign="top" align="left" width="190"&gt;Brandcellsgräns – lägsta klass&lt;/td&gt;&lt;td valign="top" align="left" width="55"&gt;fråga&lt;/td&gt;&lt;td valign="top" align="left" width="40"&gt;ja&lt;/td&gt;&lt;td valign="top" align="left" width="330"&gt;Väggen är brandcellsgräns: vilken klass? Lägst EI 30 i byggnadsklass 2–3, och EI 60 runt en bostad (verksamhetsklass 3A, till exempel mellan bostäder…&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;bfs7-brandcell-plan&lt;/td&gt;&lt;td valign="top" align="left" width="120"&gt;5 kap. 24 §&lt;/td&gt;&lt;td valign="top" align="left" width="190"&gt;Brandcell högst två plan&lt;/td&gt;&lt;td valign="top" align="left" width="55"&gt;info&lt;/td&gt;&lt;td valign="top" align="left" width="40"&gt;ja&lt;/td&gt;&lt;td valign="top" align="left" width="330"&gt;En brandcell får omfatta högst två plan, utom bland annat bostäder i verksamhetsklass 3A (BFS 2024:7 5 kap. 24 §).&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;bfs7-avstand-byggnader&lt;/td&gt;&lt;td valign="top" align="left" width="120"&gt;6 kap. 5 §, 7 §, 10 §&lt;/td&gt;&lt;td valign="top" align="left" width="190"&gt;Brandspridning mellan byggnader – 8 m&lt;/td&gt;&lt;td valign="top" align="left" width="55"&gt;fråga&lt;/td&gt;&lt;td valign="top" align="left" width="40"&gt;ja&lt;/td&gt;&lt;td valign="top" align="left" width="330"&gt;Avstånd till annan byggnad {avstand} m – under 8 m krävs brandavskiljning (BFS 2024:7 6 kap. 5 §). Komplementbyggnad ≤ 15 m² är undantagen (10 §).&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1"><mxGeometry x="40" y="1042" width="901" height="195" as="geometry"/></mxCell><mxCell id="PBL_22" value='&lt;b&gt;PBL (7 regler)&lt;/b&gt;&lt;table style="border-collapse:collapse;font-size:10px" cellpadding="1" cellspacing="0" border="0"&gt;&lt;tr style="font-weight:bold"&gt;&lt;td valign="top" align="left" width="150"&gt;id&lt;/td&gt;&lt;td valign="top" align="left" width="120"&gt;lagrum&lt;/td&gt;&lt;td valign="top" align="left" width="190"&gt;regel&lt;/td&gt;&lt;td valign="top" align="left" width="55"&gt;grad&lt;/td&gt;&lt;td valign="top" align="left" width="40"&gt;verif.&lt;/td&gt;&lt;td valign="top" align="left" width="330"&gt;meddelande&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;pbl-komplementbyggnad&lt;/td&gt;&lt;td valign="top" align="left" width="120"&gt;9 kap. 4–5 §§ (lydelse SFS 2025:974)&lt;/td&gt;&lt;td valign="top" align="left" width="190"&gt;Lovbefriad komplementbyggnad / komplementbostadshus&lt;/td&gt;&lt;td valign="top" align="left" width="55"&gt;fråga&lt;/td&gt;&lt;td valign="top" align="left" width="40"&gt;ja&lt;/td&gt;&lt;td valign="top" align="left" width="330"&gt;Lovfri komplementbyggnad inom detaljplan: högst 30,0 m² byggnadsarea, nock högst 4,0 m, mindre än huvudbyggnaden, högst 45,0 m² sammanlagt på tomten …&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;pbl-tillbyggnad-30&lt;/td&gt;&lt;td valign="top" align="left" width="120"&gt;9 kap. 10 §&lt;/td&gt;&lt;td valign="top" align="left" width="190"&gt;Lovfri tillbyggnad upp till 30 m²&lt;/td&gt;&lt;td valign="top" align="left" width="55"&gt;fråga&lt;/td&gt;&lt;td valign="top" align="left" width="40"&gt;ja&lt;/td&gt;&lt;td valign="top" align="left" width="330"&gt;Tillbyggnaden är {area} m². Lovfri om högst 30,0 m² (bruttoarea/öppenarea, sammanlagt med tidigare lovfria tillbyggnader) och inte över husets taknoc…&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;pbl-altan-mur-plank&lt;/td&gt;&lt;td valign="top" align="left" width="120"&gt;9 kap. 19 §&lt;/td&gt;&lt;td valign="top" align="left" width="190"&gt;Bygglov för altan, mur och plank inom detaljplan&lt;/td&gt;&lt;td valign="top" align="left" width="55"&gt;fråga&lt;/td&gt;&lt;td valign="top" align="left" width="40"&gt;ja&lt;/td&gt;&lt;td valign="top" align="left" width="330"&gt;Altanen är {hojd} m över mark. Inom detaljplan krävs bygglov om den är högre än 1,8 m inom 3,6 m från byggnaden, eller högre än 1,2 m längre bort (PB…&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;pbl-narhet-grans&lt;/td&gt;&lt;td valign="top" align="left" width="120"&gt;9 kap. 34–35 §§&lt;/td&gt;&lt;td valign="top" align="left" width="190"&gt;Bygglov nära tomtgräns – 4,5 m&lt;/td&gt;&lt;td valign="top" align="left" width="55"&gt;fråga&lt;/td&gt;&lt;td valign="top" align="left" width="40"&gt;ja&lt;/td&gt;&lt;td valign="top" align="left" width="330"&gt;Avstånd till tomtgräns {avstand} m. Närmare än 4,5 m kräver lovfria åtgärder bygglov, om inte de berörda grannarna skriftligen har medgett åtgärden o…&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;pbl-varde&lt;/td&gt;&lt;td valign="top" align="left" width="120"&gt;9 kap. 37–38 §§&lt;/td&gt;&lt;td valign="top" align="left" width="190"&gt;Särskilt värdefull byggnad eller område&lt;/td&gt;&lt;td valign="top" align="left" width="55"&gt;fråga&lt;/td&gt;&lt;td valign="top" align="left" width="40"&gt;ja&lt;/td&gt;&lt;td valign="top" align="left" width="330"&gt;Har byggnaden eller området skyddsbestämmelser i detaljplanen (q-märkning) eller är den särskilt värdefull? Då krävs bygglov även för annars lovfria …&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;pbl-startbesked&lt;/td&gt;&lt;td valign="top" align="left" width="120"&gt;10 kap. 3–4 §§&lt;/td&gt;&lt;td valign="top" align="left" width="190"&gt;Startbesked före arbetet&lt;/td&gt;&lt;td valign="top" align="left" width="55"&gt;info&lt;/td&gt;&lt;td valign="top" align="left" width="40"&gt;ja&lt;/td&gt;&lt;td valign="top" align="left" width="330"&gt;Lov- eller anmälningspliktig åtgärd: arbetet får inte påbörjas före startbesked, och byggnaden får inte tas i bruk före slutbesked (PBL 10 kap. 3–4 §…&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;pbl-kontrollplan&lt;/td&gt;&lt;td valign="top" align="left" width="120"&gt;10 kap. 6–8 §§&lt;/td&gt;&lt;td valign="top" align="left" width="190"&gt;Kontrollplanens innehåll&lt;/td&gt;&lt;td valign="top" align="left" width="55"&gt;info&lt;/td&gt;&lt;td valign="top" align="left" width="40"&gt;ja&lt;/td&gt;&lt;td valign="top" align="left" width="330"&gt;Kontrollplanen ska ange vilka kontroller som görs och mot vilka krav, vem som gör dem och hur, anmälningar till nämnden och arbetsplatsbesök (PBL 10 …&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1"><mxGeometry x="957" y="1157" width="901" height="353" as="geometry"/></mxCell><mxCell id="PBF_23" value='&lt;b&gt;PBF (2 regler)&lt;/b&gt;&lt;table style="border-collapse:collapse;font-size:10px" cellpadding="1" cellspacing="0" border="0"&gt;&lt;tr style="font-weight:bold"&gt;&lt;td valign="top" align="left" width="150"&gt;id&lt;/td&gt;&lt;td valign="top" align="left" width="120"&gt;lagrum&lt;/td&gt;&lt;td valign="top" align="left" width="190"&gt;regel&lt;/td&gt;&lt;td valign="top" align="left" width="55"&gt;grad&lt;/td&gt;&lt;td valign="top" align="left" width="40"&gt;verif.&lt;/td&gt;&lt;td valign="top" align="left" width="330"&gt;meddelande&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;pbf-anmalan&lt;/td&gt;&lt;td valign="top" align="left" width="120"&gt;6 kap. 1 §&lt;/td&gt;&lt;td valign="top" align="left" width="190"&gt;Anmälningspliktiga åtgärder&lt;/td&gt;&lt;td valign="top" align="left" width="55"&gt;fråga&lt;/td&gt;&lt;td valign="top" align="left" width="40"&gt;ja&lt;/td&gt;&lt;td valign="top" align="left" width="330"&gt;Ändringen påverkar {vad}. Det kräver anmälan och startbesked innan arbetet börjar (PBF 6 kap. 1 §, PBL 10 kap. 3 §).&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;pbl-kontrollansvarig&lt;/td&gt;&lt;td valign="top" align="left" width="120"&gt;PBL 10 kap. 9–10 §§, PBF 7 kap. 5 §&lt;/td&gt;&lt;td valign="top" align="left" width="190"&gt;Behövs kontrollansvarig?&lt;/td&gt;&lt;td valign="top" align="left" width="55"&gt;info&lt;/td&gt;&lt;td valign="top" align="left" width="40"&gt;ja&lt;/td&gt;&lt;td valign="top" align="left" width="330"&gt;Kontrollansvarig krävs inte för anmälan, komplementbyggnad, mur/plank/altan eller små ändringar av småhus, om byggnadsnämnden inte beslutar annat (PB…&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1"><mxGeometry x="40" y="1253" width="901" height="128" as="geometry"/></mxCell><mxCell id="ElSL_24" value='&lt;b&gt;ElSL (1 regler)&lt;/b&gt;&lt;table style="border-collapse:collapse;font-size:10px" cellpadding="1" cellspacing="0" border="0"&gt;&lt;tr style="font-weight:bold"&gt;&lt;td valign="top" align="left" width="150"&gt;id&lt;/td&gt;&lt;td valign="top" align="left" width="120"&gt;lagrum&lt;/td&gt;&lt;td valign="top" align="left" width="190"&gt;regel&lt;/td&gt;&lt;td valign="top" align="left" width="55"&gt;grad&lt;/td&gt;&lt;td valign="top" align="left" width="40"&gt;verif.&lt;/td&gt;&lt;td valign="top" align="left" width="330"&gt;meddelande&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;elsl-behorighet&lt;/td&gt;&lt;td valign="top" align="left" width="120"&gt;4 §, 24–27 §§&lt;/td&gt;&lt;td valign="top" align="left" width="190"&gt;Elinstallationsarbete av behörig&lt;/td&gt;&lt;td valign="top" align="left" width="55"&gt;info&lt;/td&gt;&lt;td valign="top" align="left" width="40"&gt;ja&lt;/td&gt;&lt;td valign="top" align="left" width="330"&gt;Elinstallationen (utföra, ändra, reparera eller fast ansluta till starkström) får bara utföras av en auktoriserad elinstallatör eller någon i ett eli…&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1"><mxGeometry x="40" y="1397" width="901" height="114" as="geometry"/></mxCell><mxCell id="praxis_25" value='&lt;b&gt;praxis (9 regler)&lt;/b&gt;&lt;table style="border-collapse:collapse;font-size:10px" cellpadding="1" cellspacing="0" border="0"&gt;&lt;tr style="font-weight:bold"&gt;&lt;td valign="top" align="left" width="150"&gt;id&lt;/td&gt;&lt;td valign="top" align="left" width="120"&gt;lagrum&lt;/td&gt;&lt;td valign="top" align="left" width="190"&gt;regel&lt;/td&gt;&lt;td valign="top" align="left" width="55"&gt;grad&lt;/td&gt;&lt;td valign="top" align="left" width="40"&gt;verif.&lt;/td&gt;&lt;td valign="top" align="left" width="330"&gt;meddelande&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;elsak-undantag&lt;/td&gt;&lt;td valign="top" align="left" width="120"&gt;Elsäkerhetsverkets föreskrifter ELSÄK-FS 2017:2 3 kap. (ej kontrollerat mot källtexten)&lt;/td&gt;&lt;td valign="top" align="left" width="190"&gt;Elarbeten som en privatperson får göra själv&lt;/td&gt;&lt;td valign="top" align="left" width="55"&gt;fråga&lt;/td&gt;&lt;td valign="top" align="left" width="40"&gt;nej&lt;/td&gt;&lt;td valign="top" align="left" width="330"&gt;Ska ägaren göra något elarbete själv? Bara vissa enkla byten är undantagna från kravet på behörighet – kontrollera Elsäkerhetsverkets föreskrifter.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;praxis-racke-hojd&lt;/td&gt;&lt;td valign="top" align="left" width="120"&gt;Tidigare BBR avsnitt 8:23; nu en bedömning enligt BFS 2024:9 2 kap. 11 §&lt;/td&gt;&lt;td valign="top" align="left" width="190"&gt;Räckeshöjd (praxis)&lt;/td&gt;&lt;td valign="top" align="left" width="55"&gt;fråga&lt;/td&gt;&lt;td valign="top" align="left" width="40"&gt;nej&lt;/td&gt;&lt;td valign="top" align="left" width="330"&gt;Räckets höjd är {hojd} m. Vanlig praxis är 1,1 m för altan och balkong – är lägre höjd avsiktlig?&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;praxis-trappa-stegmatt&lt;/td&gt;&lt;td valign="top" align="left" width="120"&gt;Tumregeln 2h + d ≈ 600–630 mm&lt;/td&gt;&lt;td valign="top" align="left" width="190"&gt;Bekvämt stegmått (praxis)&lt;/td&gt;&lt;td valign="top" align="left" width="55"&gt;fråga&lt;/td&gt;&lt;td valign="top" align="left" width="40"&gt;nej&lt;/td&gt;&lt;td valign="top" align="left" width="330"&gt;Steghöjd {h} och stegdjup {d} ger 2h+d = {summa} mm. Bekvämt är ungefär 600–630 mm.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;praxis-ntr-markkontakt&lt;/td&gt;&lt;td valign="top" align="left" width="120"&gt;Nordiska träskyddsrådets klasser&lt;/td&gt;&lt;td valign="top" align="left" width="190"&gt;NTR-klass efter fuktbelastning&lt;/td&gt;&lt;td valign="top" align="left" width="55"&gt;fråga&lt;/td&gt;&lt;td valign="top" align="left" width="40"&gt;nej&lt;/td&gt;&lt;td valign="top" align="left" width="330"&gt;{del} ligger nära mark eller där vatten kan bli stående – NTR A i stället för NTR AB?&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;praxis-frostfritt&lt;/td&gt;&lt;td valign="top" align="left" width="120"&gt;Grundläggningsdjup beror på ort och jordart&lt;/td&gt;&lt;td valign="top" align="left" width="190"&gt;Grundläggning på tjälfritt djup&lt;/td&gt;&lt;td valign="top" align="left" width="55"&gt;fråga&lt;/td&gt;&lt;td valign="top" align="left" width="40"&gt;nej&lt;/td&gt;&lt;td valign="top" align="left" width="330"&gt;Grundläggningsdjup saknas. Står plintarna på tjälfritt djup eller på frostskyddad, packad makadam?&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;praxis-vatrum-branschregler&lt;/td&gt;&lt;td valign="top" align="left" width="120"&gt;Branschreglerna för våtrum (till exempel GVK, BKR, Säker Vatten)&lt;/td&gt;&lt;td valign="top" align="left" width="190"&gt;Våtrum enligt branschregler&lt;/td&gt;&lt;td valign="top" align="left" width="55"&gt;fråga&lt;/td&gt;&lt;td valign="top" align="left" width="40"&gt;nej&lt;/td&gt;&lt;td valign="top" align="left" width="330"&gt;Vilket godkänt tätskiktssystem och vilken branschregel gäller? Fall mot brunn, uppvik och genomföringar ska framgå.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;praxis-betong-exponering&lt;/td&gt;&lt;td valign="top" align="left" width="120"&gt;SS-EN 206 med svenska tillämpningsdokument&lt;/td&gt;&lt;td valign="top" align="left" width="190"&gt;Exponeringsklass på betong&lt;/td&gt;&lt;td valign="top" align="left" width="55"&gt;fråga&lt;/td&gt;&lt;td valign="top" align="left" width="40"&gt;nej&lt;/td&gt;&lt;td valign="top" align="left" width="330"&gt;Betongen saknar exponeringsklass. Ute med frost och tösalt krävs till exempel XF-klass.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;praxis-taklutning&lt;/td&gt;&lt;td valign="top" align="left" width="120"&gt;Tillverkarens anvisning&lt;/td&gt;&lt;td valign="top" align="left" width="190"&gt;Minsta taklutning för vald täckning&lt;/td&gt;&lt;td valign="top" align="left" width="55"&gt;fråga&lt;/td&gt;&lt;td valign="top" align="left" width="40"&gt;nej&lt;/td&gt;&lt;td valign="top" align="left" width="330"&gt;Taklutning {lutning}°: klarar {täckning} den lutningen enligt tillverkaren?&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;praxis-infastning-korrosion&lt;/td&gt;&lt;td valign="top" align="left" width="120"&gt;Korrosivitetsklass och tillverkarens anvisning&lt;/td&gt;&lt;td valign="top" align="left" width="190"&gt;Korrosionsskydd på infästning ute&lt;/td&gt;&lt;td valign="top" align="left" width="55"&gt;fråga&lt;/td&gt;&lt;td valign="top" align="left" width="40"&gt;nej&lt;/td&gt;&lt;td valign="top" align="left" width="330"&gt;Infästning utomhus eller mot tryckimpregnerat: varmförzinkad eller rostfri?&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1"><mxGeometry x="957" y="1526" width="901" height="407" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
