<mxfile host="rmink" agent="docs/diagrams/build.py"><diagram id="09-kunskapsbasens-struktur" name="9. Kunskapsbasens struktur (src/rmink/knowledge/data/*.toml)"><mxGraphModel dx="2210" dy="1190" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" background="#ffffff" pageWidth="2210" pageHeight="1190" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t_1" value="&lt;b&gt;9. Kunskapsbasens struktur (src/rmink/knowledge/data/*.toml)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=22;fontColor=#000000;align=left;verticalAlign=top;spacing=2;" parent="1" vertex="1"><mxGeometry x="40" y="20" width="1400" height="34" as="geometry"/></mxCell><mxCell id="t_2" value="Nio TOML-filer, version 2026-10-28. Pilarna är korsreferenser som testas i tests/test_knowledge_data.py." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#333333;align=left;verticalAlign=top;spacing=2;" parent="1" vertex="1"><mxGeometry x="40" y="56" width="1400" height="22" as="geometry"/></mxCell><mxCell id="terms_3" value="&lt;b&gt;terms.toml&lt;/b&gt;&lt;br&gt;[term] × 160&lt;br&gt;   id, term, abbr, en, cat, syn, ref, def" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=10;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1"><mxGeometry x="40" y="110" width="470" height="61" as="geometry"/></mxCell><mxCell id="drawing_standard_4" value="&lt;b&gt;drawing_standard.toml&lt;/b&gt;&lt;br&gt;[drawing_type] × 9&lt;br&gt;   id, name, en, scales, shows, required, smallhouse&lt;br&gt;[scales]: preferred, note&lt;br&gt;[phase] × 7&lt;br&gt;   id, name, order, meaning&lt;br&gt;[phase_mapping]: Förslag, Granskning, Beslut&lt;br&gt;[revision]: designation, cloud, triangle, table, rmink_mapping&lt;br&gt;[title_block_field] × 11&lt;br&gt;   id, name, required, example&lt;br&gt;[numbering]: pattern, example, n