y></mxCell><mxCell id="e_21" value="drawing_types" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;strokeColor=#888888;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=0;exitY=0.85;exitDx=0;exitDy=0;entryX=1;entryY=0.1;entryDx=0;entryDy=0;" parent="1" edge="1" source="symbols_5" target="drawing_standard_4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_22" value="applies_to: ritningstyp" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;strokeColor=#888888;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=0;exitY=0.7;exitDx=0;exitDy=0;entryX=1;entryY=0.4;entryDx=0;entryDy=0;" parent="1" edge="1" source="rules_6" target="drawing_standard_4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="lookup_knowledge__sorter_i_sökordning_23" value='&lt;b&gt;lookup_knowledge: sorter i sökordning&lt;/b&gt;&lt;table style="border-collapse:collapse;font-size:10px" cellpadding="1" cellspacing="0" border="0"&gt;&lt;tr style="font-weight:bold"&gt;&lt;td valign="top" align="left" width="110"&gt;sort&lt;/td&gt;&lt;td valign="top" align="left" width="200"&gt;fil.tabell&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="110"&gt;material&lt;/td&gt;&lt;td valign="top" align="left" width="200"&gt;materials.material&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="110"&gt;assembly&lt;/td&gt;&lt;td valign="top" align="left" width="200"&gt;assemblies.assembly&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="110"&gt;variant&lt;/td&gt;&lt;td valign="top" align="left" width="200"&gt;assemblies.variant&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="110"&gt;rule&lt;/td&gt;&lt;td valign="top" align="left" width="200"&gt;rules.rule&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="110"&gt;action&lt;/td&gt;&lt;td valign="top" align="left" width="200"&gt;process.action&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="110"&gt;symbol&lt;/td&gt;&lt;td valign="top" align="left" width="200"&gt;symbols.symbol&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="110"&gt;term&lt;/td&gt;&lt;td valign="top" align="left" width="200"&gt;terms.term&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="110"&gt;drawing_type&lt;/td&gt;&lt;td valign="top" align="left" width="200"&gt;drawing_standard.drawing_type&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="110"&gt;role&lt;/td&gt;&lt;td valign="top" align="left" width="200"&gt;process.role&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="110"&gt;hatch&lt;/td&gt;&lt;td valign="top" align="left" width="200"&gt;hatches.hatch&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1"><mxGeometry x="1700" y="400" width="326" height="191" as="geometry"/></mxCell><mxCell id="Så_används_kunskapsbasen_24" value="&lt;b&gt;Så används kunskapsbasen&lt;/b&gt;&lt;br&gt;reference(): en kompakt sammanfattning (≈17 000 tecken) i rundans och MCP:s systemprompt.&lt;br&gt;lookup(fråga, sort): hela poster vid behov; träff i namn, förkortning, synonymer och klasser väger tyngst.&lt;br&gt;Poster byggs ut: regler blir korta sammanfattningar, material får sin skraffering, konstruktioner sina varianter.&lt;br&gt;variant_facts(): tjocklek, vikt per m² och uppskattat U-värde räknas ur skikten.&lt;br&gt;calc: densitet och λ hämtas ur materials.toml för weight() och u_value()." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1"><mxGeometry x="1120" y="760" width="760" height="97" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
