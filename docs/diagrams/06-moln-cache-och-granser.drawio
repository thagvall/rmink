<mxfile host="rmink" agent="docs/diagrams/build.py"><diagram id="06-moln-cache-och-granser" name="6. reMarkable Cloud, cache och gränser"><mxGraphModel dx="1480" dy="697" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1480" pageHeight="697" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t_1" value="&lt;b&gt;6. reMarkable Cloud, cache och gränser&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=22;fontColor=#000000;align=left;verticalAlign=top;spacing=2;" parent="1" vertex="1"><mxGeometry x="40" y="20" width="1400" height="34" as="geometry"/></mxCell><mxCell id="t_2" value="reMarkable Cloud har ingen fråga per mapp: rotindexet listar alla dokument och mappen står i varje dokuments metadata. Därför cachen." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;spacing=2;" parent="1" vertex="1"><mxGeometry x="40" y="56" width="1400" height="22" as="geometry"/></mxCell><mxCell id="c_3" value="&lt;b&gt;cloud.ls / get / put / mkdir / mv&lt;/b&gt;&lt;br&gt;varje anrop kör rmapi en gång" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1"><mxGeometry x="40" y="110" width="250" height="90" as="geometry"/></mxCell><mxCell id="c_4" value="&lt;b&gt;Ägarens token?&lt;/b&gt;&lt;br&gt;= RMINK_CLOUD_TOKEN&lt;br&gt;eller sparad cloud.toml" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=11;align=center;verticalAlign=middle;spacing=6;shape=rhombus;" parent="1" vertex="1"><mxGeometry x="360" y="110" width="240" height="90" as="geometry"/></mxCell><mxCell id="c_5" value="&lt;b&gt;Tillfälligt hem&lt;/b&gt;&lt;br&gt;andras tokens (Send to reMarkable)&lt;br&gt;ny tom katalog per anrop&lt;br&gt;raderas efteråt" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1"><mxGeometry x="360" y="260" width="240" height="100" as="geometry"/></mxCell><mxCell id="c_6" value="&lt;b&gt;Bestående cache&lt;/b&gt;&lt;br&gt;$TMP/rmink-rmapi-cache-&amp;lt;hash&amp;gt;&lt;br&gt;rmapi/tree.cache (≈3,6 MB)&lt;br&gt;rmapi.conf med användartoken&lt;br&gt;fcntl-lås: ett anrop i taget" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1"><mxGeometry x="680" y="110" width="300" height="150" as="geometry"/></mxCell><mxCell id="c_7" value="&lt;b&gt;Vercel Blob&lt;/b&gt;&lt;br&gt;privat: rmink/rmapi-tree-&amp;lt;hash&amp;gt;.json.gz (≈0,8 MB)&lt;br&gt;hämtas när instansen saknar cache&lt;br&gt;laddas upp bara om den ändrats" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1"><mxGeometry x="1060" y="110" width="280" height="150" as="geometry"/></mxCell><mxCell id="e_8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;strokeColor=#555555;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="c_3" target="c_4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_9" value="nej" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;strokeColor=#555555;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="c_4" target="c_5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_10" value="ja" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;strokeColor=#555555;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;" parent="1" edge="1" source="c_4" target="c_6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e_11" value="restore / save" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;strokeColor=#555555;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;dashed=1;" parent="1" edge="1" source="c_6" target="c_7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="rmapi_körning_12" value='&lt;b&gt;rmapi-körning&lt;/b&gt;&lt;table style="border-collapse:collapse;font-size:10px" cellpadding="1" cellspacing="0" border="0"&gt;&lt;tr style="font-weight:bold"&gt;&lt;td valign="top" align="left" width="170"&gt;läge&lt;/td&gt;&lt;td valign="top" align="left" width="70"&gt;samtidiga&lt;/td&gt;&lt;td valign="top" align="left" width="70"&gt;tidsgräns&lt;/td&gt;&lt;td valign="top" align="left" width="290"&gt;kostnad&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="170"&gt;kall (ingen tree.cache)&lt;/td&gt;&lt;td valign="top" align="left" width="70"&gt;6&lt;/td&gt;&lt;td valign="top" align="left" width="70"&gt;270 s&lt;/td&gt;&lt;td valign="top" align="left" width="290"&gt;≈2 900 anrop för ≈1 000 böcker, en gång&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="170"&gt;varm&lt;/td&gt;&lt;td valign="top" align="left" width="70"&gt;2&lt;/td&gt;&lt;td valign="top" align="left" width="70"&gt;90 s&lt;/td&gt;&lt;td valign="top" align="left" width="290"&gt;1 anrop (rotens hash) + det som ändrats&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1"><mxGeometry x="40" y="400" width="616" height="77" as="geometry"/></mxCell><mxCell id="Uppmätta_gränser__X_Ratelimit_Limit__202_13" value='&lt;b&gt;Uppmätta gränser (X-Ratelimit-Limit, 2026-10-29)&lt;/b&gt;&lt;br&gt;&lt;font color="#555555"&gt;Reset 1–12, troligen sekunder; fönstren är inte dokumenterade&lt;/font&gt;&lt;table style="border-collapse:collapse;font-size:10px" cellpadding="1" cellspacing="0" border="0"&gt;&lt;tr style="font-weight:bold"&gt;&lt;td valign="top" align="left" width="210"&gt;endpoint&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;gräns&lt;/td&gt;&lt;td valign="top" align="left" width="260"&gt;används till&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="210"&gt;POST /token/json/2/user/new&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;5&lt;/td&gt;&lt;td valign="top" align="left" width="260"&gt;ny användartoken&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="210"&gt;GET /sync/v4/root&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;30&lt;/td&gt;&lt;td valign="top" align="left" width="260"&gt;rotens hash; här kom 429 2026-10-28&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="210"&gt;GET /sync/v3/files/&amp;lt;hash&amp;gt;&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;48 000&lt;/td&gt;&lt;td valign="top" align="left" width="260"&gt;ett per index och metadata&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#666666;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1"><mxGeometry x="700" y="400" width="546" height="107" as="geometry"/></mxCell><mxCell id="Skydd_14" value='&lt;b&gt;Skydd&lt;/b&gt;&lt;br&gt;/rounds når bara /rmink och det som ligger där: andra sökvägar och .. ger 403 innan rmapi körs.&lt;br&gt;429 ger "wait a few minutes and try again" i stället för rmapis interna fel.&lt;br&gt;Tokens maskeras i felmeddelanden och loggar.&lt;br&gt;Upptäckten: varje rmapi-körning började tidigare med tom cache; en runda gjorde 4–5 sådana.' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1"><mxGeometry x="40" y="560" width="600" height="97" as="geometry"/></mxCell><mxCell id="Sync_1_5_i_korthet_15" value="&lt;b&gt;Sync 1.5 i korthet&lt;/b&gt;&lt;br&gt;1 GET root → hash för rotindexet&lt;br&gt;2 rotindexet: id + hash för alla dokument och mappar (platt lista)&lt;br&gt;3 per dokument: dess index → .metadata (namn, förälder), .content, sidor&lt;br&gt;Skrivning: nya filer + nytt rotindex + ny root (samma för put, mkdir och mv)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#eeeeee;strokeColor=#666666;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1"><mxGeometry x="700" y="560" width="560" height="83" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
