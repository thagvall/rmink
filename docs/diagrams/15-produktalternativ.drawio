<mxfile host="rmink" agent="docs/diagrams/build.py"><diagram id="15-produktalternativ" name="15. Produktalternativ (13 varianter)"><mxGraphModel dx="2040" dy="1349" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2040" pageHeight="1349" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t_1" value="&lt;b&gt;15. Produktalternativ (13 varianter)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=22;fontColor=#000000;align=left;verticalAlign=top;spacing=2;" parent="1" vertex="1"><mxGeometry x="40" y="20" width="1400" height="34" as="geometry"/></mxCell><mxCell id="t_2" value='Svar på "alternativ?" eller "hur tjock?": rundan lägger 2–4 lösningar på en egen sida; användaren skriver bokstaven på SVAR-raden. Tjocklek, vikt och U-värde räknas med variant_facts (λ-värdesmetoden, utan köldbryggor).' style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;spacing=2;" parent="1" vertex="1"><mxGeometry x="40" y="56" width="1400" height="22" as="geometry"/></mxCell><mxCell id="platta_pa_mark_3" value="PL1 Platta på mark med underliggande isolering" style="swimlane;html=1;whiteSpace=wrap;startSize=28;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=13;fontStyle=1;swimlaneFillColor=#ffffff;rounded=1;arcSize=2;collapsible=0;" parent="1" vertex="1"><mxGeometry x="40" y="110" width="1960" height="330" as="geometry"/></mxCell><mxCell id="c_4" value="&lt;b&gt;A  Standard: 100 betong på 300 EPS&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=middle;spacing=6;" parent="platta_pa_mark_3" vertex="1"><mxGeometry x="20" y="36" width="360" height="30" as="geometry"/></mxCell><mxCell id="img_5" value="" style="shape=image;html=1;verticalAlign=top;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" parent="platta_pa_mark_3" vertex="1"><mxGeometry x="36" y="74" width="87" height="240" as="geometry"/></mxCell><mxCell id="c_6" value="tjocklek ≈ 550 mm&lt;br&gt;vikt ≈ 515 kg/m²&lt;br&gt;U ≈ 0,116 W/m²K&lt;br&gt;kostnad: låg&lt;br&gt;när: Vanligt småhus på packad, dränerande mark, utan tunga punktlaster.&lt;br&gt;+ Beprövad och billig&lt;br&gt;+ Lätt att få tag på material och hantverkare&lt;br&gt;− Klarar inte alltid dagens energikrav ensam: följ energiberäkningen&lt;br&gt;skikt: Platsgjuten betong 100, Cellplast EPS 300, Makadam / bergkross 150, Geotextil" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="platta_pa_mark_3" vertex="1"><mxGeometry x="150" y="74" width="230" height="221" as="geometry"/></mxCell><mxCell id="c_7" value="&lt;b&gt;B  Lågenergi: 100 betong på 400 EPS&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=middle;spacing=6;" parent="platta_pa_mark_3" vertex="1"><mxGeometry x="400" y="36" width="360" height="30" as="geometry"/></mxCell><mxCell id="img_8" value="" style="shape=image;html=1;verticalAlign=top;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" parent="platta_pa_mark_3" vertex="1"><mxGeometry x="423" y="74" width="74" height="240" as="geometry"/></mxCell><mxCell id="c_9" value="tjocklek ≈ 650 mm&lt;br&gt;vikt ≈ 517 kg/m²&lt;br&gt;U ≈ 0,083 W/m²K&lt;br&gt;kostnad: medel&lt;br&gt;när: När energiberäkningen kräver lägre U-värde, eller för golvvärme.&lt;br&gt;+ Lägre värmeförlust genom golvet&lt;br&gt;+ Samma arbetssätt som standard&lt;br&gt;− Djupare schakt och mer fyllning&lt;br&gt;− Mer material&lt;br&gt;skikt: Platsgjuten betong 100, Cellplast EPS 400, Makadam / bergkross 150, Geotextil" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="platta_pa_mark_3" vertex="1"><mxGeometry x="530" y="74" width="230" height="207" as="geometry"/></mxCell><mxCell id="c_10" value="&lt;b&gt;C  Förstärkt: 150 betong på 300 EPS 200&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=middle;spacing=6;" parent="platta_pa_mark_3" vertex="1"><mxGeometry x="780" y="36" width="360" height="30" as="geometry"/></mxCell><mxCell id="img_11" value="" style="shape=image;html=1;verticalAlign=top;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" parent="platta_pa_mark_3" vertex="1"><mxGeometry x="800" y="74" width="80" height="240" as="geometry"/></mxCell><mxCell id="c_12" value="tjocklek ≈ 600 mm&lt;br&gt;vikt ≈ 635 kg/m²&lt;br&gt;U ≈ 0,109 W/m²K&lt;br&gt;kostnad: medel&lt;br&gt;när: Punktlaster eller tunga innerväggar på plattan (bärande vägg, kakelugn, murad spis).&lt;br&gt;+ Bär mer och sprider lasten&lt;br&gt;+ Stabilare mot sprickor&lt;br&gt;− Mer betong och armering&lt;br&gt;skikt: Platsgjuten betong 150, Cellplast EPS 300, Makadam / bergkross 150, Geotextil" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="platta_pa_mark_3" vertex="1"><mxGeometry x="910" y="74" width="230" height="193" as="geometry"/></mxCell><mxCell id="c_13" value="&lt;b&gt;D  XPS: 100 betong på 300 XPS&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=middle;spacing=6;" parent="platta_pa_mark_3" vertex="1"><mxGeometry x="1160" y="36" width="360" height="30" as="geometry"/></mxCell><mxCell id="img_14" value="" style="shape=image;html=1;verticalAlign=top;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" parent="platta_pa_mark_3" vertex="1"><mxGeometry x="1176" y="74" width="87" height="240" as="geometry"/></mxCell><mxCell id="c_15" value="tjocklek ≈ 550 mm&lt;br&gt;vikt ≈ 520 kg/m²&lt;br&gt;U ≈ 0,11 W/m²K&lt;br&gt;kostnad: hög&lt;br&gt;när: Hög grundvattennivå, fuktig mark eller höga laster på isoleringen.&lt;br&gt;+ Tar upp mycket lite vatten&lt;br&gt;+ Tål högt tryck&lt;br&gt;− Dyrare per m² än EPS&lt;br&gt;− Ungefär samma U-värde som EPS vid samma tjocklek&lt;br&gt;skikt: Platsgjuten betong 100, Cellplast XPS 300, Makadam / bergkross 150, Geotextil" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="platta_pa_mark_3" vertex="1"><mxGeometry x="1290" y="74" width="230" height="221" as="geometry"/></mxCell><mxCell id="c_16" value="&lt;b&gt;E  Skumglas: 100 betong på 400 skumglas&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=middle;spacing=6;" parent="platta_pa_mark_3" vertex="1"><mxGeometry x="1540" y="36" width="360" height="30" as="geometry"/></mxCell><mxCell id="img_17" value="" style="shape=image;html=1;verticalAlign=top;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" parent="platta_pa_mark_3" vertex="1"><mxGeometry x="1552" y="74" width="96" height="240" as="geometry"/></mxCell><mxCell id="c_18" value="tjocklek ≈ 500 mm&lt;br&gt;vikt ≈ 340 kg/m²&lt;br&gt;U ≈ 0,214 W/m²K&lt;br&gt;kostnad: medel&lt;br&gt;när: Lös eller fuktig mark, eller när isolering, dränering och kapillärbrytning ska vara ett lager.&lt;br&gt;+ Ett lager i stället för makadam och cellplast&lt;br&gt;+ Dränerar och bryter kapillärt&lt;br&gt;+ Obrännbart&lt;br&gt;− Tjockare för samma U-värde&lt;br&gt;− Måste packas rätt; leverantörens anvisning gäller&lt;br&gt;skikt: Platsgjuten betong 100, Skumglas 400, Geotextil" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="platta_pa_mark_3" vertex="1"><mxGeometry x="1670" y="74" width="230" height="235" as="geometry"/></mxCell><mxCell id="yv_tra_19" value="YV1 Yttervägg, träregelstomme med luftad panel" style="swimlane;html=1;whiteSpace=wrap;startSize=28;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=13;fontStyle=1;swimlaneFillColor=#ffffff;rounded=1;arcSize=2;collapsible=0;" parent="1" vertex="1"><mxGeometry x="40" y="470" width="1580" height="352" as="geometry"/></mxCell><mxCell id="c_20" value="&lt;b&gt;A  Standard: 195 + 45 mineralull&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=middle;spacing=6;" parent="yv_tra_19" vertex="1"><mxGeometry x="20" y="36" width="360" height="30" as="geometry"/></mxCell><mxCell id="img_21" value="" style="shape=image;html=1;verticalAlign=top;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" parent="yv_tra_19" vertex="1"><mxGeometry x="37" y="74" width="87" height="240" as="geometry"/></mxCell><mxCell id="c_22" value="tjocklek ≈ 312 mm&lt;br&gt;vikt ≈ 56 kg/m²&lt;br&gt;U ≈ 0,183 W/m²K&lt;br&gt;kostnad: låg&lt;br&gt;när: Vanlig yttervägg i ett småhus eller en tillbyggnad.&lt;br&gt;+ Beprövad&lt;br&gt;+ Installationsskikt skyddar ångspärren&lt;br&gt;− Reglarna ger köldbryggor genom isoleringen&lt;br&gt;skikt: Träpanel 22, Läkt och glespanel 28, Utvändig gipsskiva 9,5, Konstruktionsvirke 195, Mineralull 195, Ångspärr / ångbroms, Konstruktionsvirke 45, Mineralull 45, Gipsskiva normal 12,5" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="yv_tra_19" vertex="1"><mxGeometry x="150" y="74" width="230" height="249" as="geometry"/></mxCell><mxCell id="c_23" value="&lt;b&gt;B  Tjockare: 220 + 70 mineralull&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=middle;spacing=6;" parent="yv_tra_19" vertex="1"><mxGeometry x="400" y="36" width="360" height="30" as="geometry"/></mxCell><mxCell id="img_24" value="" style="shape=image;html=1;verticalAlign=top;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" parent="yv_tra_19" vertex="1"><mxGeometry x="423" y="74" width="74" height="240" as="geometry"/></mxCell><mxCell id="c_25" value="tjocklek ≈ 362 mm&lt;br&gt;vikt ≈ 60 kg/m²&lt;br&gt;U ≈ 0,153 W/m²K&lt;br&gt;kostnad: medel&lt;br&gt;när: När energiberäkningen kräver lägre U-värde.&lt;br&gt;+ Lägre U-värde med samma byggsätt&lt;br&gt;− Tjockare vägg tar golvyta&lt;br&gt;− Djupare fönstersmygar&lt;br&gt;skikt: Träpanel 22, Läkt och glespanel 28, Utvändig gipsskiva 9,5, Konstruktionsvirke 220, Mineralull 220, Ångspärr / ångbroms, Konstruktionsvirke 70, Mineralull 70, Gipsskiva normal 12,5" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="yv_tra_19" vertex="1"><mxGeometry x="530" y="74" width="230" height="221" as="geometry"/></mxCell><mxCell id="c_26" value="&lt;b&gt;C  Utvändig isolering: 50 mineralull utanpå 170&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=middle;spacing=6;" parent="yv_tra_19" vertex="1"><mxGeometry x="780" y="36" width="360" height="30" as="geometry"/></mxCell><mxCell id="img_27" value="" style="shape=image;html=1;verticalAlign=top;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" parent="yv_tra_19" vertex="1"><mxGeometry x="796" y="74" width="89" height="240" as="geometry"/></mxCell><mxCell id="c_28" value="tjocklek ≈ 327,5 mm&lt;br&gt;vikt ≈ 49 kg/m²&lt;br&gt;U ≈ 0,156 W/m²K&lt;br&gt;kostnad: medel&lt;br&gt;när: För att bryta köldbryggorna från reglarna.&lt;br&gt;+ Hel isolering utanför stommen bryter köldbryggor&lt;br&gt;+ Varmare och torrare stomme&lt;br&gt;− Fasadskivan kräver rätt infästning av läkt&lt;br&gt;− Dyrare än vindskyddsgips&lt;br&gt;skikt: Träpanel 22, Läkt och glespanel 28, Mineralull 50, Konstruktionsvirke 170, Mineralull 170, Ångspärr / ångbroms, Konstruktionsvirke 45, Mineralull 45, Gipsskiva normal 12,5" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="yv_tra_19" vertex="1"><mxGeometry x="910" y="74" width="230" height="262" as="geometry"/></mxCell><mxCell id="c_29" value="&lt;b&gt;D  PIR invändigt: 170 mineralull + 50 PIR&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=middle;spacing=6;" parent="yv_tra_19" vertex="1"><mxGeometry x="1160" y="36" width="360" height="30" as="geometry"/></mxCell><mxCell id="img_30" value="" style="shape=image;html=1;verticalAlign=top;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" parent="yv_tra_19" vertex="1"><mxGeometry x="1168" y="74" width="105" height="240" as="geometry"/></mxCell><mxCell id="c_31" value="tjocklek ≈ 292 mm&lt;br&gt;vikt ≈ 53 kg/m²&lt;br&gt;U ≈ 0,161 W/m²K&lt;br&gt;kostnad: hög&lt;br&gt;när: När väggen måste vara tunn, t.ex. vid tilläggsisolering inifrån.&lt;br&gt;+ Lågt U-värde i tunn vägg&lt;br&gt;+ Folierad PIR med tejpade skarvar är ångspärr&lt;br&gt;− Dyrare&lt;br&gt;− Skarvar och genomföringar måste tejpas noga&lt;br&gt;skikt: Träpanel 22, Läkt och glespanel 28, Utvändig gipsskiva 9,5, Konstruktionsvirke 170, Mineralull 170, PIR/PUR-skiva 50, Gipsskiva normal 12,5" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="yv_tra_19" vertex="1"><mxGeometry x="1290" y="74" width="230" height="262" as="geometry"/></mxCell><mxCell id="altan_plint_32" value="ALT1 Altan på plintar (upphöjd)" style="swimlane;html=1;whiteSpace=wrap;startSize=28;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=13;fontStyle=1;swimlaneFillColor=#ffffff;rounded=1;arcSize=2;collapsible=0;" parent="1" vertex="1"><mxGeometry x="40" y="852" width="1580" height="330" as="geometry"/></mxCell><mxCell id="c_33" value="&lt;b&gt;A  Tryckimpregnerad trall NTR AB&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=middle;spacing=6;" parent="altan_plint_32" vertex="1"><mxGeometry x="20" y="36" width="360" height="30" as="geometry"/></mxCell><mxCell id="img_34" value="" style="shape=image;html=1;verticalAlign=top;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" parent="altan_plint_32" vertex="1"><mxGeometry x="54" y="74" width="52" height="240" as="geometry"/></mxCell><mxCell id="c_35" value="tjocklek ≈ 943 mm&lt;br&gt;vikt ≈ 1612 kg/m²&lt;br&gt;kostnad: låg&lt;br&gt;när: Det vanligaste valet för en altan som ska hålla länge till lågt pris.&lt;br&gt;+ Billig och lätt att få tag på&lt;br&gt;+ Tål röta&lt;br&gt;− Spricker och kupar sig utan underhåll&lt;br&gt;− Kemiskt skyddsmedel: spill och kap ska tas om hand&lt;br&gt;skikt: Trall 28, Tryckimpregnerat virke 145, Tryckimpregnerat virke 170, Plint 600" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="altan_plint_32" vertex="1"><mxGeometry x="150" y="74" width="230" height="221" as="geometry"/></mxCell><mxCell id="c_36" value="&lt;b&gt;B  Värmebehandlad trall&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=middle;spacing=6;" parent="altan_plint_32" vertex="1"><mxGeometry x="400" y="36" width="360" height="30" as="geometry"/></mxCell><mxCell id="img_37" value="" style="shape=image;html=1;verticalAlign=top;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" parent="altan_plint_32" vertex="1"><mxGeometry x="434" y="74" width="52" height="240" as="geometry"/></mxCell><mxCell id="c_38" value="tjocklek ≈ 941 mm&lt;br&gt;vikt ≈ 1610 kg/m²&lt;br&gt;kostnad: medel&lt;br&gt;när: När man vill undvika kemiskt impregnerat virke men ha god formstabilitet.&lt;br&gt;+ Utan skyddsmedel&lt;br&gt;+ Formstabil, slår sig mindre&lt;br&gt;− Sprödare: förborra vid ändar&lt;br&gt;− Grånar utan oljning&lt;br&gt;skikt: Trall 26, Tryckimpregnerat virke 145, Tryckimpregnerat virke 170, Plint 600" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="altan_plint_32" vertex="1"><mxGeometry x="530" y="74" width="230" height="193" as="geometry"/></mxCell><mxCell id="c_39" value="&lt;b&gt;C  Lärktrall&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=middle;spacing=6;" parent="altan_plint_32" vertex="1"><mxGeometry x="780" y="36" width="360" height="30" as="geometry"/></mxCell><mxCell id="img_40" value="" style="shape=image;html=1;verticalAlign=top;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" parent="altan_plint_32" vertex="1"><mxGeometry x="814" y="74" width="52" height="240" as="geometry"/></mxCell><mxCell id="c_41" value="tjocklek ≈ 943 mm&lt;br&gt;vikt ≈ 1612 kg/m²&lt;br&gt;kostnad: medel&lt;br&gt;när: Ett naturligt trä som tål väder bra, för den som gillar att det grånar.&lt;br&gt;+ Naturligt beständig kärnved&lt;br&gt;+ Utan skyddsmedel&lt;br&gt;− Kan spricka och kåda&lt;br&gt;− Kräver rostfria skruvar (A4)&lt;br&gt;skikt: Trall 28, Tryckimpregnerat virke 145, Tryckimpregnerat virke 170, Plint 600" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="altan_plint_32" vertex="1"><mxGeometry x="910" y="74" width="230" height="193" as="geometry"/></mxCell><mxCell id="c_42" value="&lt;b&gt;D  Komposittrall&lt;/b&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=middle;spacing=6;" parent="altan_plint_32" vertex="1"><mxGeometry x="1160" y="36" width="360" height="30" as="geometry"/></mxCell><mxCell id="img_43" value="" style="shape=image;html=1;verticalAlign=top;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" parent="altan_plint_32" vertex="1"><mxGeometry x="1194" y="74" width="52" height="240" as="geometry"/></mxCell><mxCell id="c_44" value="tjocklek ≈ 940 mm&lt;br&gt;vikt ≈ 1610 kg/m²&lt;br&gt;kostnad: hög&lt;br&gt;när: När altanen ska klara sig nästan utan underhåll.&lt;br&gt;+ Inget oljande, spricker inte&lt;br&gt;+ Jämn färg&lt;br&gt;− Blir varm i sol och rör sig med temperaturen&lt;br&gt;− Kräver tätare reglar enligt tillverkaren, ofta c400&lt;br&gt;skikt: Trall 25, Tryckimpregnerat virke 145, Tryckimpregnerat virke 170, Plint 600" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="altan_plint_32" vertex="1"><mxGeometry x="1290" y="74" width="230" height="207" as="geometry"/></mxCell><mxCell id="Från_val_till_ritning_45" value='&lt;b&gt;Från val till ritning&lt;/b&gt;&lt;br&gt;1 Användaren skriver "alternativ?" vid en byggdel.&lt;br&gt;2 lookup_knowledge ger konstruktionens varianter som färdiga Option-poster.&lt;br&gt;3 render_alternatives ritar sidan ALTERNATIV · &amp;lt;namn&amp;gt;: snitt, fakta, för- och nackdelar.&lt;br&gt;4 Användaren skriver bokstaven på anmärkningens SVAR-rad.&lt;br&gt;5 Nästa varv sätter chosen och ritar in det valda alternativets skikt.' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1"><mxGeometry x="40" y="1212" width="900" height="97" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
