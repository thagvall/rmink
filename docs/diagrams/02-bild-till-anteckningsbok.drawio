<mxfile host="rmink" agent="docs/diagrams/build.py"><diagram id="02-bild-till-anteckningsbok" name="2. Bild eller PDF → redigerbar anteckningsbok"><mxGraphModel dx="1480" dy="734" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1480" pageHeight="734" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t_1" value="&lt;b&gt;2. Bild eller PDF → redigerbar anteckningsbok&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=22;fontColor=#000000;align=left;verticalAlign=top;spacing=2;" parent="1" vertex="1"><mxGeometry x="40" y="20" width="1400" height="34" as="geometry"/></mxCell><mxCell id="t_2" value="api.render / api.convert, samma kod för CLI, MCP och webben. Resultatet är riktiga pennstreck, inte en bild." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;spacing=2;" parent="1" vertex="1"><mxGeometry x="40" y="56" width="1400" height="22" as="geometry"/></mxCell><mxCell id="0_Inställningar_3" value="&lt;b&gt;0 Inställningar&lt;/b&gt;&lt;br&gt;options.ConvertOptions&lt;br&gt;läge: auto, vector, centerline, outline&lt;br&gt;fyllning: hatch, outline, none&lt;br&gt;penna: fineliner, ballpoint, marker, pencil&lt;br&gt;färger, bredd, marginal, sidor, punktbudget" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1"><mxGeometry x="40" y="110" width="250" height="138" as="geometry"/></mxCell><mxCell id="1_Enhet_4" value="&lt;b&gt;1 Enhet&lt;/b&gt;&lt;br&gt;devices.get_device&lt;br&gt;storlek, dpi, färg eller gråskala&lt;br&gt;egna profiler i devices.toml" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1"><mxGeometry x="350" y="110" width="250" height="138" as="geometry"/></mxCell><mxCell id="e_5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;strokeColor=#555555;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="0_Inställningar_3" target="1_Enhet_4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="2_Läs_in__ingest__6" value="&lt;b&gt;2 Läs in (ingest)&lt;/b&gt;&lt;br&gt;pdf.py: vektor eller raster per sida&lt;br&gt;svg.py: former, fyllning, streck&lt;br&gt;image.py: PNG, JPEG, HEIC" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1"><mxGeometry x="660" y="110" width="250" height="138" as="geometry"/></mxCell><mxCell id="e_7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;strokeColor=#555555;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="1_Enhet_4" target="2_Läs_in__ingest__6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="3_Placera_8" value="&lt;b&gt;3 Placera&lt;/b&gt;&lt;br&gt;geometry/transform.place&lt;br&gt;skala och marginal efter Fit" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1"><mxGeometry x="970" y="110" width="250" height="138" as="geometry"/></mxCell><mxCell id="e_9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;strokeColor=#555555;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="2_Läs_in__ingest__6" target="3_Placera_8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="4_Extrahera_10" value="&lt;b&gt;4 Extrahera&lt;/b&gt;&lt;br&gt;vektor: konturer + skraffering, palettfärger, RDP&lt;br&gt;raster: tröskel, färglager,&lt;br&gt;tunna delar → centerlinje (skelett)&lt;br&gt;tjocka delar → kontur + skraffering" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1"><mxGeometry x="40" y="298" width="250" height="97" as="geometry"/></mxCell><mxCell id="e_11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;strokeColor=#555555;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" edge="1" source="3_Placera_8" target="4_Extrahera_10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="4b_Skuggning_12" value="&lt;b&gt;4b Skuggning&lt;/b&gt;&lt;br&gt;stilar: none, stipple, halftone, hatch, crosshatch, pencil&lt;br&gt;tonkarta → streck inom punktbudgeten" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1"><mxGeometry x="350" y="298" width="250" height="97" as="geometry"/></mxCell><mxCell id="e_13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;fontFamily=Helvetica;fontSize=10;strokeColor=#555555;endArrow=block;endFill=1;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" edge="1" source="4_Extrahera_10" target="4b_Skuggning_12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="5_Ordning_och_budget_14" value="&lt;b&gt;5 Ordning och budget&lt;/b&gt;&lt;br&gt;läsordning, max antal punkter, förenkling" style="rounded=1;arcSize=6;whiteSpac