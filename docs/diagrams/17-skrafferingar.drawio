<mxfile host="rmink" agent="docs/diagrams/build.py"><diagram id="17-skrafferingar" name="17. Skrafferingar (12 st)"><mxGraphModel dx="1740" dy="694" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1740" pageHeight="694" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t_1" value="&lt;b&gt;17. Skrafferingar (12 st)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=22;fontColor=#000000;align=left;verticalAlign=top;spacing=2;" parent="1" vertex="1"><mxGeometry x="40" y="20" width="1400" height="34" as="geometry"/></mxCell><mxCell id="t_2" value="Mönstren ritade med samma kod som alternativsidan (render._hatch). Avstånd i mm på papper; tomma mönster visas bara som kontur." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#555555;align=left;verticalAlign=top;spacing=2;" parent="1" vertex="1"><mxGeometry x="40" y="56" width="1400" height="22" as="geometry"/></mxCell><mxCell id="betong_3" value="" style="shape=image;html=1;verticalAlign=top;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" parent="1" vertex="1"><mxGeometry x="40" y="110" width="110" height="110" as="geometry"/></mxCell><mxCell id="betong_t_4" value="&lt;b&gt;Betong (snitt)&lt;/b&gt;&lt;br&gt;id betong · mönster lines_dots · vinkel 45° · avstånd 3 mm&lt;br&gt;används för: Platsgjuten betong, Prefabricerad betong, Plint (betong, prefab eller gjuten)&lt;br&gt;Diagonala linjer med punkter emellan. Armerad betong får samma mönster; armeringen redovisas separat." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontFamily=Helvetica;fontSize=10;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1"><mxGeometry x="160" y="110" width="420" height="124" as="geometry"/></mxCell><mxCell id="murverk_5" value="" style="shape=image;html=1;verticalAlign=top;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" parent="1" vertex="1"><mxGeometry x="600" y="110" width="110" height="110" as="geometry"/></mxCell><mxCell id="murverk_t_6" value="&lt;b&gt;Murverk, tegel och block&lt;/b&gt;&lt;br&gt;id murverk · mönster lines · vinkel 45° · avstånd 1,5 mm&lt;br&gt;används för: Tegel, Lättbetong (block), Lättklinkerblock&lt;br&gt;Täta 45°-linjer. Lättbetong kan skiljas med glesare linjer (3 mm) och en anteckning." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontFamily=Helvetica;fontSize=10;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1"><mxGeometry x="720" y="110" width="420" height="124" as="geometry"/></mxCell><mxCell id="tra_snitt_7" value="" style="shape=image;html=1;verticalAlign=top;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" parent="1" vertex="1"><mxGeometry x="1160" y="110" width="110" height="110" as="geometry"/></mxCell><mxCell id="tra_snitt_t_8" value="&lt;b&gt;Trä i snitt (tvärs fibrerna)&lt;/b&gt;&lt;br&gt;id tra_snitt · mönster cross · vinkel 45° · avstånd 0 mm&lt;br&gt;används för: Konstruktionsvirke (hållfasthetssorterat), Limträ, Tryckimpregnerat virke, Trall (golvbrädor utomhus)&lt;br&gt;också (via material): Läkt och glespanel&lt;br&gt;Ett kryss (två diagonaler) i varje snittad regel eller bjälke. I detaljskala 1:5 och 1:1 kan årsringar ritas i stället." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontFamily=Helvetica;fontSize=10;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1"><mxGeometry x="1280" y="110" width="420" height="124" as="geometry"/></mxCell><mxCell id="tra_langs_9" value="" style="shape=image;html=1;verticalAlign=top;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" parent="1" vertex="1"><mxGeometry x="40" y="250" width="110" height="110" as="geometry"/></mxCell><mxCell id="tra_langs_t_10" value="&lt;b&gt;Trä i längdsnitt&lt;/b&gt;&lt;br&gt;id tra_langs · mönster grain · vinkel 0° · avstånd 2 mm&lt;br&gt;används för: Konstruktionsvirke (hållfasthetssorterat), Limträ, KL-trä (korslimmat trä), LVL (fanerträ)&lt;br&gt;också (via material): Råspont (underlagstak)&lt;br&gt;Svagt vågiga linjer längs fibrerna. Används mest i 1:5–1:1." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontFamily=Helvetica;fontSize=10;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1"><mxGeometry x="160" y="250" width="420" height="124" as="geometry"/></mxCell><mxCell id="isolering_mjuk_11" value="" style="shape=image;html=1;verticalAlign=top;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" parent="1" vertex="1"><mxGeometry x="600" y="250" width="110" height="110" as="geometry"/></mxCell><mxCell id="isolering_mjuk_t_12" value="&lt;b&gt;Mjuk isolering (mineralull)&lt;/b&gt;&lt;br&gt;id isolering_mjuk · mönster wave · vinkel 0° · avstånd 0 mm&lt;br&gt;används för: Mineralull (glas- eller stenull)&lt;br&gt;En sammanhängande zick-zack- eller våglinje som fyller tjockleken." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontFamily=Helvetica;fontSize=10;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1"><mxGeometry x="720" y="250" width="420" height="124" as="geometry"/></mxCell><mxCell id="isolering_hard_13" value="" style="shape=image;html=1;verticalAlign=top;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" parent="1" vertex="1"><mxGeometry x="1160" y="250" width="110" height="110" as="geometry"/></mxCell><mxCell id="isolering_hard_t_14" value="&lt;b&gt;Hård isolering (cellplast EPS/XPS/PIR)&lt;/b&gt;&lt;br&gt;id isolering_hard · mönster cross · vinkel 45° · avstånd 4 mm&lt;br&gt;används för: Cellplast EPS, Cellplast XPS, PIR/PUR-skiva&lt;br&gt;Glesa korslinjer. Skriv alltid produkttyp (EPS 100/EPS 200, XPS) i texten." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontFamily=Helvetica;fontSize=10;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1"><mxGeometry x="1280" y="250" width="420" height="124" as="geometry"/></mxCell><mxCell id="skiva_15" value="" style="shape=image;html=1;verticalAlign=top;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" parent="1" vertex="1"><mxGeometry x="40" y="390" width="110" height="110" as="geometry"/></mxCell><mxCell id="skiva_t_16" value="&lt;b&gt;Skivmaterial (gips, OSB, plywood, spånskiva)&lt;/b&gt;&lt;br&gt;id skiva · mönster blank · vinkel 0° · avstånd 0 mm&lt;br&gt;används för: Gipsskiva normal (typ A), Gipsskiva brand (typ F / DF), Gipsskiva fuktbeständig (typ H), Utvändig gipsskiva (vindskydd), OSB-skiva, Plywood, Spånskiva (golv), Våtrumsskiva (cementbaserad eller cellplast)&lt;br&gt;också (via material): Träpanel (fasad och inomhus)&lt;br&gt;Tunna skikt ritas som två parallella linjer utan fyllning. Typen anges i text, till exempel 'GN 13' eller 'OSB/3 12'." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontFamily=Helvetica;fontSize=10;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1"><mxGeometry x="160" y="390" width="420" height="124" as="geometry"/></mxCell><mxCell id="stal_17" value="" style="shape=image;html=1;verticalAlign=top;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" parent="1" vertex="1"><mxGeometry x="600" y="390" width="110" height="110" as="geometry"/></mxCell><mxCell id="stal_t_18" value="&lt;b&gt;Stål i snitt&lt;/b&gt;&lt;br&gt;id stal · mönster solid · vinkel 0° · avstånd 0 mm&lt;br&gt;används för: Stålprofil, Armering&lt;br&gt;också (via material): Infästning (spik, skruv, beslag)&lt;br&gt;Svärtas helt. Små profiler i 1:20 och mindre skala ritas som en fet linje." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontFamily=Helvetica;fontSize=10;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1"><mxGeometry x="720" y="390" width="420" height="124" as="geometry"/></mxCell><mxCell id="mark_fyllning_19" value="" style="shape=image;html=1;verticalAlign=top;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" parent="1" vertex="1"><mxGeometry x="1160" y="390" width="110" height="110" as="geometry"/></mxCell><mxCell id="mark_fyllning_t_20" value="&lt;b&gt;Fyllning (makadam, grus)&lt;/b&gt;&lt;br&gt;id mark_fyllning · mönster dots · vinkel 0° · avstånd 2,5 mm&lt;br&gt;används för: Makadam / bergkross&lt;br&gt;också (via material): Skumglas (cellglasgranulat)&lt;br&gt;Oregelbundna punkter eller små cirklar. Fraktion anges i text (till exempel 'makadam 16–32')." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontFamily=Helvetica;fontSize=10;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1"><mxGeometry x="1280" y="390" width="420" height="124" as="geometry"/></mxCell><mxCell id="mark_orord_21" value="" style="shape=image;html=1;verticalAlign=top;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" parent="1" vertex="1"><mxGeometry x="40" y="530" width="110" height="110" as="geometry"/></mxCell><mxCell id="mark_orord_t_22" value="&lt;b&gt;Orörd mark / naturlig jord&lt;/b&gt;&lt;br&gt;id mark_orord · mönster earth · vinkel 45° · avstånd 4 mm&lt;br&gt;används för: Befintlig mark&lt;br&gt;Korta snedstreck i grupper längs marklinjen. Fyll inte hela ytan." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontFamily=Helvetica;fontSize=10;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1"><mxGeometry x="160" y="530" width="420" height="124" as="geometry"/></mxCell><mxCell id="tatskikt_23" value="" style="shape=image;html=1;verticalAlign=top;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" parent="1" vertex="1"><mxGeometry x="600" y="530" width="110" height="110" as="geometry"/></mxCell><mxCell id="tatskikt_t_24" value="&lt;b&gt;Folie, tätskikt, papp&lt;/b&gt;&lt;br&gt;id tatskikt · mönster blank · vinkel 0° · avstånd 0 mm&lt;br&gt;används för: Ångspärr / ångbroms, Fuktspärr / kapillärbrytning, Tätskikt i våtrum, Takpapp / underlagspapp, Underlagsduk (tak), Geotextil (markduk), Vindskyddsduk&lt;br&gt;också (via material): Takplåt, Takpannor&lt;br&gt;Streckad eller tunn heldragen linje med text. Ritas utan tjocklek i 1:20–1:50." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontFamily=Helvetica;fontSize=10;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1"><mxGeometry x="720" y="530" width="420" height="124" as="geometry"/></mxCell><mxCell id="glas_25" value="" style="shape=image;html=1;verticalAlign=top;imageAspect=1;aspect=fixed;image=data:image/svg+xml,;" parent="1" vertex="1"><mxGeometry x="1160" y="530" width="110" height="110" as="geometry"/></mxCell><mxCell id="glas_t_26" value="&lt;b&gt;Glas&lt;/b&gt;&lt;br&gt;id glas · mönster blank · vinkel 0° · avstånd 0 mm&lt;br&gt;används för: Glas&lt;br&gt;Tunn dubbellinje. I plan: fönster som tre parallella linjer i väggöppningen." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;fontFamily=Helvetica;fontSize=10;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1"><mxGeometry x="1280" y="530" width="420" height="124" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
