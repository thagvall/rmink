<mxfile host="rmink" agent="docs/diagrams/build.py"><diagram id="19-begrepp" name="19. Begrepp och förkortningar (160 st)"><mxGraphModel dx="1608" dy="1894" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" background="#ffffff" pageWidth="1608" pageHeight="1894" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t_1" value="&lt;b&gt;19. Begrepp och förkortningar (160 st)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=22;fontColor=#000000;align=left;verticalAlign=top;spacing=2;" parent="1" vertex="1"><mxGeometry x="40" y="20" width="1400" height="34" as="geometry"/></mxCell><mxCell id="t_2" value="Hur Claude läser handskrivna ord och förkortningar. Hänvisning = id i material, konstruktion, regel, ritstandard eller process." style="text;html=1;whiteSpace=wrap;fontFamily=Helvetica;fontSize=12;fontColor=#333333;align=left;verticalAlign=top;spacing=2;" parent="1" vertex="1"><mxGeometry x="40" y="56" width="1400" height="22" as="geometry"/></mxCell><mxCell id="ritning_3" value='&lt;b&gt;Ritning (15)&lt;/b&gt;&lt;table style="border-collapse:collapse;font-size:10px" cellpadding="1" cellspacing="0" border="0"&gt;&lt;tr style="font-weight:bold"&gt;&lt;td valign="top" align="left" width="150"&gt;begrepp&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;förk.&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;hänvisning&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;betydelse&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Planritning&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;PLAN&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;planritning&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Våningsplan sett ovanifrån, snittat ca 1 m över golv.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Sektion&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;SEKT&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;sektion&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Vertikalt snitt genom byggnaden längs en markerad snittlinje.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Fasad&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;FAS&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;fasad&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Byggnaden sedd utifrån, namnges efter väderstreck (Fasad mot söder).&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Detalj&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;DET&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;detalj&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Förstorat utsnitt som visar skikt och infästning.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Situationsplan&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;SITU&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;situationsplan&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Tomten med byggnadens placering och mått till gräns.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Ritningshuvud&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;ritningshuvud&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Rutan nere till höger med projekt, innehåll, nummer, skala, datum, skede och revision.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Ritningsnummer&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;RITN NR&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;ritningsnummer&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Unik beteckning för ritningen, ofta disciplin + typ + löpnummer.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Skala&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;SKALA&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;skala&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Förhållandet mellan ritad och verklig längd.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Norrpil&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;N&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;norrpil&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Pil som visar norr på plan och situationsplan.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Snittlinje / sektionsmarkering&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;A-A&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;sektion&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Linje i plan som visar var sektionen är tagen och åt vilket håll man ser.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Förklaringar / teckenförklaring&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;forklaring&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Lista som förklarar symboler, linjetyper och skrafferingar.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Typlista&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Förteckning över väggtyper, bjälklagstyper med mera, som ritningen hänvisar till med kod.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Revision&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;REV&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;revision&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Utgåva av ritningen efter ändring; markeras med bokstav eller nummer.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Ändringsmoln&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;revision&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Molnformad ring runt det som ändrats sedan förra revisionen.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Skraffering&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Mönster i snittade ytor som visar material.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1"><mxGeometry x="40" y="110" width="756" height="314" as="geometry"/></mxCell><mxCell id="process_4" value='&lt;b&gt;Process och lov (28)&lt;/b&gt;&lt;table style="border-collapse:collapse;font-size:10px" cellpadding="1" cellspacing="0" border="0"&gt;&lt;tr style="font-weight:bold"&gt;&lt;td valign="top" align="left" width="150"&gt;begrepp&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;förk.&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;hänvisning&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;betydelse&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Skede / handlingsstatus&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;skede&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Vilken användning ritningen är utgiven för (granskning, bygglov, bygghandling).&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Bygglovshandling&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;BL&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;bygglovshandling&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Ritningar som lämnas till kommunen för lov eller anmälan.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Bygghandling&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;BH&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;bygghandling&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Ritning som gäller för utförandet.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Relationshandling&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;REL&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;relationshandling&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Ritning som visar hur det faktiskt byggdes.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Förfrågningsunderlag&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;FU&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;forfragningsunderlag&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Handlingar som entreprenörer räknar anbud på.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Teknisk beskrivning&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;TB&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Text som anger material och utförande. Hänvisar ofta till AMA-koder.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;AMA (Allmän material- och arbetsbeskrivning)&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;AMA&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Branschgemensamt referensverk (Svensk Byggtjänst). Blir bindande först när en kod åberopas i beskrivningen.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Kontrollplan&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;KP&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Plan för vilka kontroller som görs, av vem och hur de dokumenteras.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Granskning&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Genomgång av handlingen mot krav och andra handlingar; ger anmärkningar.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Anmärkning&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;ANM&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;En punkt från granskning som ska besvaras eller åtgärdas.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Svar&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;SVAR&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Rad under en anmärkning där den som ritar svarar.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Bygglov&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;BL&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;bygglov&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Kommunens prövning av en åtgärd enligt PBL 9 kap.; följs av startbesked.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Anmälan&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;anmalan&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Krävs för bland annat bärande ändringar, eldstad, ventilation och VA (PBF 6 kap. 1 §).&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Rivningslov&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;rivningslov&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Lov för rivning, främst inom detaljplan.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Marklov&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;marklov&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Lov för att ändra markens höjdläge, främst inom detaljplan.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Lovfri åtgärd&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;lovfri&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Kräver varken lov eller anmälan, men de tekniska kraven gäller ändå.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Grannemedgivande&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;pbl-narhet-grans&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Skriftligt medgivande som gör en åtgärd närmare gräns än 4,5 m lovfri (PBL 9 kap. 35 §).&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Detaljplan&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;DP&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Kommunens plan för ett område; avgör vilka gränser för lovfrihet som gäller.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Skyddsbestämmelse (q)&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;q&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;pbl-varde&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Bestämmelse i detaljplan som skyddar en byggnad; gör även lovfria åtgärder lovpliktiga.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Ekonomibyggnad&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Byggnad för jord- eller skogsbruk; lovfri utanför detaljplan (PBL 9 kap. 6 §).&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Byggherre&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;byggherre&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Den som för egen räkning utför eller låter utföra åtgärden och ansvarar för kraven.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Kontrollansvarig&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;KA&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;kontrollansvarig&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Certifierad person som hjälper byggherren med kontrollplanen; krävs inte för många småhusåtgärder.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Byggbedömare&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;byggbedomare&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Ny roll (SFS 2026:712): certifierat företag för lovprövning och kontroll av viss nybyggnad.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Tekniskt samråd&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;tekniskt_samrad&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Möte med byggnadsnämnden om kontrollplan och genomförande.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Startbesked&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;startbesked&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Beslut som krävs innan en lov- eller anmälningspliktig åtgärd får påbörjas.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Slutbesked&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;slutbesked&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Beslut som krävs innan byggnaden får tas i bruk.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Avfallshanteringsplan&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;avfallshanteringsplan&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Plan för återbruk, avfall och farliga ämnen (PBL 10 kap. 8 a §).&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Ändrings- och tilläggsarbete&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;ÄTA&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Arbete utöver avtalet. Revisionsvarv med SVAR-rader kan dokumentera beslutet.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1"><mxGeometry x="812" y="110" width="756" height="551" as="geometry"/></mxCell><mxCell id="matt_5" value='&lt;b&gt;Mått och nivåer (19)&lt;/b&gt;&lt;table style="border-collapse:collapse;font-size:10px" cellpadding="1" cellspacing="0" border="0"&gt;&lt;tr style="font-weight:bold"&gt;&lt;td valign="top" align="left" width="150"&gt;begrepp&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;förk.&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;hänvisning&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;betydelse&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Måttkedja&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;mattkedja&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Rad av delmått som tillsammans ger totalmåttet.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Centrumavstånd&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;c&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Avstånd mellan mittlinjerna, till exempel c600 för reglar.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Överkant&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;ÖK&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Nivån för överkanten av en del (ÖK bjälklag).&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Underkant&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;UK&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Nivån för underkanten (UK plint).&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Färdigt golv&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;FG&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;niva&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Golvets nivå efter ytskikt. Entréplanets FG är ofta ±0.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Nollnivå&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;±0&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;niva&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Referensnivån som andra nivåer räknas från.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Nivå&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;+&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;niva&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Höjd i meter, relativt ±0 eller i höjdsystemet (RH 2000).&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;RH 2000&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;RH 2000&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Sveriges nationella höjdsystem. Används på situationsplaner.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Färdig mark&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;FM&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Markens nivå efter planering.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Bruttoarea&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;BTA&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Area till ytterväggarnas utsida.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Boarea&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;BOA&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Area för boende, mätt till väggarnas insida.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Byggnadsarea&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;BYA&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Den yta byggnaden upptar på marken. Styr byggnadsklass och lovbefriade åtgärder.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Nockhöjd&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Höjden till takets högsta punkt.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Taklutning&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Takets lutning i grader eller som 1:x.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Fall&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Lutning för vattenavrinning, till exempel mot golvbrunn eller bort från huset.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Modulmått&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;M&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Mått i moduler om 100 mm, till exempel dörr 9×21 = 900×2100 karmyttermått.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Fri höjd&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;bfs9-fri-hojd&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Minsta höjd utan hinder; minst 2,00 m i passager, trappor och dörrar.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Fri bredd / fri passage&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;bfs13-dimensionerande-matt&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Den bredd man faktiskt kan passera, mindre än karmmåttet.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Öppenarea&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;OPA&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;pbl-tillbyggnad-30&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Area av öppna, överbyggda delar; räknas in i 30 m²-gränsen för lovfri tillbyggnad.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1"><mxGeometry x="40" y="440" width="756" height="346" as="geometry"/></mxCell><mxCell id="vagg_6" value='&lt;b&gt;Väggar (12)&lt;/b&gt;&lt;table style="border-collapse:collapse;font-size:10px" cellpadding="1" cellspacing="0" border="0"&gt;&lt;tr style="font-weight:bold"&gt;&lt;td valign="top" align="left" width="150"&gt;begrepp&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;förk.&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;hänvisning&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;betydelse&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Yttervägg&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;YV&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;yv_tra&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Vägg mot det fria; kod som YV1 hänvisar till typlistan.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Innervägg&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;IV&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;iv1&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Vägg inne i byggnaden.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Bärande vägg&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Vägg som tar last från bjälklag eller tak. Ritas grövre.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Regel&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;konstruktionsvirke&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Stående virke i väggstomme, oftast c600.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Syll&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;konstruktionsvirke&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Liggande virke under reglarna, mot grunden.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Hammarband&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;konstruktionsvirke&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Liggande virke ovanpå reglarna.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Kortling&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Kort virkesbit mellan reglar för stabilitet eller infästning.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Avväxling&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Förstärkning över en öppning i en bärande vägg eller ett bjälklag.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Installationsskikt&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;yv_tra&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Skikt innanför ångspärren för el och rör.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Luftspalt&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Spalt bakom fasaden eller under taket som låter fukt torka ut.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Köldbrygga&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Ställe där värme leds ut lättare, till exempel vid kantbalk.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Brandcellsgräns&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;bfs7-brandcellsgrans-klass&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Konstruktion som begränsar en brandcell; markeras med klass, till exempel EI 30.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1"><mxGeometry x="812" y="677" width="756" height="233" as="geometry"/></mxCell><mxCell id="regel_7" value='&lt;b&gt;Regler och klasser (13)&lt;/b&gt;&lt;table style="border-collapse:collapse;font-size:10px" cellpadding="1" cellspacing="0" border="0"&gt;&lt;tr style="font-weight:bold"&gt;&lt;td valign="top" align="left" width="150"&gt;begrepp&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;förk.&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;hänvisning&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;betydelse&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Brandteknisk klass EI&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;EI&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;bfs7-brandcellsgrans-klass&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Avskiljande förmåga: E = integritet, I = isolering, siffran = minuter.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Euroklass (ytskikt)&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Materialets bidrag till brand: A1 obrännbart … F; s = rök, d = brinnande droppar.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Tändskyddande beklädnad&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;K2 10&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Beklädnad i lägst K2 10 och B-s1,d0 enligt BFS 2024:7.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Byggnadsklass&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;BK&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;bfs7-byggnadsklass&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Brandskyddsbehov 0–3 enligt BFS 2024:7; ersätter tidigare Br0–Br3. Småhus i 1–2 plan = BK3.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Verksamhetsklass&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;Vk&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Klass efter hur personer i lokalen kan utrymma. Bostäder i småhus = 3A.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;U-värde&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;U&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;W/m²K för en hel byggdel. Energikraven finns i BFS 2026:9.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;BBR (Boverkets byggregler) – upphävd&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;BBR&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Ersatt av BFS 2024:4–13 från 1 juli 2025; de gamla reglerna gick inte att använda efter 1 juli 2026 (energi: särskilda övergångsregler, BFS 2026:9).&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Boverkets författningssamling&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;BFS&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Boverkets föreskrifter. Gäller som tvingande krav; allmänna råd visar ett sätt att uppfylla dem.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Plan- och bygglagen&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;PBL&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;pbl-komplementbyggnad&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Lagen som styr lov, anmälan och kontroll.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Komplementbyggnad / komplementbostadshus&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;pbl-komplementbyggnad&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Från 1 december 2025 ersätter dessa begrepp friggebod och attefallshus i lovbefriade åtgärder.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Tillbyggnad&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;bfs12-tillbyggnad-niva&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Ändring som ökar byggnadens volym.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Tillgänglighet och användbarhet&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;bfs12-hygienrum&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Krav för personer med nedsatt rörelse- eller orienteringsförmåga (BFS 2024:12).&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Vändcirkel&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;ø1500&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;bfs13-dimensionerande-matt&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Cirkel med diameter 1,50 m där en rullstol kan vända.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1"><mxGeometry x="40" y="802" width="756" height="375" as="geometry"/></mxCell><mxCell id="bjalklag_8" value='&lt;b&gt;Bjälklag (6)&lt;/b&gt;&lt;table style="border-collapse:collapse;font-size:10px" cellpadding="1" cellspacing="0" border="0"&gt;&lt;tr style="font-weight:bold"&gt;&lt;td valign="top" align="left" width="150"&gt;begrepp&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;förk.&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;hänvisning&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;betydelse&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Bjälklag&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;BJL&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;bjl_tra&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Horisontell bärande del mellan våningar eller mot vind.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Bjälke&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;konstruktionsvirke&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Liggande bärande virke i bjälklag.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Upplag&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Där en balk eller bjälke vilar på något bärande.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Spännvidd&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;L&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Avstånd mellan upplag; styr dimensionen.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Glespanel&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;lakt&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Läkt i tak eller undertak, till exempel c300–400.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Undertak&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Beklädnad under bjälklaget.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1"><mxGeometry x="812" y="926" width="756" height="134" as="geometry"/></mxCell><mxCell id="grund_9" value='&lt;b&gt;Grund (9)&lt;/b&gt;&lt;table style="border-collapse:collapse;font-size:10px" cellpadding="1" cellspacing="0" border="0"&gt;&lt;tr style="font-weight:bold"&gt;&lt;td valign="top" align="left" width="150"&gt;begrepp&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;förk.&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;hänvisning&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;betydelse&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Platta på mark&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;platta_pa_mark&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Gjuten betongplatta med isolering under, direkt på mark.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Kantbalk&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;betong_prefab&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Förtjockning eller element längs plattans kant.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Plint&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;plint_betong&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Punktvis grundläggning under stolpe eller bärlina.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Krypgrund&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Grund med luftat utrymme under bjälklaget.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Grundsula&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;betong_platsgjuten&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Bred gjuten list under vägg eller grundmur.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Kapillärbrytande skikt&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;makadam&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Lager som hindrar fukt att sugas upp, till exempel makadam 16–32.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Tjälfritt djup&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;praxis-frostfritt&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Djup där marken inte fryser; beror på ort och jordart.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Dränering&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Rör och fyllning som leder bort vatten från grunden.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Radonskydd&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Åtgärd mot markradon; behovet beror på kommunens kartläggning.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1"><mxGeometry x="812" y="1076" width="756" height="177" as="geometry"/></mxCell><mxCell id="tak_10" value='&lt;b&gt;Tak (12)&lt;/b&gt;&lt;table style="border-collapse:collapse;font-size:10px" cellpadding="1" cellspacing="0" border="0"&gt;&lt;tr style="font-weight:bold"&gt;&lt;td valign="top" align="left" width="150"&gt;begrepp&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;förk.&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;hänvisning&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;betydelse&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Sadeltak&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;tak_sadel&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Tak med två fall mot en nock.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Pulpettak&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;tak_pulpet&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Tak med ett fall.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Takstol&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;tak_sadel&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Prefabricerat fackverk som bär taket, oftast c1200.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Taksparre&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;konstruktionsvirke&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Lutande balk i takkonstruktionen.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Nock&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Takets högsta linje där två fall möts.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Takfot&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Takets nedre kant mot fasaden.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Gavel&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Kortsidan på ett sadeltak, ofta med triangulär vägg.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Underlagstak&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;raspont&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Det täta skiktet under taktäckningen.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Bärläkt&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;lakt&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Läkt som takpannorna hänger på.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Ströläkt&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;lakt&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Läkt i fallriktningen som ger luft under bärläkten.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Hängränna och stuprör&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Takavvattning. Placering och anslutning visas på fasad eller plan.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Kallvind&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;tak_sadel&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Oisolerad, ventilerad vind ovanför isolerat bjälklag.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1"><mxGeometry x="40" y="1193" width="756" height="220" as="geometry"/></mxCell><mxCell id="altan_11" value='&lt;b&gt;Altan, räcke och trappa (15)&lt;/b&gt;&lt;table style="border-collapse:collapse;font-size:10px" cellpadding="1" cellspacing="0" border="0"&gt;&lt;tr style="font-weight:bold"&gt;&lt;td valign="top" align="left" width="150"&gt;begrepp&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;förk.&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;hänvisning&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;betydelse&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Altan / trädäck&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;altan_plint&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Golv av trall utomhus, i marknivå eller upphöjt.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Trall&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;trall&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Golvbrädor utomhus, läggs med spalt.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Bärlina&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;tryckimpregnerat&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Balk som vilar på plintarna och bär reglarna.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Regel (under trall)&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;tryckimpregnerat&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Virke tvärs bärlinorna som trallen skruvas i, oftast c600.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Räcke&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;racke_altan&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Skydd mot fall vid kant med fallhöjd.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Handledare&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;racke_altan&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Överliggaren på ett räcke.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Ledstång&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;bfs9-ledstang&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Stöd för handen i trappa eller ramp.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Spjäla&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;bfs9-racke-barn&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Stående smal del i räcket; fritt avstånd högst 100 mm där barn vistas.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Trappa&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;TR&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;trappa_ute&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Trapplopp med plansteg; mått anges som steghöjd × stegdjup.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Plansteg&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;trappa_ute&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Den vågräta delen man kliver på.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Sättsteg&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;trappa_ute&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Den lodräta delen mellan två plansteg.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Vange&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;trappa_ute&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Den lutande balken som bär stegen.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Vilplan&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;bfs9-plan-dorr-trappa&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Plant parti i eller vid trappa eller ramp.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Ramp&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;bfs12-ramp-lutning&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Lutande gångyta; högst 1:12 för en tillgänglig ramp.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Fallhöjd&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;bfs9-skydd-mot-fall&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Höjden man kan falla från en kant.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1"><mxGeometry x="812" y="1269" width="756" height="276" as="geometry"/></mxCell><mxCell id="oppning_12" value='&lt;b&gt;Öppningar (7)&lt;/b&gt;&lt;table style="border-collapse:collapse;font-size:10px" cellpadding="1" cellspacing="0" border="0"&gt;&lt;tr style="font-weight:bold"&gt;&lt;td valign="top" align="left" width="150"&gt;begrepp&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;förk.&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;hänvisning&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;betydelse&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Dörr&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;D&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;dorr&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Ritas i plan med slagbåge åt det håll den öppnar.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Fönster&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;F&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;fonster&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Ritas i plan som linjer i väggöppningen; i fasad med karm och båge.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Karmyttermått&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Fönstrets eller dörrens yttermått på karmen.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Slagriktning&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Åt vilket håll dörren eller fönstret öppnas.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Bröstningshöjd&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;BH&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;bfs9-fonster-barn&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Höjd från golv till fönstrets underkant.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Tröskel&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Nivåskillnad i dörröppning.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Foder och bleck&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Avslutning runt öppningar; blecket leder bort vatten.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1"><mxGeometry x="40" y="1429" width="756" height="148" as="geometry"/></mxCell><mxCell id="installation_13" value='&lt;b&gt;Installationer (10)&lt;/b&gt;&lt;table style="border-collapse:collapse;font-size:10px" cellpadding="1" cellspacing="0" border="0"&gt;&lt;tr style="font-weight:bold"&gt;&lt;td valign="top" align="left" width="150"&gt;begrepp&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;förk.&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;hänvisning&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;betydelse&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Golvbrunn&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;GB&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;iv_vatrum&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Brunn i våtrumsgolv; fall mot brunnen anges.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Våtrum&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;iv_vatrum&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Rum där golv och väggar utsätts för vatten. Utförs enligt branschregler.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Toalett&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;WC&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Symbol i plan.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Frånluftsdon&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;FD&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;bfs8-ventilation&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Ventilationsdon för frånluft, ofta i kök, bad och WC.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Tilluftsdon&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;TD&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;bfs8-ventilation&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Don för uteluft, i sovrum och vardagsrum.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Eluttag&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Elsymbol i plan (rmink: symbol outlet).&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Elcentral&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;C&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Elsymbol i plan.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Auktoriserad elinstallatör&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;elinstallator&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Person auktoriserad av Elsäkerhetsverket (ElSL 20 §).&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Elinstallationsföretag&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;elinstallationsforetag&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Utför elinstallationsarbete yrkesmässigt; har elinstallatör, egenkontrollprogram och är anmält (ElSL 23–25 §§).&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign="top" align="left" width="150"&gt;Elinstallationsarbete&lt;/td&gt;&lt;td valign="top" align="left" width="60"&gt;&lt;/td&gt;&lt;td valign="top" align="left" width="110"&gt;elsl-behorighet&lt;/td&gt;&lt;td valign="top" align="left" width="420"&gt;Att utföra, ändra, reparera eller fast ansluta till en starkströmsanläggning (ElSL 4 §).&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;' style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1"><mxGeometry x="812" y="1561" width="756" height="217" as="geometry"/></mxCell><mxCell id="material_14" value="&lt;b&gt;Material (14)&lt;/b&gt;&lt;table style=&quot;border-collapse:collapse;font-size:10px&quot; cellpadding=&quot;1&quot; cellspacing=&quot;0&quot; border=&quot;0&quot;&gt;&lt;tr style=&quot;font-weight:bold&quot;&gt;&lt;td valign=&quot;top&quot; align=&quot;left&quot; width=&quot;150&quot;&gt;begrepp&lt;/td&gt;&lt;td valign=&quot;top&quot; align=&quot;left&quot; width=&quot;60&quot;&gt;förk.&lt;/td&gt;&lt;td valign=&quot;top&quot; align=&quot;left&quot; width=&quot;110&quot;&gt;hänvisning&lt;/td&gt;&lt;td valign=&quot;top&quot; align=&quot;left&quot; width=&quot;420&quot;&gt;betydelse&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign=&quot;top&quot; align=&quot;left&quot; width=&quot;150&quot;&gt;Konstruktionsvirke&lt;/td&gt;&lt;td valign=&quot;top&quot; align=&quot;left&quot; width=&quot;60&quot;&gt;K-virke&lt;/td&gt;&lt;td valign=&quot;top&quot; align=&quot;left&quot; width=&quot;110&quot;&gt;konstruktionsvirke&lt;/td&gt;&lt;td valign=&quot;top&quot; align=&quot;left&quot; width=&quot;420&quot;&gt;Hållfasthetssorterat virke, klass C14–C30.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign=&quot;top&quot; align=&quot;left&quot; width=&quot;150&quot;&gt;Tryckimpregnerat (NTR-klass)&lt;/td&gt;&lt;td valign=&quot;top&quot; align=&quot;left&quot; width=&quot;60&quot;&gt;NTR&lt;/td&gt;&lt;td valign=&quot;top&quot; align=&quot;left&quot; width=&quot;110&quot;&gt;tryckimpregnerat&lt;/td&gt;&lt;td valign=&quot;top&quot; align=&quot;left&quot; width=&quot;420&quot;&gt;Träskyddsklass: AB ovan mark, A i markkontakt, M i havsvatten.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign=&quot;top&quot; align=&quot;left&quot; width=&quot;150&quot;&gt;Limträ&lt;/td&gt;&lt;td valign=&quot;top&quot; align=&quot;left&quot; width=&quot;60&quot;&gt;GL&lt;/td&gt;&lt;td valign=&quot;top&quot; align=&quot;left&quot; width=&quot;110&quot;&gt;limtra&lt;/td&gt;&lt;td valign=&quot;top&quot; align=&quot;left&quot; width=&quot;420&quot;&gt;Limmade lameller; klass GL28h–GL32c.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign=&quot;top&quot; align=&quot;left&quot; width=&quot;150&quot;&gt;Gipsskiva&lt;/td&gt;&lt;td valign=&quot;top&quot; align=&quot;left&quot; width=&quot;60&quot;&gt;GN/GF&lt;/td&gt;&lt;td valign=&quot;top&quot; align=&quot;left&quot; width=&quot;110&quot;&gt;gips_a&lt;/td&gt;&lt;td valign=&quot;top&quot; align=&quot;left&quot; width=&quot;420&quot;&gt;Typ A normal, F brand, H fukt, E utvändig. 'Gips 13' = 12,5 mm.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign=&quot;top&quot; align=&quot;left&quot; width=&quot;150&quot;&gt;OSB-skiva&lt;/td&gt;&lt;td valign=&quot;top&quot; align=&quot;left&quot; width=&quot;60&quot;&gt;OSB&lt;/td&gt;&lt;td valign=&quot;top&quot; align=&quot;left&quot; width=&quot;110&quot;&gt;osb&lt;/td&gt;&lt;td valign=&quot;top&quot; align=&quot;left&quot; width=&quot;420&quot;&gt;Skiva av riktade spån, klass OSB/2–OSB/4.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign=&quot;top&quot; align=&quot;left&quot; width=&quot;150&quot;&gt;Betong&lt;/td&gt;&lt;td valign=&quot;top&quot; align=&quot;left&quot; width=&quot;60&quot;&gt;&lt;/td&gt;&lt;td valign=&quot;top&quot; align=&quot;left&quot; width=&quot;110&quot;&gt;betong_platsgjuten&lt;/td&gt;&lt;td valign=&quot;top&quot; align=&quot;left&quot; width=&quot;420&quot;&gt;Anges med hållfasthetsklass (C25/30) och exponeringsklass (XC2, XF3).&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign=&quot;top&quot; align=&quot;left&quot; width=&quot;150&quot;&gt;Exponeringsklass&lt;/td&gt;&lt;td valign=&quot;top&quot; align=&quot;left&quot; width=&quot;60&quot;&gt;X&lt;/td&gt;&lt;td valign=&quot;top&quot; align=&quot;left&quot; width=&quot;110&quot;&gt;praxis-betong-exponering&lt;/td&gt;&lt;td valign=&quot;top&quot; align=&quot;left&quot; width=&quot;420&quot;&gt;Miljön betongen ska klara: XC = karbonatisering, XF = frost, XD = klorider.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign=&quot;top&quot; align=&quot;left&quot; width=&quot;150&quot;&gt;Armering&lt;/td&gt;&lt;td valign=&quot;top&quot; align=&quot;left&quot; width=&quot;60&quot;&gt;&lt;/td&gt;&lt;td valign=&quot;top&quot; align=&quot;left&quot; width=&quot;110&quot;&gt;armering&lt;/td&gt;&lt;td valign=&quot;top&quot; align=&quot;left&quot; width=&quot;420&quot;&gt;Stål i betong; anges med sort, diameter (ø) och delning (s).&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign=&quot;top&quot; align=&quot;left&quot; width=&quot;150&quot;&gt;Isolering&lt;/td&gt;&lt;td valign=&quot;top&quot; align=&quot;left&quot; width=&quot;60&quot;&gt;ISOL&lt;/td&gt;&lt;td valign=&quot;top&quot; align=&quot;left&quot; width=&quot;110&quot;&gt;mineralull&lt;/td&gt;&lt;td valign=&quot;top&quot; align=&quot;left&quot; width=&quot;420&quot;&gt;Värmeisolering; anges med typ, tjocklek och för energiberäkning λ-värde.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign=&quot;top&quot; align=&quot;left&quot; width=&quot;150&quot;&gt;Värmeledningsförmåga&lt;/td&gt;&lt;td valign=&quot;top&quot; align=&quot;left&quot; width=&quot;60&quot;&gt;λ&lt;/td&gt;&lt;td valign=&quot;top&quot; align=&quot;left&quot; width=&quot;110&quot;&gt;&lt;/td&gt;&lt;td valign=&quot;top&quot; align=&quot;left&quot; width=&quot;420&quot;&gt;W/mK; lägre värde = bättre isolering.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign=&quot;top&quot; align=&quot;left&quot; width=&quot;150&quot;&gt;Ångspärr&lt;/td&gt;&lt;td valign=&quot;top&quot; align=&quot;left&quot; width=&quot;60&quot;&gt;&lt;/td&gt;&lt;td valign=&quot;top&quot; align=&quot;left&quot; width=&quot;110&quot;&gt;angsparr&lt;/td&gt;&lt;td valign=&quot;top&quot; align=&quot;left&quot; width=&quot;420&quot;&gt;Tätt skikt på varma sidan mot fuktvandring.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign=&quot;top&quot; align=&quot;left&quot; width=&quot;150&quot;&gt;Vindskydd&lt;/td&gt;&lt;td valign=&quot;top&quot; align=&quot;left&quot; width=&quot;60&quot;&gt;&lt;/td&gt;&lt;td valign=&quot;top&quot; align=&quot;left&quot; width=&quot;110&quot;&gt;gips_utv&lt;/td&gt;&lt;td valign=&quot;top&quot; align=&quot;left&quot; width=&quot;420&quot;&gt;Skikt utanför isoleringen som hindrar luft att blåsa igenom.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign=&quot;top&quot; align=&quot;left&quot; width=&quot;150&quot;&gt;Rostfritt A2/A4&lt;/td&gt;&lt;td valign=&quot;top&quot; align=&quot;left&quot; width=&quot;60&quot;&gt;A2/A4&lt;/td&gt;&lt;td valign=&quot;top&quot; align=&quot;left&quot; width=&quot;110&quot;&gt;infastning&lt;/td&gt;&lt;td valign=&quot;top&quot; align=&quot;left&quot; width=&quot;420&quot;&gt;Infästning ute; A4 nära hav eller pool.&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td valign=&quot;top&quot; align=&quot;left&quot; width=&quot;150&quot;&gt;Varmförzinkat&lt;/td&gt;&lt;td valign=&quot;top&quot; align=&quot;left&quot; width=&quot;60&quot;&gt;VFZ&lt;/td&gt;&lt;td valign=&quot;top&quot; align=&quot;left&quot; width=&quot;110&quot;&gt;infastning&lt;/td&gt;&lt;td valign=&quot;top&quot; align=&quot;left&quot; width=&quot;420&quot;&gt;Korrosionsskydd för stål och infästning utomhus.&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontFamily=Helvetica;fontSize=11;align=left;verticalAlign=top;spacing=6;" parent="1" vertex="1"><mxGeometry x="40" y="1593" width="756" height="261" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
